<?xml version="1.0" encoding="utf-8"?>
<!--
  NestDesk'in Microsoft Store (MSIX) paket bildirimi ŞABLONU. tools/package-msix.ps1 doldurur:
    {{Name}}, {{Publisher}}, {{PublisherDisplayName}}   tools/store/identity.json (Partner Center > Ürün kimliği)
    {{Version}}                                         Duzenleme.csproj <Version> + ".0" (Store son parçanın 0 olmasını ister)
    {{Arch}}                                            x64 / arm64 / x86
  Görünen ad (DisplayName) Partner Center'da ayrılan ürün adıyla birebir aynı olmalı: NestDesk (Core/AppInfo.cs Name); iki
  dilde de aynı olduğu için düz yazılır. Açıklamalar ve "Add a widget" girişinin adı ms-resource: ile tools/store/Strings/
  <dil>/Resources.resw'den gelir (en-US varsayılan, tr-TR); package-msix.ps1 ve IdentityTests her anahtarın iki dilde de
  bulunduğunu denetler (makeappx eksik anahtarı fark etmez).
  Kimlikler 2.1.0'da yeni ada geçti (paket henüz yayımlanmadı): Executable NestDesk.exe, Application Id NestDesk / AddWidget,
  TaskId NestDeskStartup (Core/AppInfo.cs; tests/Duzenleme.Tests/IdentityTests.cs sabitler). Yayımlandıktan sonra Id'ler ve
  TaskId DEĞİŞMEZ: değişirse sabitlemeler ve başlangıç görevi kullanıcıda sıfırlanır.
-->
<Package
  xmlns="http://schemas.microsoft.com/appx/manifest/foundation/windows10"
  xmlns:uap="http://schemas.microsoft.com/appx/manifest/uap/windows10"
  xmlns:uap10="http://schemas.microsoft.com/appx/manifest/uap/windows10/10"
  xmlns:desktop="http://schemas.microsoft.com/appx/manifest/desktop/windows10"
  xmlns:rescap="http://schemas.microsoft.com/appx/manifest/foundation/windows10/restrictedcapabilities"
  IgnorableNamespaces="uap uap10 desktop rescap">

  <Identity Name="{{Name}}" Publisher="{{Publisher}}" Version="{{Version}}" ProcessorArchitecture="{{Arch}}" />

  <Properties>
    <DisplayName>NestDesk</DisplayName>
    <PublisherDisplayName>{{PublisherDisplayName}}</PublisherDisplayName>
    <Description>ms-resource:AppDescription</Description>
    <Logo>Assets\StoreLogo.png</Logo>
  </Properties>

  <!-- 19041 (Windows 10 2004): uap10:Parameters bu sürümle geldi; daha eski Windows'ta "Widget ekle" ve
       tepsiye küçülmüş başlangıç parametresiz açılırdı. -->
  <Dependencies>
    <TargetDeviceFamily Name="Windows.Desktop" MinVersion="10.0.19041.0" MaxVersionTested="10.0.26200.0" />
  </Dependencies>

  <!-- İlk dil varsayılandır (resources.pri de en-US varsayılanıyla üretilir): listede olmayan dillerde (ör. Almanca Windows)
       İngilizce gösterilir; uygulamanın kendi dili de Türkçe dışındaki Windows'larda İngilizcedir. -->
  <Resources>
    <Resource Language="en-US" />
    <Resource Language="tr-TR" />
  </Resources>

  <Applications>
    <!-- Application Id, Executable ve TaskId: AppInfo.PackageAppId / ExeName / StartupTaskId. -->
    <Application Id="NestDesk" Executable="NestDesk.exe" EntryPoint="Windows.FullTrustApplication">
      <!-- Görseller ölçek/targetsize nitelikli dosyalardır (Square44x44Logo.scale-200.png …); resources.pri çözümler. -->
      <uap:VisualElements
        DisplayName="NestDesk"
        Description="ms-resource:AppDescription"
        BackgroundColor="transparent"
        Square150x150Logo="Assets\Square150x150Logo.png"
        Square44x44Logo="Assets\Square44x44Logo.png">
        <uap:DefaultTile Wide310x150Logo="Assets\Wide310x150Logo.png" />
      </uap:VisualElements>
      <Extensions>
        <!-- Windows ile başlat. Paketli uygulamada HKCU\...\Run yerine bu kullanılır; uygulama
             StartupTask.GetAsync("NestDeskStartup") ile açar/kapatır. Enabled="false": Store kuralı gereği
             kullanıcı açmadan otomatik başlamaz.

             Tepsiye küçülmüş açılış parametresi doğrudan bu uzantıya verilir: desktop:Extension'ın belgelenmiş
             uap10:Parameters özniteliği ("command line parameters to pass to the extension; only supported for desktop
             apps that have package identity") yalnızca başlangıç görevi etkinleştirmesine eklenir, Başlat menüsünden
             açılışı etkilemez. Mağazadaki Firefox MSIX'i de başlangıç görevi uzantısına uap10:Parameters="-os-autostart" verir.
             Değerlendirilip seçilmeyen yol, görevi AppListEntry="none" ve Parameters'lı üçüncü, gizli bir Application'a
             koymaktı: şemaya uygun ama başlangıç etkinleştirmesinde Application düzeyindeki Parameters'ın uygulanacağı
             belgelenmemiş; ayrıca pakete fazladan bir AUMID ekler (süreç o kimlikle çalışır: görev çubuğu gruplaması ve
             Ayarlar > Başlangıç'taki ad/simge ona göre olur).
             (XML yorumunda iki tire yazılamadığı için parametre adları burada geçmiyor.)
             DisplayName Ayarlar > Başlangıç'ta görünen addır (ürün adı, iki dilde aynı). -->
        <desktop:Extension Category="windows.startupTask" Executable="NestDesk.exe" EntryPoint="Windows.FullTrustApplication" uap10:Parameters="--minimized">
          <desktop:StartupTask TaskId="NestDeskStartup" Enabled="false" DisplayName="NestDesk" />
        </desktop:Extension>
      </Extensions>
    </Application>

    <!-- Başlat menüsünde tek tıkla widget ekleme (Inno kurulumundaki "NestDesk - Add a widget" kısayolunun karşılığı).
         Uygulama çalışıyorsa istek çalışan örneğe iletilir ve bu süreç hemen kapanır. Uygulama kapalıyken buradan açılırsa
         süreç ayrı bir AUMID (PFN!AddWidget) taşır; tepsi, bildirimler ve görev çubuğu oturum boyunca o kimlikle çalışmasın
         diye uygulama ana kimliği (PFN!NestDesk) aynı parametreyle IApplicationActivationManager üzerinden başlatıp kapanır
         (App.OnStartup, Core/PackagedApp.MainAppUserModelIdFor). -->
    <Application Id="AddWidget" Executable="NestDesk.exe" EntryPoint="Windows.FullTrustApplication" uap10:Parameters="--add">
      <uap:VisualElements
        DisplayName="ms-resource:AddWidgetName"
        Description="ms-resource:AddWidgetDescription"
        BackgroundColor="transparent"
        Square150x150Logo="Assets\Square150x150Logo.png"
        Square44x44Logo="Assets\Square44x44Logo.png">
        <uap:DefaultTile Wide310x150Logo="Assets\Wide310x150Logo.png" />
      </uap:VisualElements>
    </Application>
  </Applications>

  <!-- unvirtualizedResources bilerek YOK. Paketli uygulamanın HKCU yazmaları pakete özel gizli bir kovana gider
       (Microsoft Learn: "All writes under HKCU are copied on write to a private per-user, per-app location"); uygulama
       yazdığını okur ama Gezgin görmez. Bu, Ayarlar > Masaüstü'ndeki "Sistem simgeleri" anahtarlarını
       (Explorer\HideDesktopIcons\NewStartPanel) etkiler. Bildirimle aşmanın tek yolu desktop6/virtualization
       RegistryWriteVirtualization + unvirtualizedResources; Microsoft bu kısıtlı yeteneği "belirli PC oyunları ve dış konumlu
       paketler için, başka senaryolar için değil" diye tanımlıyor (onaylanmazsa gönderim sertifikasyondan kalır) ve eski
       söz dizimi Windows 10'da bütün HKCU sanallaştırmasını kapatır. Bu yüzden uygulama paketliyken bu anahtarlara yazmamalı,
       kullanıcıyı Windows'un "Masaüstü simgesi ayarları"na yönlendirmeli. -->
  <Capabilities>
    <rescap:Capability Name="runFullTrust" />
  </Capabilities>
</Package>
