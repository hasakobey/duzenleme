<Page x:Class="Duzenleme.Views.HomePage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
      xmlns:l="clr-namespace:Duzenleme.Localization"
      Title="Ana sayfa">
    <Page.Resources>
        <!-- Eylem kutucuğunun iki satırı; renk düğmeden gelir (Primary kutucukta da okunur kalsın). -->
        <Style x:Key="TileTitle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="15" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="TextTrimming" Value="CharacterEllipsis" />
        </Style>
        <!-- Dar pencerede (varsayılan 980 DIP) açıklama yarım kalmasın: en çok iki satır, ancak o da sığmazsa "…". -->
        <Style x:Key="TileText" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12.5" />
            <Setter Property="Opacity" Value="0.8" />
            <Setter Property="Margin" Value="0,2,0,0" />
            <Setter Property="TextWrapping" Value="Wrap" />
            <Setter Property="MaxHeight" Value="34" />
            <Setter Property="TextTrimming" Value="CharacterEllipsis" />
        </Style>
    </Page.Resources>

    <StackPanel Style="{StaticResource PageRoot}">
        <TextBlock x:Name="Hello" Style="{StaticResource PageTitle}" />
        <TextBlock x:Name="Tagline" Style="{StaticResource PageSubtitle}" />

        <!-- Üç ana eylem -->
        <UniformGrid Columns="3" Margin="-5,0">
            <ui:Button x:Name="AddWidgetTile" Style="{StaticResource ActionTile}" Margin="5,0" Appearance="Primary"
                       AutomationProperties.AutomationId="Home.AddWidget" AutomationProperties.Name="Widget ekle"
                       Click="AddWidget_Click">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <ui:SymbolIcon Symbol="Add24" FontSize="24" Margin="0,0,14,0" VerticalAlignment="Center" />
                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                        <TextBlock Style="{StaticResource TileTitle}" Text="Widget ekle" />
                        <TextBlock Style="{StaticResource TileText}" Text="Saat, not, bölme…" />
                    </StackPanel>
                </Grid>
            </ui:Button>
            <ui:Button x:Name="OrganizeTile" Style="{StaticResource ActionTile}" Margin="5,0"
                       AutomationProperties.AutomationId="Home.OrganizeNow" AutomationProperties.Name="Şimdi düzenle"
                       Click="OrganizeNow_Click">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <ui:SymbolIcon Symbol="Sparkle24" FontSize="24" Margin="0,0,14,0" VerticalAlignment="Center" />
                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                        <TextBlock Style="{StaticResource TileTitle}" Text="Şimdi düzenle" />
                        <TextBlock Style="{StaticResource TileText}" Text="Masaüstündeki dosyaları taşı" />
                    </StackPanel>
                </Grid>
            </ui:Button>
            <ui:Button x:Name="UndoTile" Style="{StaticResource ActionTile}" Margin="5,0"
                       AutomationProperties.AutomationId="Home.UndoLast" AutomationProperties.Name="Son taşımayı geri al"
                       Click="UndoLast_Click">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <ui:SymbolIcon Symbol="ArrowUndo24" FontSize="24" Margin="0,0,14,0" VerticalAlignment="Center" />
                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                        <TextBlock Style="{StaticResource TileTitle}" Text="Son taşımayı geri al" />
                        <TextBlock x:Name="UndoDetail" Style="{StaticResource TileText}" />
                    </StackPanel>
                </Grid>
            </ui:Button>
        </UniformGrid>

        <!-- Otomatik taşıma durumu -->
        <Border x:Name="StatusCard" CornerRadius="14" Padding="24,20" Margin="0,16,0,0">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <Border x:Name="StatusIconBack" Width="52" Height="52" CornerRadius="14" Margin="0,0,18,0" VerticalAlignment="Center">
                    <ui:SymbolIcon x:Name="StatusIcon" FontSize="26" />
                </Border>
                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                    <TextBlock x:Name="StatusTitle" FontSize="19" FontWeight="SemiBold" TextWrapping="Wrap"
                               AutomationProperties.AutomationId="Home.StatusTitle" />
                    <TextBlock x:Name="StatusText" FontSize="13" Margin="0,3,0,0" TextWrapping="Wrap"
                               AutomationProperties.AutomationId="Home.StatusText" />
                </StackPanel>
                <ui:Button x:Name="SetUpFolders" Grid.Column="2" Margin="16,0,0,0" VerticalAlignment="Center"
                           Content="Klasörleri ayarla" AutomationProperties.AutomationId="Home.SetUpFolders"
                           Click="SetUpFolders_Click" />
                <ui:ToggleSwitch x:Name="AutoMoveToggle" Grid.Column="3" Margin="16,0,0,0" VerticalAlignment="Center"
                                 AutomationProperties.AutomationId="Home.AutoMoveToggle" AutomationProperties.Name="Otomatik taşıma"
                                 Click="AutoMoveToggle_Click" />
            </Grid>
        </Border>

        <!-- Son taşınanlar -->
        <Grid Margin="0,24,0,8">
            <TextBlock Style="{StaticResource SectionHeader}" Margin="0" VerticalAlignment="Center" Text="Son taşınanlar" />
            <ui:Button x:Name="SeeAllButton" HorizontalAlignment="Right" Appearance="Transparent" Content="Tümünü gör"
                       AutomationProperties.AutomationId="Home.SeeAllHistory" Click="SeeAll_Click" />
        </Grid>
        <ItemsControl x:Name="Recent" AutomationProperties.AutomationId="Home.Recent">
            <ItemsControl.ItemTemplate>
                <DataTemplate>
                    <Border Style="{StaticResource Surface}" Padding="14,10" Margin="0,0,0,6">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <Image Source="{Binding Icon}" Width="28" Height="28" Margin="0,0,12,0" />
                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                <TextBlock Text="{Binding FileName}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"
                                           Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                                <TextBlock Text="{Binding Route}" Style="{StaticResource Muted}" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" />
                            </StackPanel>
                            <TextBlock Grid.Column="2" Text="{Binding When}" Style="{StaticResource Muted}" VerticalAlignment="Center" Margin="12,0,0,0" />
                        </Grid>
                    </Border>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>
        <TextBlock x:Name="RecentEmpty" Style="{StaticResource Muted}"
                   Text="Henüz taşınan dosya yok. Masaüstüne düşen bir dosya klasörüne gidince burada görünür." />
    </StackPanel>
</Page>
