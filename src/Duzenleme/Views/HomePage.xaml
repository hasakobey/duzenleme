<Page x:Class="Duzenleme.Views.HomePage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
      Title="Genel bakış">
    <StackPanel Margin="40,8,40,40">
        <TextBlock x:Name="Hello" Style="{StaticResource PageTitle}" />
        <TextBlock Style="{StaticResource PageSubtitle}"
                   Text="Masaüstüne düşen dosyalar, senin oluşturduğun klasörlere kendiliğinden gider." />

        <!-- Durum -->
        <Border x:Name="StatusCard" CornerRadius="14" Padding="24,20">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <Border Width="52" Height="52" CornerRadius="14" Background="#33FFFFFF" Margin="0,0,18,0">
                    <ui:SymbolIcon x:Name="StatusIcon" Symbol="Desktop24" FontSize="26" Foreground="White" />
                </Border>
                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                    <TextBlock x:Name="StatusTitle" FontSize="19" FontWeight="SemiBold" Foreground="White" />
                    <TextBlock x:Name="StatusText" FontSize="13" Foreground="#DDFFFFFF" Margin="0,3,0,0" TextTrimming="CharacterEllipsis" />
                </StackPanel>
                <ui:ToggleSwitch x:Name="WatchToggle" Grid.Column="2" VerticalAlignment="Center" Click="WatchToggle_Click" />
            </Grid>
        </Border>

        <!-- İstatistikler -->
        <UniformGrid Columns="3" Margin="-6,16,-6,0">
            <Border Style="{StaticResource Surface}" Margin="6,0">
                <StackPanel>
                    <TextBlock Style="{StaticResource Muted}" Text="Bugün düzenlenen" />
                    <TextBlock x:Name="TodayCount" FontSize="30" FontWeight="SemiBold" Margin="0,4,0,0" Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                </StackPanel>
            </Border>
            <Border Style="{StaticResource Surface}" Margin="6,0">
                <StackPanel>
                    <TextBlock Style="{StaticResource Muted}" Text="Toplam düzenlenen" />
                    <TextBlock x:Name="TotalCount" FontSize="30" FontWeight="SemiBold" Margin="0,4,0,0" Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                </StackPanel>
            </Border>
            <Border Style="{StaticResource Surface}" Margin="6,0">
                <StackPanel>
                    <TextBlock Style="{StaticResource Muted}" Text="Hazır klasörler" />
                    <TextBlock x:Name="ReadyCount" FontSize="30" FontWeight="SemiBold" Margin="0,4,0,0" Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                </StackPanel>
            </Border>
        </UniformGrid>

        <ui:InfoBar x:Name="NoFolderInfo" Margin="0,16,0,0" IsClosable="False" Severity="Informational"
                    Title="Masaüstünde henüz hedef klasör yok"
                    Message="Örneğin masaüstünde &quot;PDF&quot; adında bir klasör oluşturduğunda, PDF dosyaları oraya kendiliğinden taşınır. Klasör adlarını Kurallar'dan değiştirebilirsin." />

        <StackPanel Orientation="Horizontal" Margin="0,18,0,0">
            <ui:Button Appearance="Primary" Icon="{ui:SymbolIcon Add24}" Content="Widget ekle" Click="QuickAdd_Click"
                       ToolTip="Saat, not ya da bölme (Klasörlerim, Kısayollarım, PDF…) ekle" />
            <ui:Button Margin="10,0,0,0" Icon="{ui:SymbolIcon Sparkle24}" Content="Masaüstünü şimdi düzenle" Click="OrganizeNow_Click" />
            <ui:Button Margin="10,0,0,0" Icon="{ui:SymbolIcon ArrowUndo24}" Content="Son taşımayı geri al" Click="UndoLast_Click" />
            <ui:Button Margin="10,0,0,0" Icon="{ui:SymbolIcon Open24}" Content="Masaüstü klasörünü aç" Click="OpenDesktop_Click" />
        </StackPanel>

        <TextBlock Style="{StaticResource SectionHeader}" Text="Masaüstündeki klasörlerin" />
        <ItemsControl x:Name="Folders">
            <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate>
                    <WrapPanel />
                </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
                <DataTemplate>
                    <Border Style="{StaticResource Surface}" Padding="12,8" Margin="0,0,8,8">
                        <StackPanel Orientation="Horizontal">
                            <ui:SymbolIcon Symbol="{Binding Icon}" Filled="True" FontSize="18" Foreground="{Binding IconBrush}" Margin="0,0,8,0" />
                            <TextBlock Text="{Binding Name}" FontWeight="SemiBold" VerticalAlignment="Center" Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                            <TextBlock Text="{Binding Detail}" Margin="8,0,0,0" VerticalAlignment="Center" Style="{StaticResource Muted}" />
                        </StackPanel>
                    </Border>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>

        <TextBlock Style="{StaticResource SectionHeader}" Text="Son hareketler" />
        <ItemsControl x:Name="Recent">
            <ItemsControl.ItemTemplate>
                <DataTemplate>
                    <Border Style="{StaticResource Surface}" Padding="14,10" Margin="0,0,0,6">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <Image Source="{Binding Icon}" Width="28" Height="28" Margin="0,0,12,0" />
                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                <TextBlock Text="{Binding FileName}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                                <TextBlock Text="{Binding Route}" Style="{StaticResource Muted}" />
                            </StackPanel>
                            <TextBlock Grid.Column="2" Text="{Binding When}" Style="{StaticResource Muted}" VerticalAlignment="Center" />
                        </Grid>
                    </Border>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>
        <TextBlock x:Name="RecentEmpty" Style="{StaticResource Muted}" Text="Henüz taşınan dosya yok." />
    </StackPanel>
</Page>
