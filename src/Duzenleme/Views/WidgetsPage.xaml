<Page x:Class="Duzenleme.Views.WidgetsPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
      Title="Widget'lar">
    <Page.Resources>
        <Style x:Key="RowTitle" TargetType="TextBlock">
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="TextWrapping" Value="Wrap" />
            <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}" />
        </Style>
        <Style x:Key="RowIcon" TargetType="ui:SymbolIcon">
            <Setter Property="FontSize" Value="20" />
            <Setter Property="Margin" Value="0,0,16,0" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Foreground" Value="{DynamicResource AccentTextFillColorPrimaryBrush}" />
        </Style>
        <Style x:Key="SubHeader" TargetType="TextBlock">
            <Setter Property="FontSize" Value="13" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="{DynamicResource TextFillColorSecondaryBrush}" />
            <Setter Property="Margin" Value="0,8,0,8" />
        </Style>
        <!-- Katlanır bölümün "Göster/Gizle" düğmesi: metin değişince genişlik (ve yerleşim) oynamasın. -->
        <Style x:Key="FoldButton" TargetType="ui:Button" BasedOn="{StaticResource {x:Type ui:Button}}">
            <Setter Property="MinWidth" Value="84" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
        <!-- Toplu görünüm satırı: solda ad, sağda denetim. -->
        <Style x:Key="SettingRow" TargetType="Border" BasedOn="{StaticResource Surface}">
            <Setter Property="Padding" Value="18,10" />
            <Setter Property="Margin" Value="0,0,0,6" />
        </Style>
    </Page.Resources>

    <StackPanel Style="{StaticResource PageRoot}">
        <TextBlock Style="{StaticResource PageTitle}" Text="Widget'lar" />
        <TextBlock Style="{StaticResource PageSubtitle}"
                   Text="Masaüstüne saat, not ya da bölme ekle. Eklediklerini aşağıda bulur, tek tıkla kaldırırsın." />

        <!-- Windows masaüstü simgeleri: Ayarlar, tepsi ve widget menüleriyle aynı üç seçenek (DesktopModes). "Yalnızca bölmelerde"
             seçilince bölme yoksa başlangıç bölmeleri kurulur. -->
        <Border Style="{StaticResource Surface}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <ui:SymbolIcon Symbol="Board24" Style="{StaticResource RowIcon}" />
                <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="0,0,16,0">
                    <TextBlock Style="{StaticResource RowTitle}" Text="Windows masaüstü simgeleri" />
                    <TextBlock x:Name="IconModeText" Style="{StaticResource Muted}" Margin="0,2,0,0"
                               AutomationProperties.AutomationId="Widgets.IconModeText" />
                </StackPanel>
                <ComboBox x:Name="IconModeBox" Grid.Column="2" Width="330" VerticalAlignment="Center"
                          SelectionChanged="IconModeBox_SelectionChanged"
                          AutomationProperties.AutomationId="Widgets.IconMode" AutomationProperties.Name="Windows masaüstü simgeleri" />
            </Grid>
        </Border>

        <!-- Ekle: kutucuklar WidgetCatalog'dan ("Widget ekle" penceresi ve karşılamayla aynı liste). -->
        <TextBlock Style="{StaticResource SectionHeader}" Text="Ekle" />
        <TextBlock Style="{StaticResource SubHeader}" Margin="0,0,0,8" Text="Bölmeler" />
        <WrapPanel x:Name="FenceTiles" />
        <TextBlock Style="{StaticResource SubHeader}" Text="Araçlar" />
        <WrapPanel x:Name="ToolTiles" />
        <TextBlock Style="{StaticResource Muted}" Margin="0,2,0,0"
                   Text="İpucu: Widget'ı sürükleyerek taşı, kenarından büyüt, sağ tıklayarak ayarla." />

        <!-- Masaüstündekiler -->
        <Grid Margin="0,24,0,8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBlock x:Name="ActiveHeader" Style="{StaticResource SectionHeader}" Margin="0,0,12,0" VerticalAlignment="Center"
                       TextWrapping="Wrap" Text="Masaüstündekiler" />
            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                <ui:Button x:Name="RevealAllButton" Icon="{ui:SymbolIcon Eye24}" Content="Hepsini öne getir" Margin="0,0,8,0"
                           ToolTip="Widget'lar pencerelerin arkasında kalır; hepsini birkaç saniyeliğine öne getirir"
                           AutomationProperties.AutomationId="Widgets.RevealAll" Click="RevealAll_Click" />
                <ui:Button x:Name="ArrangeButton" Icon="{ui:SymbolIcon Grid24}" Content="Düzenli yerleştir"
                           ToolTip="Widget'ları bulundukları ekranda çakışmadan sağdan başlayarak dizer; önceki yerleşim kaydedilir"
                           AutomationProperties.AutomationId="Widgets.Arrange" Click="Arrange_Click" />
            </StackPanel>
        </Grid>
        <ItemsControl x:Name="ActiveList" AutomationProperties.AutomationId="Widgets.List">
            <ItemsControl.ItemTemplate>
                <DataTemplate>
                    <Border Style="{StaticResource Surface}" Padding="14,10" Margin="0,0,0,6">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <ui:SymbolIcon Symbol="{Binding Icon}" FontSize="22" Margin="0,0,14,0" VerticalAlignment="Center"
                                           Foreground="{DynamicResource AccentTextFillColorPrimaryBrush}" />
                            <TextBlock Grid.Column="1" Text="{Binding Name}" FontWeight="SemiBold" VerticalAlignment="Center" Margin="0,0,8,0"
                                       TextTrimming="CharacterEllipsis" Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                            <ui:Button Grid.Column="2" Icon="{ui:SymbolIcon Eye24}" Content="Bul" VerticalAlignment="Center"
                                       ToolTip="Masaüstündeki yerini göster" AutomationProperties.Name="{Binding RevealName}"
                                       Click="Reveal_Click" />
                            <ui:Button Grid.Column="3" Margin="8,0,0,0" Icon="{ui:SymbolIcon Delete24}" Content="Kaldır" VerticalAlignment="Center"
                                       Appearance="Secondary" AutomationProperties.Name="{Binding RemoveName}" Click="Remove_Click" />
                        </Grid>
                    </Border>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>
        <TextBlock x:Name="ActiveEmpty" Style="{StaticResource Muted}"
                   Text="Masaüstünde henüz widget yok. Yukarıdan birine tıkla, hemen masaüstüne gelsin." />

        <!-- Tüm widget'ların görünümü (katlanır) -->
        <Border Style="{StaticResource Surface}" Margin="0,24,0,6">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <ui:SymbolIcon Symbol="Color24" Style="{StaticResource RowIcon}" />
                <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="0,0,16,0">
                    <TextBlock Style="{StaticResource RowTitle}" Text="Tüm widget'ların görünümü" />
                    <TextBlock Style="{StaticResource Muted}" Text="Arka plan, renk ve yerleşim" />
                </StackPanel>
                <ui:Button x:Name="LookFold" Grid.Column="2" Style="{StaticResource FoldButton}"
                           AutomationProperties.AutomationId="Widgets.LookFold" AutomationProperties.HelpText="Tüm widget'ların görünümü" />
            </Grid>
        </Border>
        <StackPanel x:Name="LookContent">
            <Border Style="{StaticResource SettingRow}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Style="{StaticResource RowTitle}" VerticalAlignment="Center" Margin="0,0,16,0" Text="Arka plan" />
                    <ComboBox x:Name="StyleBox" Grid.Column="1" Width="170" SelectionChanged="StyleBox_SelectionChanged"
                              AutomationProperties.AutomationId="Widgets.Background" AutomationProperties.Name="Arka plan">
                        <ComboBoxItem Content="Cam" />
                        <ComboBoxItem Content="Koyu" />
                        <ComboBoxItem Content="Açık" />
                    </ComboBox>
                </Grid>
            </Border>
            <Border Style="{StaticResource SettingRow}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Style="{StaticResource RowTitle}" VerticalAlignment="Center" Margin="0,0,16,0" Text="Vurgu rengi" />
                    <ComboBox x:Name="AccentBox" Grid.Column="1" Width="170" SelectionChanged="AccentBox_SelectionChanged"
                              AutomationProperties.AutomationId="Widgets.Accent" AutomationProperties.Name="Vurgu rengi">
                        <ComboBoxItem Content="Mor" />
                        <ComboBoxItem Content="Mavi" />
                        <ComboBoxItem Content="Yeşil" />
                        <ComboBoxItem Content="Turuncu" />
                        <ComboBoxItem Content="Pembe" />
                    </ComboBox>
                </Grid>
            </Border>
            <Border Style="{StaticResource SettingRow}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Style="{StaticResource RowTitle}" VerticalAlignment="Center" Margin="0,0,16,0" Text="Kenarlara yapışsın (mıknatıs)" />
                    <ui:ToggleSwitch x:Name="SnapToggle" Grid.Column="1" VerticalAlignment="Center" Click="Snap_Click"
                                     AutomationProperties.AutomationId="Widgets.Snap" AutomationProperties.Name="Kenarlara yapışsın (mıknatıs)" />
                </Grid>
            </Border>
            <Border Style="{StaticResource SettingRow}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Style="{StaticResource RowTitle}" VerticalAlignment="Center" Margin="0,0,16,0" Text="Widget'lar üst üste binmesin" />
                    <ui:ToggleSwitch x:Name="OverlapToggle" Grid.Column="1" VerticalAlignment="Center" Click="Overlap_Click"
                                     AutomationProperties.AutomationId="Widgets.PreventOverlap" AutomationProperties.Name="Widget'lar üst üste binmesin" />
                </Grid>
            </Border>
            <Border Style="{StaticResource SettingRow}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel VerticalAlignment="Center" Margin="0,0,16,0">
                        <TextBlock Style="{StaticResource RowTitle}" Text="Yeni widget'ların yeri" />
                        <TextBlock Style="{StaticResource Muted}" Text="Kısayolla ya da &quot;Widget ekle&quot; penceresiyle eklenenler. Bu sayfadan eklenenler ekranın köşesine gelir." />
                    </StackPanel>
                    <ComboBox x:Name="PlacementBox" Grid.Column="1" Width="220" VerticalAlignment="Center"
                              SelectionChanged="PlacementBox_SelectionChanged"
                              AutomationProperties.AutomationId="Widgets.NewWidgetPlacement" AutomationProperties.Name="Yeni widget'ların yeri" />
                </Grid>
            </Border>
            <TextBlock Style="{StaticResource Muted}" Margin="0,2,0,0"
                       Text="Tek bir widget'ı ayarlamak için ona sağ tıkla → Görünüm. Notlar kendi kağıt rengini kullanır." />
        </StackPanel>

        <!-- Kayıtlı düzenler (katlanır) -->
        <Border Style="{StaticResource Surface}" Margin="0,12,0,6">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <ui:SymbolIcon Symbol="Board24" Style="{StaticResource RowIcon}" />
                <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="0,0,16,0">
                    <TextBlock x:Name="LayoutsTitle" Style="{StaticResource RowTitle}" Text="Kayıtlı düzenler" />
                    <TextBlock Style="{StaticResource Muted}" Text="Yerleşimi bir adla sakla, tek tıkla geri dön" />
                </StackPanel>
                <ui:Button x:Name="LayoutsFold" Grid.Column="2" Style="{StaticResource FoldButton}"
                           AutomationProperties.AutomationId="Widgets.LayoutsFold" AutomationProperties.HelpText="Kayıtlı düzenler" />
            </Grid>
        </Border>
        <StackPanel x:Name="LayoutsContent">
            <Grid Margin="0,4,0,10">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <ui:TextBox x:Name="LayoutName" PlaceholderText="Düzen adı (ör. İş)" Icon="{ui:SymbolIcon Board24}" KeyDown="LayoutName_KeyDown"
                            AutomationProperties.AutomationId="Widgets.LayoutName" AutomationProperties.Name="Düzen adı" />
                <ui:Button Grid.Column="1" Margin="10,0,0,0" Appearance="Primary" Icon="{ui:SymbolIcon Save24}" Content="Şu anki düzeni kaydet"
                           VerticalAlignment="Stretch" AutomationProperties.AutomationId="Widgets.SaveLayout" Click="SaveLayout_Click" />
            </Grid>
            <ItemsControl x:Name="LayoutList" AutomationProperties.AutomationId="Widgets.Layouts">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Style="{StaticResource Surface}" Padding="14,10" Margin="0,0,0,6">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <ui:SymbolIcon Symbol="Board24" FontSize="22" Margin="0,0,14,0" VerticalAlignment="Center"
                                               Foreground="{DynamicResource AccentTextFillColorPrimaryBrush}" />
                                <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="0,0,8,0">
                                    <TextBlock Text="{Binding Name}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"
                                               Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                                    <TextBlock Text="{Binding Detail}" Style="{StaticResource Muted}" />
                                </StackPanel>
                                <ui:Button Grid.Column="2" Content="Uygula" Icon="{ui:SymbolIcon Play24}" VerticalAlignment="Center"
                                           AutomationProperties.Name="{Binding ApplyName}" Click="ApplyLayout_Click" />
                                <ui:Button Grid.Column="3" Margin="8,0,0,0" Icon="{ui:SymbolIcon Delete24}" Appearance="Transparent" VerticalAlignment="Center"
                                           ToolTip="Düzeni sil" AutomationProperties.Name="{Binding DeleteName}" Click="DeleteLayout_Click" />
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
            <TextBlock x:Name="LayoutEmpty" Style="{StaticResource Muted}"
                       Text="Henüz kayıtlı düzen yok. Beğendiğin yerleşimi bir adla kaydet, sonra tek tıkla geri dön." />
        </StackPanel>
    </StackPanel>
</Page>
