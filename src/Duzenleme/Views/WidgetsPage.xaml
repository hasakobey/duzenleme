<Page x:Class="Duzenleme.Views.WidgetsPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
      xmlns:l="clr-namespace:Duzenleme.Localization"
      Title="{l:T 'Widget\'lar'}">
    <Page.Resources>
        <Style x:Key="RowTitle" TargetType="TextBlock">
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="TextWrapping" Value="Wrap" />
            <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}" />
        </Style>
        <Style x:Key="RowIcon" TargetType="ui:SymbolIcon">
            <Setter Property="FontSize" Value="20" />
            <Setter Property="Margin" Value="0,0,16,0" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Foreground" Value="{DynamicResource AccentTextFillColorPrimaryBrush}" />
        </Style>
        <!-- Katlanır bölümün "Göster/Gizle" düğmesi: metin değişince genişlik (ve yerleşim) oynamasın. -->
        <Style x:Key="FoldButton" TargetType="ui:Button" BasedOn="{StaticResource {x:Type ui:Button}}">
            <Setter Property="MinWidth" Value="84" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
        <!-- Toplu görünüm satırı: solda ad, sağda denetim. -->
        <Style x:Key="SettingRow" TargetType="Border" BasedOn="{StaticResource Surface}">
            <Setter Property="Padding" Value="18,10" />
            <Setter Property="Margin" Value="0,0,0,6" />
        </Style>
    </Page.Resources>

    <StackPanel Style="{StaticResource PageRoot}">
        <TextBlock Style="{StaticResource PageTitle}" Text="{l:T 'Widget\'lar'}" />
        <TextBlock Style="{StaticResource PageSubtitle}"
                   Text="{l:T 'Masaüstüne saat, not ya da bölme ekle. Eklediklerini aşağıda bulur, tek tıkla kaldırırsın.'}" />

        <!-- Ekleme: her yerdeki gibi tek "Widget ekle" penceresi (QuickAddWindow; tepsi, Ctrl+Alt+B, halka, Ana sayfa). Windows
             masaüstü simgeleri ve yeni widget'ların yeri Ayarlar'dadır. -->
        <ui:Button x:Name="AddWidgetButton" Appearance="Primary" Icon="{ui:SymbolIcon Add24}" Content="{l:T 'Widget ekle'}"
                   Padding="18,9" Margin="0,4,0,0" HorizontalAlignment="Left" AutomationProperties.AutomationId="Widgets.AddWidget"
                   Click="AddWidget_Click" />

        <!-- Masaüstündekiler -->
        <Grid Margin="0,24,0,8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBlock x:Name="ActiveHeader" Style="{StaticResource SectionHeader}" Margin="0,0,12,0" VerticalAlignment="Center"
                       TextWrapping="Wrap" Text="{l:T 'Masaüstündekiler'}" />
            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                <ui:Button x:Name="RevealAllButton" Icon="{ui:SymbolIcon Eye24}" Content="{l:T 'Hepsini öne getir'}" Margin="0,0,8,0"
                           ToolTip="{l:T 'Widget\'lar pencerelerin arkasında kalır; hepsini birkaç saniyeliğine öne getirir'}"
                           AutomationProperties.AutomationId="Widgets.RevealAll" Click="RevealAll_Click" />
                <ui:Button x:Name="ArrangeButton" Icon="{ui:SymbolIcon Grid24}" Content="{l:T 'Widget\'ları hizala'}"
                           ToolTip="{l:T 'Widget\'ları bulundukları ekranda çakışmadan sağdan başlayarak dizer; önceki yerleşim kaydedilir'}"
                           AutomationProperties.AutomationId="Widgets.Arrange" Click="Arrange_Click" />
            </StackPanel>
        </Grid>
        <ItemsControl x:Name="ActiveList" AutomationProperties.AutomationId="Widgets.List">
            <ItemsControl.ItemTemplate>
                <DataTemplate>
                    <Border Style="{StaticResource Surface}" Padding="14,10" Margin="0,0,0,6">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <ui:SymbolIcon Symbol="{Binding Icon}" FontSize="22" Margin="0,0,14,0" VerticalAlignment="Center"
                                           Foreground="{DynamicResource AccentTextFillColorPrimaryBrush}" />
                            <TextBlock Grid.Column="1" Text="{Binding Name}" FontWeight="SemiBold" VerticalAlignment="Center" Margin="0,0,8,0"
                                       TextTrimming="CharacterEllipsis" Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                            <ui:Button Grid.Column="2" Icon="{ui:SymbolIcon Eye24}" Content="{l:T 'Bul'}" VerticalAlignment="Center"
                                       ToolTip="{l:T 'Masaüstündeki yerini göster'}" AutomationProperties.Name="{Binding RevealName}"
                                       Click="Reveal_Click" />
                            <ui:Button Grid.Column="3" Margin="8,0,0,0" Icon="{ui:SymbolIcon Delete24}" Content="{l:T 'Kaldır'}" VerticalAlignment="Center"
                                       Appearance="Secondary" AutomationProperties.Name="{Binding RemoveName}" Click="Remove_Click" />
                        </Grid>
                    </Border>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>
        <TextBlock x:Name="ActiveEmpty" Style="{StaticResource Muted}"
                   Text="{l:T 'Masaüstünde henüz widget yok. Yukarıdan birine tıkla, hemen masaüstüne gelsin.'}" />

        <!-- Tüm widget'ların görünümü (katlanır) -->
        <Border Style="{StaticResource Surface}" Margin="0,24,0,6">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <ui:SymbolIcon Symbol="Color24" Style="{StaticResource RowIcon}" />
                <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="0,0,16,0">
                    <TextBlock Style="{StaticResource RowTitle}" Text="{l:T 'Tüm widget\'ların görünümü'}" />
                    <TextBlock Style="{StaticResource Muted}" Text="{l:T 'Tema, arka plan, renk ve yerleşim'}" />
                </StackPanel>
                <ui:Button x:Name="LookFold" Grid.Column="2" Style="{StaticResource FoldButton}"
                           AutomationProperties.AutomationId="Widgets.LookFold" AutomationProperties.HelpText="{l:T 'Tüm widget\'ların görünümü'}" />
            </Grid>
        </Border>
        <StackPanel x:Name="LookContent">
            <!-- 2.2 Tema: Klasik, Otomatik ve hazır temalar (seçenekler kodda, WidgetLooks/LookMenus ile aynı sırada). -->
            <Border Style="{StaticResource SettingRow}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel VerticalAlignment="Center" Margin="0,0,16,0">
                        <TextBlock Style="{StaticResource RowTitle}" Text="{l:T 'Tema'}" />
                        <TextBlock x:Name="ThemeNote" Style="{StaticResource Muted}" TextWrapping="Wrap" Visibility="Collapsed"
                                   Text="{l:T 'Yüksek karşıtlık açık: widget\'lar Windows\'un renklerini kullanır.'}" />
                    </StackPanel>
                    <ComboBox x:Name="ThemeBox" Grid.Column="1" Width="170" SelectionChanged="ThemeBox_SelectionChanged"
                              AutomationProperties.AutomationId="Widgets.Theme" AutomationProperties.Name="{l:T 'Tema'}" />
                </Grid>
            </Border>
            <Border Style="{StaticResource SettingRow}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Style="{StaticResource RowTitle}" VerticalAlignment="Center" Margin="0,0,16,0" Text="{l:T 'Arka plan'}" />
                    <ComboBox x:Name="StyleBox" Grid.Column="1" Width="170" SelectionChanged="StyleBox_SelectionChanged"
                              AutomationProperties.AutomationId="Widgets.Background" AutomationProperties.Name="{l:T 'Arka plan'}">
                        <ComboBoxItem Content="{l:T 'Cam'}" />
                        <ComboBoxItem Content="{l:T 'Koyu'}" />
                        <ComboBoxItem Content="{l:T 'Açık'}" />
                    </ComboBox>
                </Grid>
            </Border>
            <Border Style="{StaticResource SettingRow}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Style="{StaticResource RowTitle}" VerticalAlignment="Center" Margin="0,0,16,0" Text="{l:T 'Vurgu rengi'}" />
                    <ComboBox x:Name="AccentBox" Grid.Column="1" Width="170" SelectionChanged="AccentBox_SelectionChanged"
                              AutomationProperties.AutomationId="Widgets.Accent" AutomationProperties.Name="{l:T 'Vurgu rengi'}">
                        <ComboBoxItem Content="{l:T 'Mor'}" />
                        <ComboBoxItem Content="{l:T 'Mavi'}" />
                        <ComboBoxItem Content="{l:T 'Yeşil'}" />
                        <ComboBoxItem Content="{l:T 'Turuncu'}" />
                        <ComboBoxItem Content="{l:T 'Pembe'}" />
                    </ComboBox>
                </Grid>
            </Border>
            <Border Style="{StaticResource SettingRow}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Style="{StaticResource RowTitle}" VerticalAlignment="Center" Margin="0,0,16,0" Text="{l:T 'Kenarlara yapışsın (mıknatıs)'}" />
                    <ui:ToggleSwitch x:Name="SnapToggle" Grid.Column="1" VerticalAlignment="Center" Checked="Snap_Changed" Unchecked="Snap_Changed"
                                     AutomationProperties.AutomationId="Widgets.Snap" AutomationProperties.Name="{l:T 'Kenarlara yapışsın (mıknatıs)'}" />
                </Grid>
            </Border>
            <Border Style="{StaticResource SettingRow}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Style="{StaticResource RowTitle}" VerticalAlignment="Center" Margin="0,0,16,0" Text="{l:T 'Widget\'lar üst üste binmesin'}" />
                    <ui:ToggleSwitch x:Name="OverlapToggle" Grid.Column="1" VerticalAlignment="Center" Checked="Overlap_Changed" Unchecked="Overlap_Changed"
                                     AutomationProperties.AutomationId="Widgets.PreventOverlap" AutomationProperties.Name="{l:T 'Widget\'lar üst üste binmesin'}" />
                </Grid>
            </Border>
            <TextBlock Style="{StaticResource Muted}" Margin="0,2,0,0"
                       Text="{l:T 'Tek bir widget\'ı ayarlamak için kartındaki ⋯ düğmesine bas (ya da ona sağ tıkla → Düzenle). Notlar kendi kağıt rengini kullanır.'}" />
        </StackPanel>

        <!-- Kayıtlı düzenler (katlanır) -->
        <Border Style="{StaticResource Surface}" Margin="0,12,0,6">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <ui:SymbolIcon Symbol="Board24" Style="{StaticResource RowIcon}" />
                <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="0,0,16,0">
                    <TextBlock x:Name="LayoutsTitle" Style="{StaticResource RowTitle}" Text="{l:T 'Kayıtlı yerleşimler'}" />
                    <TextBlock Style="{StaticResource Muted}" Text="{l:T 'Yerleşimi bir adla sakla, tek tıkla geri dön'}" />
                </StackPanel>
                <ui:Button x:Name="LayoutsFold" Grid.Column="2" Style="{StaticResource FoldButton}"
                           AutomationProperties.AutomationId="Widgets.LayoutsFold" AutomationProperties.HelpText="{l:T 'Kayıtlı yerleşimler'}" />
            </Grid>
        </Border>
        <StackPanel x:Name="LayoutsContent">
            <Grid Margin="0,4,0,10">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <ui:TextBox x:Name="LayoutName" PlaceholderText="{l:T 'Düzen adı (ör. İş)'}" Icon="{ui:SymbolIcon Board24}" KeyDown="LayoutName_KeyDown"
                            AutomationProperties.AutomationId="Widgets.LayoutName" AutomationProperties.Name="{l:T 'Düzen adı'}" />
                <ui:Button Grid.Column="1" Margin="10,0,0,0" Appearance="Primary" Icon="{ui:SymbolIcon Save24}" Content="{l:T 'Şu anki düzeni kaydet'}"
                           VerticalAlignment="Stretch" AutomationProperties.AutomationId="Widgets.SaveLayout" Click="SaveLayout_Click" />
            </Grid>
            <ItemsControl x:Name="LayoutList" AutomationProperties.AutomationId="Widgets.Layouts">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Style="{StaticResource Surface}" Padding="14,10" Margin="0,0,0,6">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <ui:SymbolIcon Symbol="Board24" FontSize="22" Margin="0,0,14,0" VerticalAlignment="Center"
                                               Foreground="{DynamicResource AccentTextFillColorPrimaryBrush}" />
                                <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="0,0,8,0">
                                    <TextBlock Text="{Binding Name}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"
                                               Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                                    <TextBlock Text="{Binding Detail}" Style="{StaticResource Muted}" />
                                </StackPanel>
                                <ui:Button Grid.Column="2" Content="{l:T 'Uygula'}" Icon="{ui:SymbolIcon Play24}" VerticalAlignment="Center"
                                           AutomationProperties.Name="{Binding ApplyName}" Click="ApplyLayout_Click" />
                                <ui:Button Grid.Column="3" Margin="8,0,0,0" Icon="{ui:SymbolIcon Delete24}" Appearance="Transparent" VerticalAlignment="Center"
                                           ToolTip="{l:T 'Düzeni sil'}" AutomationProperties.Name="{Binding DeleteName}" Click="DeleteLayout_Click" />
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
            <TextBlock x:Name="LayoutEmpty" Style="{StaticResource Muted}"
                       Text="{l:T 'Henüz kayıtlı düzen yok. Beğendiğin yerleşimi bir adla kaydet, sonra tek tıkla geri dön.'}" />
        </StackPanel>
    </StackPanel>
</Page>
