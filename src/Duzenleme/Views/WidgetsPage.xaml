<Page x:Class="Duzenleme.Views.WidgetsPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
      Title="Widget'lar">
    <Page.Resources>
        <Style x:Key="Preview" TargetType="Border">
            <Setter Property="Height" Value="92" />
            <Setter Property="CornerRadius" Value="12" />
            <Setter Property="Margin" Value="0,0,0,14" />
        </Style>
        <Style x:Key="CardTitle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="16" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}" />
        </Style>
    </Page.Resources>

    <StackPanel Margin="40,8,40,40">
        <TextBlock Style="{StaticResource PageTitle}" Text="Widget'lar" />
        <TextBlock Style="{StaticResource PageSubtitle}"
                   Text="Masaüstüne saat, tarih, not, kısayol kutusu ve bölmeler ekle. Sürükleyerek taşı, kenarlarından büyüt/küçült; sağ tıklayarak görünümü, simgeleri ve renkleri ayarla." />
        <ui:InfoBar x:Name="AddedInfo" Margin="0,-8,0,16" IsClosable="True" Severity="Success" />

        <!-- Bölmeler: en çok kullanılan özellik; tam genişlikte ki diğer kartlar gereksiz uzamasın. -->
        <Border Style="{StaticResource Surface}" Margin="0,0,0,12" Padding="20">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="200" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Border Style="{StaticResource Preview}" Margin="0,0,20,0" VerticalAlignment="Top">
                    <Border.Background>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                            <GradientStop Color="#F59E0B" Offset="0" />
                            <GradientStop Color="#EF4444" Offset="1" />
                        </LinearGradientBrush>
                    </Border.Background>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                        <ui:SymbolIcon Symbol="DocumentPdf24" FontSize="30" Foreground="White" Margin="4,0" />
                        <ui:SymbolIcon Symbol="DocumentPdf24" FontSize="30" Foreground="#CCFFFFFF" Margin="4,0" />
                        <ui:SymbolIcon Symbol="DocumentPdf24" FontSize="30" Foreground="#99FFFFFF" Margin="4,0" />
                    </StackPanel>
                </Border>
                <StackPanel Grid.Column="1">
                    <TextBlock Style="{StaticResource CardTitle}" Text="Bölmeler" />
                    <TextBlock Style="{StaticResource Muted}" Margin="0,4,0,12" TextWrapping="Wrap"
                               Text="Masaüstünü bölümlere ayır: klasörler, kısayollar, dosyalar ya da PDF gibi bir klasörün içi ayrı panellerde. Bölmeler arasında sürükleyerek taşı, başlıktaki büyüteçle ara." />
                    <ui:Button x:Name="AutoFencesButton" Appearance="Primary" Content="Masaüstümü bölümlere ayır"
                               HorizontalAlignment="Left" Click="AutoFences_Click"
                               ToolTip="Klasörler, Kısayollar, Dosyalar ve masaüstündeki PDF, Resimler gibi klasörler için birer bölme ekler" />
                    <ui:ToggleSwitch x:Name="ManageToggle" Margin="0,14,0,0" Click="ManageToggle_Click"
                                     Content="Masaüstü simgelerini yalnızca bölmelerde göster (masaüstündeki kopyalarını gizle)" />
                    <TextBlock Style="{StaticResource Muted}" Margin="0,4,0,0" TextWrapping="Wrap"
                               Text="Açıkken Windows'un masaüstü simgeleri gizlenir, her şey bölmelerde görünür. Dosyalara dokunulmaz; kapatınca ya da uygulamadan çıkınca simgeler geri gelir." />
                    <TextBlock Style="{StaticResource Muted}" Margin="0,14,0,6" Text="Ya da tek bir bölme ekle:" />
                    <WrapPanel x:Name="FenceChoices" />
                </StackPanel>
            </Grid>
        </Border>

        <UniformGrid Columns="3" Margin="-6,0">
            <!-- Saat -->
            <Border Style="{StaticResource Surface}" Margin="6,0,6,12" Padding="20">
                <DockPanel>
                    <ui:Button DockPanel.Dock="Bottom" Appearance="Primary" Icon="{ui:SymbolIcon Add24}" Content="Saat ekle"
                               HorizontalAlignment="Stretch" Margin="0,16,0,0" Click="AddClock_Click" />
                    <StackPanel>
                        <Border Style="{StaticResource Preview}">
                            <Border.Background>
                                <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                    <GradientStop Color="#6366F1" Offset="0" />
                                    <GradientStop Color="#A855F7" Offset="1" />
                                </LinearGradientBrush>
                            </Border.Background>
                            <TextBlock x:Name="ClockPreview" Text="14:05" FontSize="40" FontWeight="Light" Foreground="White"
                                       HorizontalAlignment="Center" VerticalAlignment="Center" FontFamily="Segoe UI Variable Display, Segoe UI" />
                        </Border>
                        <TextBlock Style="{StaticResource CardTitle}" Text="Saat" />
                        <TextBlock Style="{StaticResource Muted}" Margin="0,4,0,0" Text="Büyük dijital saat, günün selamı ve isteğe bağlı saniye." />
                    </StackPanel>
                </DockPanel>
            </Border>

            <!-- Tarih -->
            <Border Style="{StaticResource Surface}" Margin="6,0,6,12" Padding="20">
                <DockPanel>
                    <ui:Button DockPanel.Dock="Bottom" Appearance="Primary" Icon="{ui:SymbolIcon Add24}" Content="Tarih ekle"
                               HorizontalAlignment="Stretch" Margin="0,16,0,0" Click="AddDate_Click" />
                    <StackPanel>
                        <Border Style="{StaticResource Preview}">
                            <Border.Background>
                                <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                    <GradientStop Color="#0EA5E9" Offset="0" />
                                    <GradientStop Color="#6366F1" Offset="1" />
                                </LinearGradientBrush>
                            </Border.Background>
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                                <TextBlock x:Name="DayPreview" Text="26" FontSize="40" FontWeight="SemiBold" Foreground="White" Margin="0,0,10,0" />
                                <StackPanel VerticalAlignment="Center">
                                    <TextBlock x:Name="MonthPreview" Text="Eylül" FontSize="16" FontWeight="SemiBold" Foreground="White" />
                                    <TextBlock x:Name="WeekdayPreview" Text="Cumartesi" FontSize="12" Foreground="#DDFFFFFF" />
                                </StackPanel>
                            </StackPanel>
                        </Border>
                        <TextBlock Style="{StaticResource CardTitle}" Text="Tarih" />
                        <TextBlock Style="{StaticResource Muted}" Margin="0,4,0,0" Text="Gün, ay, yıl ve bugünün vurgulandığı haftalık şerit." />
                    </StackPanel>
                </DockPanel>
            </Border>

            <!-- Not -->
            <Border Style="{StaticResource Surface}" Margin="6,0,6,12" Padding="20">
                <DockPanel>
                    <ui:Button DockPanel.Dock="Bottom" Appearance="Primary" Icon="{ui:SymbolIcon Add24}" Content="Not ekle"
                               HorizontalAlignment="Stretch" Margin="0,16,0,0" Click="AddNote_Click" />
                    <StackPanel>
                        <Border Style="{StaticResource Preview}">
                            <Border.Background>
                                <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                    <GradientStop Color="#FDE68A" Offset="0" />
                                    <GradientStop Color="#F9A8D4" Offset="1" />
                                </LinearGradientBrush>
                            </Border.Background>
                            <StackPanel VerticalAlignment="Center" Margin="22,0">
                                <TextBlock Text="Alışveriş" FontWeight="SemiBold" Foreground="#6B4E16" FontSize="13" />
                                <TextBlock Text="• Süt, ekmek&#x0a;• Faturayı öde" Foreground="#3F2E0C" FontSize="13" Margin="0,2,0,0" />
                            </StackPanel>
                        </Border>
                        <TextBlock Style="{StaticResource CardTitle}" Text="Not" />
                        <TextBlock Style="{StaticResource Muted}" Margin="0,4,0,0" Text="Masaüstünde yüzen yapışkan not. 6 renk, yazdıkça kaydedilir." />
                    </StackPanel>
                </DockPanel>
            </Border>

            <!-- Kısayol kutusu -->
            <Border Style="{StaticResource Surface}" Margin="6,0,6,12" Padding="20">
                <DockPanel>
                    <ui:Button DockPanel.Dock="Bottom" Appearance="Primary" Icon="{ui:SymbolIcon Add24}" Content="Kısayol kutusu ekle"
                               HorizontalAlignment="Stretch" Margin="0,16,0,0" Click="AddLauncher_Click" />
                    <StackPanel>
                        <Border Style="{StaticResource Preview}">
                            <Border.Background>
                                <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                    <GradientStop Color="#10B981" Offset="0" />
                                    <GradientStop Color="#0EA5E9" Offset="1" />
                                </LinearGradientBrush>
                            </Border.Background>
                            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,0,0,8">
                                    <Border Background="White" CornerRadius="8" Padding="8,1"><TextBlock Text="İş" FontSize="11" Foreground="#0F766E" FontWeight="SemiBold" /></Border>
                                    <Border Background="#33FFFFFF" CornerRadius="8" Padding="8,1" Margin="4,0"><TextBlock Text="Oyun" FontSize="11" Foreground="White" /></Border>
                                    <Border Background="#33FFFFFF" CornerRadius="8" Padding="8,1"><TextBlock Text="Araçlar" FontSize="11" Foreground="White" /></Border>
                                </StackPanel>
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                    <ui:SymbolIcon Symbol="Globe24" FontSize="24" Foreground="White" Margin="5,0" />
                                    <ui:SymbolIcon Symbol="Mail24" FontSize="24" Foreground="White" Margin="5,0" />
                                    <ui:SymbolIcon Symbol="Code24" FontSize="24" Foreground="White" Margin="5,0" />
                                    <ui:SymbolIcon Symbol="Chat24" FontSize="24" Foreground="White" Margin="5,0" />
                                </StackPanel>
                            </StackPanel>
                        </Border>
                        <TextBlock Style="{StaticResource CardTitle}" Text="Kısayol kutusu" />
                        <TextBlock Style="{StaticResource Muted}" Margin="0,4,0,0"
                                   Text="Sekmeli uygulama/dosya rafı. Sürükleyip bırakarak ekle, tek tıkla aç; istersen yönetici olarak çalıştır." />
                    </StackPanel>
                </DockPanel>
            </Border>

            <!-- Hızlı gizle -->
            <Border Style="{StaticResource Surface}" Margin="6,0,6,12" Padding="20">
                <DockPanel>
                    <ui:Button x:Name="HideButton" DockPanel.Dock="Bottom" Icon="{ui:SymbolIcon EyeOff24}" Content="Masaüstünü gizle"
                               HorizontalAlignment="Stretch" Margin="0,16,0,0" Click="ToggleDesktop_Click" />
                    <StackPanel>
                        <Border Style="{StaticResource Preview}">
                            <Border.Background>
                                <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                    <GradientStop Color="#334155" Offset="0" />
                                    <GradientStop Color="#0F172A" Offset="1" />
                                </LinearGradientBrush>
                            </Border.Background>
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                                <ui:SymbolIcon Symbol="CursorClick24" FontSize="30" Foreground="White" />
                                <TextBlock Text="×2" FontSize="22" Foreground="White" FontWeight="SemiBold" Margin="6,0,0,0" VerticalAlignment="Center" />
                            </StackPanel>
                        </Border>
                        <TextBlock Style="{StaticResource CardTitle}" Text="Hızlı gizle" />
                        <TextBlock x:Name="HideHint" Style="{StaticResource Muted}" Margin="0,4,0,0" />
                    </StackPanel>
                </DockPanel>
            </Border>
        </UniformGrid>


        <Grid Margin="0,24,0,8">
            <TextBlock Style="{StaticResource SectionHeader}" Margin="0" VerticalAlignment="Center" Text="Masaüstündeki widget'ların" />
            <StackPanel HorizontalAlignment="Right" Orientation="Horizontal">
                <ui:Button x:Name="ArrangeButton" Content="Düzenli yerleştir" Margin="0,0,8,0" Click="Arrange_Click"
                           ToolTip="Tüm widget'ları bulundukları ekranda çakışmadan sağdan başlayarak dizer; önceki düzen kaydedilir" />
                <ui:Button Icon="{ui:SymbolIcon Eye24}" Content="Tümünü öne getir"
                           ToolTip="Widget'lar pencerelerin arkasında kalır; 5 saniyeliğine öne getirir" Click="RevealAll_Click" />
            </StackPanel>
        </Grid>
        <ItemsControl x:Name="ActiveList">
            <ItemsControl.ItemTemplate>
                <DataTemplate>
                    <Border Style="{StaticResource Surface}" Padding="14,10" Margin="0,0,0,6">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="130" />
                                <ColumnDefinition Width="130" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <ui:SymbolIcon Symbol="{Binding Icon}" FontSize="22" Margin="0,0,14,0" Foreground="{DynamicResource AccentTextFillColorPrimaryBrush}" />
                            <TextBlock Grid.Column="1" Text="{Binding Name}" FontWeight="SemiBold" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"
                                       Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                            <ComboBox Grid.Column="2" ItemsSource="{Binding StyleNames}" SelectedIndex="{Binding StyleIndex, Mode=TwoWay}" IsEnabled="{Binding HasStyle}" />
                            <ComboBox Grid.Column="3" Margin="8,0,0,0" ItemsSource="{Binding AccentNames}" SelectedIndex="{Binding AccentIndex, Mode=TwoWay}" />
                            <ui:Button Grid.Column="4" Margin="10,0,0,0" Icon="{ui:SymbolIcon Eye24}" Content="Göster"
                                       ToolTip="Masaüstündeki yerini göster" Click="Reveal_Click" />
                            <ui:Button Grid.Column="5" Margin="6,0,0,0" Icon="{ui:SymbolIcon Delete24}" Appearance="Transparent"
                                       ToolTip="Kaldır" Click="Remove_Click" />
                        </Grid>
                    </Border>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>
        <TextBlock x:Name="ActiveEmpty" Style="{StaticResource Muted}" Text="Masaüstünde widget yok. Yukarıdan ekleyebilirsin." />

        <TextBlock Style="{StaticResource SectionHeader}" Text="Kayıtlı düzenler" />
        <TextBlock Style="{StaticResource Muted}" Margin="0,-4,0,10"
                   Text="Widget'ların konumunu, görünümünü ve içeriğini bir ad altında sakla; tek tıkla geri dön (ör. &quot;İş&quot;, &quot;Oyun&quot;, &quot;Sunum&quot;)." />
        <Grid Margin="0,0,0,10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <ui:TextBox x:Name="LayoutName" PlaceholderText="Düzen adı (ör. İş)" Icon="{ui:SymbolIcon Board24}" />
            <ui:Button Grid.Column="1" Margin="10,0,0,0" Appearance="Primary" Icon="{ui:SymbolIcon Save24}" Content="Mevcut düzeni kaydet" Click="SaveLayout_Click" />
        </Grid>
        <ItemsControl x:Name="LayoutList">
            <ItemsControl.ItemTemplate>
                <DataTemplate>
                    <Border Style="{StaticResource Surface}" Padding="14,10" Margin="0,0,0,6">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <ui:SymbolIcon Symbol="Board24" FontSize="22" Margin="0,0,14,0" Foreground="{DynamicResource AccentTextFillColorPrimaryBrush}" />
                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                <TextBlock Text="{Binding Name}" FontWeight="SemiBold" Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                                <TextBlock Text="{Binding Detail}" Style="{StaticResource Muted}" />
                            </StackPanel>
                            <ui:Button Grid.Column="2" Content="Uygula" Icon="{ui:SymbolIcon Play24}" Click="ApplyLayout_Click" />
                            <ui:Button Grid.Column="3" Margin="8,0,0,0" Icon="{ui:SymbolIcon Delete24}" Appearance="Transparent" ToolTip="Sil" Click="DeleteLayout_Click" />
                        </Grid>
                    </Border>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>
        <TextBlock x:Name="LayoutEmpty" Style="{StaticResource Muted}" Text="Henüz kayıtlı düzen yok." />
    </StackPanel>
</Page>
