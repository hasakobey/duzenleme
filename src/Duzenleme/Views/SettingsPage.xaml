                        </StackPanel>
                        <ui:Button x:Name="AiFold" Grid.Column="2" Style="{StaticResource FoldButton}"
                                   AutomationProperties.AutomationId="Settings.Ai" AutomationProperties.HelpText="{l:T 'Yapay zekâ ile klasör simgesi'}" />
                    </Grid>
                    <StackPanel x:Name="AiContent" Margin="36,12,0,0">
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                            <TextBlock Text="{l:T 'Claude API anahtarı'}" FontWeight="SemiBold" VerticalAlignment="Center"
                                       Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                            <TextBlock x:Name="KeyStatus" Style="{StaticResource Muted}" Margin="10,0,0,0" VerticalAlignment="Center" />
                        </StackPanel>
                        <TextBlock x:Name="AiText" Style="{StaticResource Muted}" Margin="0,0,0,12" />
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <ui:PasswordBox x:Name="KeyBox" PlaceholderText="sk-ant-…" Icon="{ui:SymbolIcon Key24}"
                                            AutomationProperties.Name="{l:T 'Claude API anahtarı'}" />
                            <ui:Button x:Name="SaveKeyButton" Grid.Column="1" Margin="10,0,0,0" Appearance="Primary" Content="{l:T 'Kaydet ve doğrula'}"
                                       Click="SaveKey_Click" />
                            <ui:Button Grid.Column="2" Margin="8,0,0,0" Icon="{ui:SymbolIcon Delete24}" Content="{l:T 'Sil'}" Click="DeleteKey_Click" />
                        </Grid>
                        <ui:InfoBar x:Name="KeyFeedback" Margin="0,10,0,0" IsClosable="True" />
                        <TextBlock Style="{StaticResource Muted}" Margin="0,8,0,0">
                            <Run Text="{l:T 'Anahtarın yoksa: '}" /><Hyperlink NavigateUri="https://console.anthropic.com/settings/keys" RequestNavigate="Link_RequestNavigate">console.anthropic.com</Hyperlink>
                        </TextBlock>
                        <TextBlock Style="{StaticResource Muted}" Margin="0,4,0,0">
                            <Run Text="{l:T 'Neyin gönderildiği: '}" /><Hyperlink Click="Privacy_Click" AutomationProperties.AutomationId="Settings.AiPrivacy"><Run Text="{l:T 'Gizlilik politikası'}" /></Hyperlink>
                        </TextBlock>
                    </StackPanel>
                </StackPanel>
            </Border>
            <Border Style="{StaticResource Row}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <ui:SymbolIcon Symbol="FolderProhibited24" FontSize="20" Margin="0,0,16,0" VerticalAlignment="Center"
                                   Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                        <TextBlock Style="{StaticResource RowTitle}" Text="{l:T 'Klasör simgelerinin hepsini kaldır'}" />
                        <TextBlock x:Name="RemoveIconsText" Style="{StaticResource Muted}" />
                    </StackPanel>
                    <ui:Button x:Name="RemoveIconsButton" Grid.Column="2" MinWidth="80" Margin="16,0,0,0" VerticalAlignment="Center" Content="{l:T 'Kaldır'}"
                               AutomationProperties.AutomationId="Settings.RemoveAllFolderIcons"
                               AutomationProperties.Name="{l:T 'Klasör simgelerinin hepsini kaldır'}" Click="RemoveAllFolderIcons_Click" />
                </Grid>
            </Border>
            <TextBlock x:Name="BoxHeader" Style="{StaticResource SectionHeader}" Text="{l:T 'Masaüstünden kalkanlar'}" />
            <!-- "Widget'lara koyduğum öğeler masaüstünden kalksın"ın ayrıntıları (anahtarın kendisi ilk görünümde): taşınanlar
                 (sayı, klasör, hepsini geri koy) ve iki alt anahtar (herkesin masaüstü, uygulamanın kısayolu). -->
            <Border x:Name="BoxCard" Style="{StaticResource Row}">
                <StackPanel>
                    <!-- Taşınanlar: sayı, klasör, hepsini geri koy (dosyalar taşınıyorsa ya da taşınmış öğe kaldıysa). -->
                    <StackPanel x:Name="BoxPanel" Visibility="Collapsed">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock x:Name="BoxCountText" Style="{StaticResource Muted}" VerticalAlignment="Center"
                                       AutomationProperties.AutomationId="Settings.BoxCount" />
                            <ui:Button x:Name="OpenBoxFolderButton" Grid.Column="1" Margin="12,0,0,0" VerticalAlignment="Center" Content="{l:T 'Klasörü aç'}"
                                       Icon="{ui:SymbolIcon FolderOpen24}" AutomationProperties.AutomationId="Settings.OpenBoxFolder"
                                       Click="OpenBoxFolder_Click" />
                            <ui:Button x:Name="ReturnAllButton" Grid.Column="2" Margin="8,0,0,0" VerticalAlignment="Center" Content="{l:T 'Hepsini masaüstüne geri koy'}"
                                       Icon="{ui:SymbolIcon ArrowUndo24}" AutomationProperties.AutomationId="Settings.ReturnAll"
                                       Click="ReturnAll_Click" />
                        </Grid>
                    </StackPanel>
                    <!-- Alt anahtarlar: yalnızca anahtar açıkken. Herkesin masaüstü yalnızca dosyalar taşınırken ve Store sürümü değilken. -->
                    <StackPanel x:Name="BoxOptions" Visibility="Collapsed">
                        <Grid x:Name="PublicBoxRow">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock Style="{StaticResource RowTitle}" Text="{l:T 'Herkesin masaüstündeki simgeler de kalksın'}" />
                                <TextBlock Style="{StaticResource Muted}"
                                           Text="{l:T 'Çoğu uygulamanın kısayolu bu bilgisayardaki herkesin masaüstündedir. Açarsan onlar da herkesin masaüstünden kalkar; Windows bir kez yönetici izni ister.'}" />
                            </StackPanel>
                            <ui:ToggleSwitch x:Name="PublicBoxToggle" Grid.Column="1" Margin="16,0,0,0" VerticalAlignment="Center" Checked="PublicBoxToggle_Changed" Unchecked="PublicBoxToggle_Changed"
                                             AutomationProperties.AutomationId="Settings.PublicBox" AutomationProperties.Name="{l:T 'Herkesin masaüstündeki simgeler de kalksın'}" />
                        </Grid>
                        <Grid x:Name="AppShortcutsRow" Margin="0,12,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock Style="{StaticResource RowTitle}" Text="{l:T 'Uygulama eklenince masaüstündeki kısayolu da kalksın'}" />
                                <TextBlock Style="{StaticResource Muted}"
                                           Text="{l:T 'Kutuya ya da halkaya bir uygulama eklediğinde masaüstünde aynı uygulamanın kısayolu varsa o da kalkar.'}" />
                            </StackPanel>
                            <ui:ToggleSwitch x:Name="AppShortcutsToggle" Grid.Column="1" Margin="16,0,0,0" VerticalAlignment="Center"
                                             Checked="AppShortcutsToggle_Changed" Unchecked="AppShortcutsToggle_Changed"
                                             AutomationProperties.AutomationId="Settings.BoxAppShortcuts"
                                             AutomationProperties.Name="{l:T 'Uygulama eklenince masaüstündeki kısayolu da kalksın'}" />
                        </Grid>
                    </StackPanel>
                </StackPanel>
            </Border>
            <TextBlock Style="{StaticResource SectionHeader}" Text="{l:T 'Sorun giderme'}" />
            <!-- Hata günlüğü (2.2 yerel tanılama): temizlenmiş, bu bilgisayarda kalır; kapatılabilir ve silinebilir. Durum satırı
                 bölüm açılınca arka planda okunur. -->
            <Border Style="{StaticResource Row}">
                <StackPanel>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <ui:SymbolIcon Symbol="DocumentBulletList24" FontSize="20" Margin="0,0,16,0" VerticalAlignment="Center"
                                       Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                            <TextBlock Style="{StaticResource RowTitle}" Text="{l:T 'Hata günlüğü'}" />
                            <TextBlock Style="{StaticResource Muted}" Text="{l:T 'Hatalar bu bilgisayarda kaydedilir; hiçbir şey gönderilmez.'}" />
                        </StackPanel>
                        <ui:Button x:Name="ErrorLogFold" Grid.Column="2" Style="{StaticResource FoldButton}"
                                   AutomationProperties.AutomationId="Settings.ErrorLog" AutomationProperties.HelpText="{l:T 'Hata günlüğü'}" />
                    </Grid>
                    <StackPanel x:Name="ErrorLogContent" Margin="36,12,0,0">
                        <TextBlock x:Name="LogStatusText" Style="{StaticResource Muted}" Margin="0,0,0,12"
                                   AutomationProperties.AutomationId="Settings.LogStatus" />
                        <Grid Margin="0,0,0,12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock Style="{StaticResource RowTitle}" FontWeight="Normal" Text="{l:T 'Hata günlüğü tut'}" />
                                <TextBlock Style="{StaticResource Muted}"
                                           Text="{l:T 'Hata türü ve kodu, temizlenmiş hata iletisi, yığın kareleri ve her açılışta oturum bilgileri (Windows derlemesi, ekran sayısı ve ölçeği, dil, tema) yazılır. Yollar yer tutucuyla değiştirilir; dosya ve klasör adların, notların ve yazdıkların asla yazılmaz. Günlük bu bilgisayarda kalır: en çok 4 MB, 14 gün.'}" />
                            </StackPanel>
                            <ui:ToggleSwitch x:Name="ErrorLogToggle" Grid.Column="1" Margin="16,0,0,0" VerticalAlignment="Center"
                                             Checked="ErrorLogToggle_Changed" Unchecked="ErrorLogToggle_Changed"
                                             AutomationProperties.AutomationId="Settings.ErrorLogOn" AutomationProperties.Name="{l:T 'Hata günlüğü tut'}" />
                        </Grid>
                        <Grid Margin="0,0,0,12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock Style="{StaticResource RowTitle}" FontWeight="Normal" Text="{l:T 'Çökme olunca'}" />
                                <TextBlock Style="{StaticResource Muted}"
                                           Text="{l:T 'Rapor sürümü, hata türünü ve yığın karelerini (hata günlüğü açıksa günlüğün son satırlarını da) içerir ve bu bilgisayarda kalır. &quot;Kaydetme&quot; seçiliyse rapor yazılmaz; hata yalnızca hata günlüğü açıksa oraya girer.'}" />
                            </StackPanel>
                            <ComboBox x:Name="CrashModeBox" Grid.Column="1" Width="200" Margin="16,0,0,0" VerticalAlignment="Center"
                                      SelectionChanged="CrashModeBox_SelectionChanged"
                                      AutomationProperties.AutomationId="Settings.CrashMode" AutomationProperties.Name="{l:T 'Çökme olunca'}">
                                <ComboBoxItem Content="{l:T 'Her seferinde sor'}" />
                                <ComboBoxItem Content="{l:T 'Sormadan kaydet'}" />
                                <ComboBoxItem Content="{l:T 'Kaydetme'}" />
                            </ComboBox>
                        </Grid>
                        <Grid x:Name="PendingRow" Margin="0,0,0,12" Visibility="Collapsed">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock x:Name="PendingText" Style="{StaticResource Muted}" VerticalAlignment="Center" TextWrapping="Wrap"
                                       AutomationProperties.AutomationId="Settings.PendingCrash" />
                            <ui:Button Grid.Column="1" Margin="12,0,0,0" VerticalAlignment="Center" Content="{l:T 'Kaydet'}"
                                       AutomationProperties.AutomationId="Settings.SavePendingCrash" Click="SavePending_Click" />
                            <ui:Button Grid.Column="2" Margin="8,0,0,0" VerticalAlignment="Center" Content="{l:T 'Sil'}"
                                       AutomationProperties.AutomationId="Settings.DiscardPendingCrash" Click="DiscardPending_Click" />
                        </Grid>
                        <WrapPanel>
                            <ui:Button Content="{l:T 'Günlük klasörünü aç'}" Icon="{ui:SymbolIcon FolderOpen24}" Margin="0,0,8,0"
                                       AutomationProperties.AutomationId="Settings.OpenLogs" Click="OpenLogs_Click" />
                            <ui:Button Content="{l:T 'Günlükleri sil'}" Icon="{ui:SymbolIcon Delete24}"
                                       AutomationProperties.AutomationId="Settings.DeleteLogs" Click="DeleteLogs_Click" />
                        </WrapPanel>
                    </StackPanel>
                </StackPanel>
            </Border>
            <!-- Tanılama (2.2 yerel tanılama): paket ve sayfa yalnızca bu bilgisayarda oluşur. GitHub bağlantısı Yardım'da; yalnızca
                 sürümü taşır, paketi kullanıcı kendisi ekler. -->
            <Border Style="{StaticResource Row}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <ui:SymbolIcon Symbol="Bug24" FontSize="20" Margin="0,0,16,0" VerticalAlignment="Top"
                                   Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                    <StackPanel Grid.Column="1">
                        <TextBlock Style="{StaticResource RowTitle}" Text="{l:T 'Tanılama'}" />
                        <TextBlock x:Name="ReportProblemText" Style="{StaticResource Muted}" />
                        <WrapPanel Margin="0,12,0,0">
                            <ui:Button x:Name="CreatePackageButton" Appearance="Primary" Padding="16,8" Margin="0,0,8,0"
                                       Icon="{ui:SymbolIcon FolderZip24}" Content="{l:T 'Tanılama paketi oluştur'}"
                                       AutomationProperties.AutomationId="Settings.DiagnosticPackage" Click="CreatePackage_Click" />
                            <ui:Button Padding="16,8" Icon="{ui:SymbolIcon DocumentSearch24}" Content="{l:T 'Tanılama sayfasını aç'}"
                                       AutomationProperties.AutomationId="Settings.DiagnosticPage" Click="OpenDiagnosticPage_Click" />
                        </WrapPanel>
                    </StackPanel>
                </Grid>
            </Border>
            <Border Style="{StaticResource Row}">
                <StackPanel>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <ui:SymbolIcon Symbol="FolderOpen24" FontSize="20" Margin="0,0,16,0" VerticalAlignment="Center"
                                       Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                            <TextBlock Style="{StaticResource RowTitle}" Text="{l:T 'Dosya konumları'}" />
                            <TextBlock Style="{StaticResource Muted}" Text="{l:T 'Masaüstü ve ayar klasörleri'}" />
                        </StackPanel>
                        <ui:Button x:Name="LocationsFold" Grid.Column="2" Style="{StaticResource FoldButton}"
                                   AutomationProperties.AutomationId="Settings.Locations" AutomationProperties.HelpText="{l:T 'Dosya konumları'}" />
                    </Grid>
                    <StackPanel x:Name="LocationsContent" Margin="36,12,0,0">
                        <Grid Margin="0,0,0,12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock Style="{StaticResource RowTitle}" Text="{l:T 'İzlenen masaüstü'}" />
                                <TextBlock x:Name="DesktopPath" Style="{StaticResource Muted}" />
                            </StackPanel>
                            <ui:Button Grid.Column="1" Margin="12,0,0,0" VerticalAlignment="Center" Content="{l:T 'Aç'}" Icon="{ui:SymbolIcon Open24}"
                                       AutomationProperties.AutomationId="Settings.OpenDesktop" AutomationProperties.Name="{l:T 'Masaüstü klasörünü aç'}"
                                       Click="OpenDesktop_Click" />
                        </Grid>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock Style="{StaticResource RowTitle}" Text="{l:T 'Ayar ve geçmiş dosyaları'}" />
                                <TextBlock x:Name="DataPath" Style="{StaticResource Muted}" />
                                <TextBlock x:Name="PortableText" Style="{StaticResource Muted}" Margin="0,2,0,0" />
                            </StackPanel>
                            <ui:Button Grid.Column="1" Margin="12,0,0,0" VerticalAlignment="Center" Content="{l:T 'Aç'}" Icon="{ui:SymbolIcon Open24}"
                                       AutomationProperties.AutomationId="Settings.OpenData" AutomationProperties.Name="{l:T 'Ayar klasörünü aç'}"
                                       Click="OpenData_Click" />
                        </Grid>
                    </StackPanel>
                </StackPanel>
            </Border>
        </StackPanel>
    </Grid>
</Page>
