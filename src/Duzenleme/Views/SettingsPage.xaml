<Page x:Class="Duzenleme.Views.SettingsPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
      xmlns:l="clr-namespace:Duzenleme.Localization"
      xmlns:views="clr-namespace:Duzenleme.Views"
      Title="{l:T 'Ayarlar'}">
    <Page.Resources>
        <!-- Ayar satırı: Border Surface + Grid [simge | başlık + açıklama | denetim]. -->
        <Style x:Key="Row" TargetType="Border" BasedOn="{StaticResource Surface}">
            <Setter Property="Margin" Value="0,0,0,6" />
            <Setter Property="Padding" Value="16,12" />
        </Style>
        <Style x:Key="RowTitle" TargetType="TextBlock">
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="TextWrapping" Value="Wrap" />
            <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}" />
        </Style>
        <!-- Katlanır bölümün "Göster/Gizle" düğmesi. -->
        <Style x:Key="FoldButton" TargetType="ui:Button" BasedOn="{StaticResource {x:Type ui:Button}}">
            <Setter Property="MinWidth" Value="80" />
            <Setter Property="Margin" Value="16,0,0,0" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
        <!-- Bölümlü seçim (Animasyonlar: Canlı / Sakin / Kapalı). WPF-UI'nin geçişli RadioButton şablonu yerine kendi şablonu:
             hiçbir şey kaymaz ya da solmaz, seçilen bölümün zemini anında vurgu rengi olur (yerleşim değişmez). -->
        <Style x:Key="Segment" TargetType="RadioButton">
            <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}" />
            <Setter Property="MinWidth" Value="76" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="Part" CornerRadius="4" Padding="12,5" Background="Transparent">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Part" Property="Background" Value="{DynamicResource SubtleFillColorSecondaryBrush}" />
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Part" Property="Background" Value="{DynamicResource AccentFillColorDefaultBrush}" />
                                <Setter Property="Foreground" Value="{DynamicResource TextOnAccentFillColorPrimaryBrush}" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Part" Property="Opacity" Value="0.55" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Page.Resources>

    <!-- İki görünüm, tek sayfa: önce yedi satır (dil, başlangıç, simgeler, halka, yardım, hakkında, "Gelişmiş ayarlar ›"),
         sonra Gelişmiş ayarlar (geri: "Ayarlar"). Hiçbir ayar düşmedi, yalnızca yer değiştirdi. Geçiş Views.Motion ile. İki görünüm
         de pencere kadar geniş (en çok PageRoot): satırlar aynı genişlikte kalsın. -->
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" MaxWidth="984" />
        </Grid.ColumnDefinitions>
        <StackPanel x:Name="MainView" Style="{StaticResource PageRoot}" HorizontalAlignment="Stretch">
            <TextBlock Style="{StaticResource PageTitle}" Text="{l:T 'Ayarlar'}" />
            <TextBlock x:Name="Subtitle" Style="{StaticResource PageSubtitle}" />
            <!-- Dil: başlık iki dilde, seçenekler kendi dillerinde (kod tarafında); değişiklik yeniden başlatınca uygulanır. -->
            <!-- Dil: başlık iki dilde, seçenekler kendi dillerinde (kod tarafında); değişiklik yeniden başlatınca uygulanır. -->
            <Border Style="{StaticResource Row}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <ui:SymbolIcon Symbol="LocalLanguage24" FontSize="20" Margin="0,0,16,0" VerticalAlignment="Center"
                                   Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                        <TextBlock Style="{StaticResource RowTitle}" Text="{l:T 'Dil / Language'}" />
                        <TextBlock Style="{StaticResource Muted}" Text="{l:T 'Yeniden başlatınca uygulanır.'}" />
                        <ui:Button x:Name="RestartButton" Margin="0,8,0,0" Content="{l:T 'Şimdi yeniden başlat'}"
                                   Icon="{ui:SymbolIcon ArrowClockwise24}" Visibility="Collapsed" Click="Restart_Click"
                                   AutomationProperties.AutomationId="Settings.Restart" />
                    </StackPanel>
                    <ComboBox x:Name="LanguageBox" Grid.Column="2" Width="220" Margin="16,0,0,0" VerticalAlignment="Center"
                              SelectionChanged="LanguageBox_SelectionChanged"
                              AutomationProperties.AutomationId="Settings.Language" AutomationProperties.Name="{l:T 'Dil'}" />
                </Grid>
            </Border>
            <Border Style="{StaticResource Row}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <ui:SymbolIcon Symbol="Power24" FontSize="20" Margin="0,0,16,0" VerticalAlignment="Center"
                                   Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                        <TextBlock Style="{StaticResource RowTitle}" Text="{l:T 'Windows ile başlat'}" />
                        <TextBlock Style="{StaticResource Muted}" Text="{l:T 'Oturum açınca tepside sessizce başlar; widget\'lar ve otomatik taşıma hazır olur.'}" />
                        <!-- Store sürümü: görev kullanıcı/ilke yüzünden buradan değiştirilemiyorsa nedeni; test örneğinde uyarı. -->
                        <TextBlock x:Name="StartupState" Style="{StaticResource Muted}" Margin="0,2,0,0" Visibility="Collapsed"
                                   AutomationProperties.AutomationId="Settings.StartupState" />
                    </StackPanel>
                    <Grid Grid.Column="2" Margin="16,0,0,0" VerticalAlignment="Center">
                        <ui:ToggleSwitch x:Name="StartupToggle" Checked="StartupToggle_Changed" Unchecked="StartupToggle_Changed"
                                         AutomationProperties.AutomationId="Settings.Startup" AutomationProperties.Name="{l:T 'Windows ile başlat'}" />
                        <!-- Store sürümü: kullanıcı görevi Windows'tan kapattıysa, ilke yönetiyorsa ya da durum okunamadıysa anahtarın yerine. -->
                        <ui:Button x:Name="StartupSettingsButton" Content="{l:T 'Başlangıç ayarlarını aç'}" Icon="{ui:SymbolIcon Open24}"
                                   Click="OpenStartupSettings_Click" Visibility="Collapsed" />
                    </Grid>
                </Grid>
            </Border>
            <!-- Masaüstü: iki anahtar tek kartta. (1) Windows masaüstü simgeleri (DesktopModes): karşılama ve "Masaüstümü bölmelere
                 ayır" ile aynı seçim. (2) "Widget'lara koyduğum öğeler masaüstünden kalksın" (BoxMover; DesktopModes.SetBoxLeaves):
                 kutu, halka ve klasör bölmesindeki masaüstü öğeleri masaüstünden kalkar; kapatınca hepsi döner. Taşınanların klasörü,
                 "Hepsini masaüstüne geri koy" ve alt seçenekler Gelişmiş > Masaüstünden kalkanlar'da ("Ayrıntılar"). -->
            <Border Style="{StaticResource Row}">
                <StackPanel>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <ui:SymbolIcon Symbol="Desktop24" FontSize="20" Margin="0,0,16,0" VerticalAlignment="Center"
                                       Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                            <TextBlock Style="{StaticResource RowTitle}" Text="{l:T 'Simgeleri bölmelerde topla'}" />
                            <TextBlock x:Name="IconModeText" Style="{StaticResource Muted}" AutomationProperties.AutomationId="Settings.IconModeText" />
                        </StackPanel>
                        <ui:ToggleSwitch x:Name="IconsInFencesToggle" Grid.Column="2" Margin="16,0,0,0" VerticalAlignment="Center"
                                         Checked="IconsInFences_Changed" Unchecked="IconsInFences_Changed"
                                         AutomationProperties.AutomationId="Settings.IconsInFences" AutomationProperties.Name="{l:T 'Simgeleri bölmelerde topla'}" />
                    </Grid>
                    <Grid Margin="36,16,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Style="{StaticResource RowTitle}" Text="{l:T 'Widget\'lara koyduğum öğeler masaüstünden kalksın'}" />
                            <TextBlock x:Name="BoxLeavesText" Style="{StaticResource Muted}" AutomationProperties.AutomationId="Settings.BoxLeavesText" />
                            <TextBlock x:Name="BoxModeLine" Style="{StaticResource Muted}" Margin="0,4,0,0" Visibility="Collapsed"
                                       AutomationProperties.AutomationId="Settings.BoxModeLine">
                                <Hyperlink Click="BoxChange_Click" AutomationProperties.AutomationId="Settings.BoxChange"><Run Text="{l:T 'Ayrıntılar'}" /></Hyperlink>
                            </TextBlock>
                        </StackPanel>
                        <ui:ToggleSwitch x:Name="BoxLeavesToggle" Grid.Column="1" Margin="16,0,0,0" VerticalAlignment="Center"
                                         Checked="BoxLeavesToggle_Changed" Unchecked="BoxLeavesToggle_Changed"
                                         AutomationProperties.AutomationId="Settings.BoxLeaves"
                                         AutomationProperties.Name="{l:T 'Widget\'lara koyduğum öğeler masaüstünden kalksın'}" />
                    </Grid>
                </StackPanel>
            </Border>
            <!-- Halka menü (2.2): NestDesk halkası boş masaüstüne çift tıklayınca (DoubleClickAction "ring") ve isteğe bağlı kısayolla
                 imleçte açılır. Kısayol varsayılan olarak kapalı ve atanmamış; açarken ne yaptığı anlatılır (Widgets.RingShortcut). -->
            <Border Style="{StaticResource Row}">
                <StackPanel>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <ui:SymbolIcon Symbol="DataPie24" FontSize="20" Margin="0,0,16,0" VerticalAlignment="Center"
                                       Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                            <TextBlock Style="{StaticResource RowTitle}" Text="{l:T 'Halka menü'}" />
                            <TextBlock x:Name="RingStatus" Style="{StaticResource Muted}" />
                        </StackPanel>
                        <ui:Button x:Name="RingFold" Grid.Column="2" Style="{StaticResource FoldButton}"
                                   AutomationProperties.AutomationId="Settings.Ring" AutomationProperties.HelpText="{l:T 'Halka menü'}" />
                    </Grid>
                    <StackPanel x:Name="RingContent" Margin="36,12,0,0">
                        <!-- Gelişmiş'teki "Boş masaüstüne çift tıklayınca" kutusuyla aynı ayar ("Halkayı aç"). -->
                        <Grid Margin="0,0,0,8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock Style="{StaticResource RowTitle}" FontWeight="Normal" Text="{l:T 'Boş masaüstüne çift tıklayınca açılsın'}" />
                                <TextBlock Style="{StaticResource Muted}" TextWrapping="Wrap"
                                           Text="{l:T 'Halka imlecin yanında açılır; kısayol gerekmez. Simgeye çift tıklamak yine dosyayı açar. Kapatınca çift tıklama önceki işine döner.'}" />
                            </StackPanel>
                            <ui:ToggleSwitch x:Name="RingDoubleClickToggle" Grid.Column="1" Margin="16,0,0,0" VerticalAlignment="Center"
                                             Checked="RingDoubleClick_Changed" Unchecked="RingDoubleClick_Changed"
                                             AutomationProperties.AutomationId="Settings.RingDoubleClick"
                                             AutomationProperties.Name="{l:T 'Boş masaüstüne çift tıklayınca açılsın'}" />
                        </Grid>
                        <Grid Margin="0,0,0,8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock Style="{StaticResource RowTitle}" FontWeight="Normal" Text="{l:T 'Tuşla imlecin yanında açılsın'}" />
                                <TextBlock x:Name="RingExplain" Style="{StaticResource Muted}" TextWrapping="Wrap" />
                            </StackPanel>
                            <ui:ToggleSwitch x:Name="RingToggle" Grid.Column="1" Margin="16,0,0,0" VerticalAlignment="Center"
                                             Checked="RingToggle_Changed" Unchecked="RingToggle_Changed" AutomationProperties.AutomationId="Settings.RingShortcut"
                                             AutomationProperties.Name="{l:T 'Tuşla imlecin yanında açılsın'}" />
                        </Grid>
                        <Grid x:Name="RingTargetRow" Margin="0,0,0,8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Style="{StaticResource RowTitle}" FontWeight="Normal" VerticalAlignment="Center" Text="{l:T 'Açılacak halka'}" />
                            <ComboBox x:Name="RingTargetBox" Grid.Column="1" Width="250" Margin="16,0,0,0" VerticalAlignment="Center"
                                      DisplayMemberPath="Name" SelectionChanged="RingTargetBox_SelectionChanged"
                                      AutomationProperties.AutomationId="Settings.RingTarget" AutomationProperties.Name="{l:T 'Açılacak halka'}" />
                        </Grid>
                        <Grid Margin="0,0,0,8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock Style="{StaticResource RowTitle}" FontWeight="Normal" Text="{l:T 'Tuşu bırakınca seç'}" />
                                <TextBlock Style="{StaticResource Muted}" TextWrapping="Wrap"
                                           Text="{l:T 'Kısayolu basılı tutup imleci bir öğeye doğru götür; bırakınca o öğe açılır. İmleci oynatmadan bırakırsan halka açık kalır.'}" />
                            </StackPanel>
                            <ui:ToggleSwitch x:Name="RingHoldToggle" Grid.Column="1" Margin="16,0,0,0" VerticalAlignment="Center"
                                             Checked="RingHoldToggle_Changed" Unchecked="RingHoldToggle_Changed" AutomationProperties.AutomationId="Settings.RingHoldSelect"
                                             AutomationProperties.Name="{l:T 'Tuşu bırakınca seç'}" />
                        </Grid>
                        <Grid x:Name="RingEditRow">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Style="{StaticResource Muted}" VerticalAlignment="Center" TextWrapping="Wrap"
                                       Text="{l:T 'Halkadaki uygulamaları ve öğeleri halkanın kendisinden değiştirirsin.'}" />
                            <ui:Button Grid.Column="1" Margin="16,0,0,0" VerticalAlignment="Center" Icon="{ui:SymbolIcon Edit24}"
                                       Content="{l:T 'Halkayı düzenle'}" AutomationProperties.AutomationId="Settings.EditRing" Click="EditRing_Click" />
                        </Grid>
                        <Grid x:Name="RingAddRow">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Style="{StaticResource Muted}" VerticalAlignment="Center" TextWrapping="Wrap"
                                       Text="{l:T 'Halkayı masaüstüne bir widget olarak da koyabilirsin.'}" />
                            <ui:Button Grid.Column="1" Margin="16,0,0,0" VerticalAlignment="Center" Icon="{ui:SymbolIcon Add24}"
                                       Content="{l:T 'Halka menü ekle'}" AutomationProperties.AutomationId="Settings.RingAdd" Click="RingAdd_Click" />
                        </Grid>
                    </StackPanel>
                </StackPanel>
            </Border>
            <!-- Yardım: kısa tur (Ana sayfadaki "Nasıl kullanılır" kartları), karşılama ve sorun kaydı (yalnızca şablon ve sürüm). -->
            <Border Style="{StaticResource Row}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <ui:SymbolIcon Symbol="QuestionCircle24" FontSize="20" Margin="0,0,16,0" VerticalAlignment="Top"
                                   Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                    <StackPanel Grid.Column="1">
                        <TextBlock Style="{StaticResource RowTitle}" Text="{l:T 'Yardım'}" />
                        <TextBlock Style="{StaticResource Muted}" Text="{l:T 'Kısa tur, karşılama ya da sorun kaydı. Var olanlar silinmez.'}" />
                        <WrapPanel Margin="0,12,0,0">
                            <ui:Button Icon="{ui:SymbolIcon Lightbulb24}" Content="{l:T 'Nasıl kullanılır'}" Margin="0,0,8,8"
                                       AutomationProperties.AutomationId="Settings.HowTo" Click="HowTo_Click" />
                            <ui:Button Icon="{ui:SymbolIcon Sparkle24}" Content="{l:T 'Karşılamayı yeniden başlat'}" Margin="0,0,8,8"
                                       AutomationProperties.AutomationId="Settings.Welcome" Click="Welcome_Click" />
                        </WrapPanel>
                        <TextBlock Style="{StaticResource Muted}" Margin="0,2,0,0">
                            <Hyperlink Click="ReportProblem_Click" AutomationProperties.AutomationId="Settings.ReportProblem"><Run Text="{l:T 'GitHub\'da sorun aç'}" /></Hyperlink>
                        </TextBlock>
                    </StackPanel>
                </Grid>
            </Border>
            <TextBlock Style="{StaticResource SectionHeader}" Text="{l:T 'Hakkında'}" />
            <Border Style="{StaticResource Surface}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Image Source="pack://application:,,,/Assets/app.ico" Width="40" Height="40" Margin="0,0,14,0" VerticalAlignment="Top"
                           RenderOptions.BitmapScalingMode="HighQuality" />
                    <StackPanel Grid.Column="1">
                        <TextBlock x:Name="VersionText" Style="{StaticResource RowTitle}" AutomationProperties.AutomationId="Settings.Version" />
                        <TextBlock x:Name="TaglineText" Style="{StaticResource Muted}" />
                        <TextBlock x:Name="ChannelText" Style="{StaticResource Muted}" Margin="0,10,0,0" AutomationProperties.AutomationId="Settings.Channel" />
                        <TextBlock x:Name="PrivacyText" Style="{StaticResource Muted}" Margin="0,4,0,0" />
                        <TextBlock Style="{StaticResource Muted}" Margin="0,2,0,0">
                            <Hyperlink Click="Privacy_Click" AutomationProperties.AutomationId="Settings.Privacy"><Run Text="{l:T 'Gizlilik politikası'}" /></Hyperlink>
                        </TextBlock>
                        <DockPanel Margin="0,14,0,0" LastChildFill="False">
                            <ui:Button x:Name="ReleasesButton" Icon="{ui:SymbolIcon Open24}" Content="{l:T 'İndirme sayfasını aç'}"
                                       AutomationProperties.AutomationId="Settings.Releases" Click="Releases_Click" />
                            <ui:Button DockPanel.Dock="Right" Appearance="Danger" Icon="{ui:SymbolIcon Power24}" Content="{l:T 'Uygulamadan çık'}"
                                       AutomationProperties.AutomationId="Settings.Exit" Click="Exit_Click" />
                        </DockPanel>
                    </StackPanel>
                </Grid>
            </Border>
            <!-- Gelişmiş ayarlar: aynı sayfada ikinci görünüm (geri: "Ayarlar"). -->
            <ui:Button x:Name="AdvancedButton" Style="{StaticResource ActionTile}" Height="72" Margin="0,18,0,0" HorizontalContentAlignment="Stretch"
                       AutomationProperties.AutomationId="Settings.Advanced" AutomationProperties.Name="{l:T 'Gelişmiş ayarlar'}"
                       Click="Advanced_Click">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <ui:SymbolIcon Symbol="Options24" FontSize="20" Margin="0,0,16,0" VerticalAlignment="Center"
                                   Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                        <TextBlock Style="{StaticResource RowTitle}" Text="{l:T 'Gelişmiş ayarlar'}" />
                        <TextBlock Style="{StaticResource Muted}" Text="{l:T 'Masaüstü, görünüm, kısayollar, klasör simgeleri, kutular ve sorun giderme'}" />
                    </StackPanel>
                    <ui:SymbolIcon Grid.Column="2" Symbol="ChevronRight24" FontSize="16" Margin="16,0,0,0" VerticalAlignment="Center"
                                   Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                </Grid>
            </ui:Button>
        </StackPanel>

        <StackPanel x:Name="AdvancedView" Style="{StaticResource PageRoot}" HorizontalAlignment="Stretch" Visibility="Collapsed">
            <ui:Button x:Name="BackButton" Appearance="Transparent" Icon="{ui:SymbolIcon ChevronLeft24}" Content="{l:T 'Ayarlar'}"
                       Margin="-10,0,0,8" Padding="8,5" AutomationProperties.AutomationId="Settings.Back" Click="Back_Click" />
            <TextBlock Style="{StaticResource PageTitle}" Text="{l:T 'Gelişmiş ayarlar'}" />
            <TextBlock Style="{StaticResource PageSubtitle}" Text="{l:T 'Çoğu zaman varsayılanlar yeterli.'}" />
            <TextBlock Style="{StaticResource SectionHeader}" Margin="0,0,0,8" Text="{l:T 'Masaüstü'}" />
            <!-- Windows masaüstüne göz at (Ctrl+Alt+G): simgeler görünür, widget'lar kısa süre çekilir. -->
            <Border Style="{StaticResource Row}">
                <StackPanel>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <ui:SymbolIcon Symbol="Glance24" FontSize="20" Margin="0,0,16,0" VerticalAlignment="Center"
                                       Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                            <TextBlock x:Name="PeekTitle" Style="{StaticResource RowTitle}" Text="{l:T 'Windows masaüstüne göz at'}" />
                            <TextBlock x:Name="PeekText" Style="{StaticResource Muted}" />
                        </StackPanel>
                        <ui:Button x:Name="PeekButton" Grid.Column="2" MinWidth="80" Margin="16,0,0,0" VerticalAlignment="Center"
                                   AutomationProperties.AutomationId="Settings.Peek" Click="Peek_Click" />
                    </Grid>
                    <StackPanel Margin="36,12,0,0">
                        <Grid Margin="0,0,0,8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Style="{StaticResource RowTitle}" FontWeight="Normal" VerticalAlignment="Center" Text="{l:T 'Göz atarken widget\'ları gizle'}" />
                            <ui:ToggleSwitch x:Name="PeekHidesWidgetsToggle" Grid.Column="1" Margin="16,0,0,0" VerticalAlignment="Center"
                                             Checked="PeekHidesWidgets_Changed" Unchecked="PeekHidesWidgets_Changed" AutomationProperties.AutomationId="Settings.PeekHidesWidgets"
                                             AutomationProperties.Name="{l:T 'Göz atarken widget\'ları gizle'}" />
                        </Grid>
                        <Grid Margin="0,0,0,8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock Style="{StaticResource RowTitle}" FontWeight="Normal" Text="{l:T 'Göz atarken açık pencereleri küçült'}" />
                                <TextBlock Style="{StaticResource Muted}" Text="{l:T 'Win+D gibi; dönünce pencereler geri gelir. Çift tıklayınca masaüstü zaten öndedir.'}" />
                            </StackPanel>
                            <ui:ToggleSwitch x:Name="PeekShowsDesktopToggle" Grid.Column="1" Margin="16,0,0,0" VerticalAlignment="Center"
                                             Checked="PeekShowsDesktop_Changed" Unchecked="PeekShowsDesktop_Changed" AutomationProperties.AutomationId="Settings.PeekShowsDesktop"
                                             AutomationProperties.Name="{l:T 'Göz atarken açık pencereleri küçült'}" />
                        </Grid>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Style="{StaticResource RowTitle}" FontWeight="Normal" VerticalAlignment="Center" Text="{l:T 'Kendiliğinden geri dön'}" />
                            <ComboBox x:Name="PeekMinutesBox" Grid.Column="1" Width="170" Margin="16,0,0,0" VerticalAlignment="Center"
                                      SelectionChanged="PeekMinutesBox_SelectionChanged"
                                      AutomationProperties.AutomationId="Settings.PeekMinutes" AutomationProperties.Name="{l:T 'Kendiliğinden geri dön'}">
                                <ComboBoxItem Content="{l:T '1 dakika sonra'}" />
                                <ComboBoxItem Content="{l:T '2 dakika sonra'}" />
                                <ComboBoxItem Content="{l:T '5 dakika sonra'}" />
                                <ComboBoxItem Content="{l:T '10 dakika sonra'}" />
                                <ComboBoxItem Content="{l:T 'Ben dönene dek'}" />
