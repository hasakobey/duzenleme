<Page x:Class="Duzenleme.Views.SettingsPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
      Title="Ayarlar">
    <StackPanel Margin="40,8,40,40">
        <TextBlock Style="{StaticResource PageTitle}" Text="Ayarlar" />
        <TextBlock Style="{StaticResource PageSubtitle}" Text="Uygulamanın görünümü ve davranışı." />

        <ui:CardControl Icon="{ui:SymbolIcon PaintBrush24}" Margin="0,0,0,6">
            <ui:CardControl.Header>
                <StackPanel>
                    <TextBlock Text="Tema" FontWeight="SemiBold" Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                    <TextBlock Style="{StaticResource Muted}" Text="Ana pencerenin görünümü. Widget'ların görünümü kendi menülerinden seçilir." />
                </StackPanel>
            </ui:CardControl.Header>
            <ComboBox x:Name="ThemeBox" Width="170" SelectionChanged="ThemeBox_SelectionChanged">
                <ComboBoxItem Content="Sistem" />
                <ComboBoxItem Content="Koyu" />
                <ComboBoxItem Content="Açık" />
            </ComboBox>
        </ui:CardControl>

        <ui:CardControl Icon="{ui:SymbolIcon Power24}" Margin="0,0,0,6">
            <ui:CardControl.Header>
                <StackPanel>
                    <TextBlock Text="Windows ile başlat" FontWeight="SemiBold" Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                    <TextBlock Style="{StaticResource Muted}" Text="Oturum açınca tepside sessizce başlar; widget'lar ve masaüstü izleme hazır olur." />
                </StackPanel>
            </ui:CardControl.Header>
            <ui:ToggleSwitch x:Name="StartupToggle" Click="StartupToggle_Click" />
        </ui:CardControl>

        <ui:CardControl Icon="{ui:SymbolIcon Alert24}" Margin="0,0,0,6">
            <ui:CardControl.Header>
                <StackPanel>
                    <TextBlock Text="Bildirimler" FontWeight="SemiBold" Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                    <TextBlock Style="{StaticResource Muted}" Text="Bir dosya taşındığında kısa bir bildirim göster." />
                </StackPanel>
            </ui:CardControl.Header>
            <ui:ToggleSwitch x:Name="NotifyToggle" Click="NotifyToggle_Click" />
        </ui:CardControl>

        <TextBlock Style="{StaticResource SectionHeader}" Text="Masaüstünü hızlı gizle" />
        <ui:CardControl Icon="{ui:SymbolIcon CursorClick24}" Margin="0,0,0,6">
            <ui:CardControl.Header>
                <StackPanel>
                    <TextBlock Text="Boş masaüstüne çift tıklayınca gizle/göster" FontWeight="SemiBold" Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                    <TextBlock Style="{StaticResource Muted}" Text="Simgeye çift tıklamak yine dosyayı açar; yalnızca boş alana çift tıklama gizler." />
                </StackPanel>
            </ui:CardControl.Header>
            <ui:ToggleSwitch x:Name="DoubleClickToggle" Click="DoubleClickToggle_Click" />
        </ui:CardControl>
        <ui:CardControl Icon="{ui:SymbolIcon Apps24}" Margin="0,0,0,6">
            <ui:CardControl.Header>
                <StackPanel>
                    <TextBlock Text="Widget'ları da gizle" FontWeight="SemiBold" Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                    <TextBlock Style="{StaticResource Muted}" Text="Kapalıyken yalnızca masaüstü simgeleri gizlenir; saat, not ve bölmeler kalır." />
                </StackPanel>
            </ui:CardControl.Header>
            <ui:ToggleSwitch x:Name="HideWidgetsToggle" Click="HideWidgetsToggle_Click" />
        </ui:CardControl>

        <TextBlock Style="{StaticResource SectionHeader}" Text="Klavye kısayolları" />
        <TextBlock Style="{StaticResource Muted}" Margin="0,-4,0,10"
                   Text="Kutuya tıkla ve yeni tuş birleşimine bas (en az bir Ctrl/Alt/Shift/Win). Silmek için Backspace." />
        <ItemsControl x:Name="HotkeyList">
            <ItemsControl.ItemTemplate>
                <DataTemplate>
                    <Border Style="{StaticResource Surface}" Padding="16,10" Margin="0,0,0,6">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="200" />
                            </Grid.ColumnDefinitions>
                            <ui:SymbolIcon Symbol="{Binding Icon}" FontSize="20" Margin="0,0,16,0" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                <TextBlock Text="{Binding Label}" FontWeight="SemiBold" Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                                <TextBlock Text="{Binding Status}" Style="{StaticResource Muted}" Foreground="{Binding StatusBrush}" />
                            </StackPanel>
                            <TextBox Grid.Column="2" Text="{Binding Text, Mode=OneWay}" IsReadOnly="True" IsReadOnlyCaretVisible="False"
                                     HorizontalContentAlignment="Center" FontWeight="SemiBold" Cursor="Hand"
                                     PreviewKeyDown="HotkeyBox_PreviewKeyDown" />
                        </Grid>
                    </Border>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>
        <ui:Button Content="Kısayolları varsayılana döndür" Icon="{ui:SymbolIcon ArrowReset24}" Margin="0,4,0,0" Click="ResetHotkeys_Click" />

        <TextBlock Style="{StaticResource SectionHeader}" Text="Yapay zekâ ile simge üretme (isteğe bağlı)" />
        <Border Style="{StaticResource Surface}" Padding="18,16">
            <StackPanel>
                <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                    <ui:SymbolIcon Symbol="Sparkle24" FontSize="20" Foreground="{DynamicResource AccentTextFillColorPrimaryBrush}" Margin="0,0,10,0" />
                    <TextBlock Text="Claude API anahtarı" FontWeight="SemiBold" VerticalAlignment="Center" Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                    <TextBlock x:Name="KeyStatus" Style="{StaticResource Muted}" Margin="10,0,0,0" VerticalAlignment="Center" />
                </StackPanel>
                <TextBlock Style="{StaticResource Muted}" Margin="0,0,0,12"
                           Text="Anahtarı girersen klasör simgesi penceresinde yazdığın açıklamaya göre yeni simge üretebilirsin. Anahtar yalnızca bu bilgisayarda, Windows hesabına bağlı şifrelenerek saklanır. Üretim başına küçük bir API ücreti (birkaç sent) Anthropic hesabına yansır. Anahtar zorunlu değil; hazır simgeler anahtarsız çalışır." />
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <ui:PasswordBox x:Name="KeyBox" PlaceholderText="sk-ant-…" Icon="{ui:SymbolIcon Key24}" />
                    <ui:Button x:Name="SaveKeyButton" Grid.Column="1" Margin="10,0,0,0" Appearance="Primary" Content="Kaydet ve doğrula" Click="SaveKey_Click" />
                    <ui:Button Grid.Column="2" Margin="8,0,0,0" Icon="{ui:SymbolIcon Delete24}" Content="Sil" Click="DeleteKey_Click" />
                </Grid>
                <ui:InfoBar x:Name="KeyFeedback" Margin="0,10,0,0" IsClosable="True" />
                <TextBlock Style="{StaticResource Muted}" Margin="0,8,0,0">
                    <Run Text="Anahtarın yoksa: " /><Hyperlink NavigateUri="https://console.anthropic.com/settings/keys" RequestNavigate="Link_RequestNavigate">console.anthropic.com</Hyperlink>
                </TextBlock>
            </StackPanel>
        </Border>

        <TextBlock Style="{StaticResource SectionHeader}" Text="Klasörler" />
        <ui:CardControl Icon="{ui:SymbolIcon Desktop24}" Margin="0,0,0,6">
            <ui:CardControl.Header>
                <StackPanel>
                    <TextBlock Text="İzlenen masaüstü" FontWeight="SemiBold" Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                    <TextBlock x:Name="DesktopPath" Style="{StaticResource Muted}" />
                </StackPanel>
            </ui:CardControl.Header>
            <ui:Button Content="Aç" Icon="{ui:SymbolIcon Open24}" Click="OpenDesktop_Click" />
        </ui:CardControl>
        <ui:CardControl Icon="{ui:SymbolIcon Database24}" Margin="0,0,0,6">
            <ui:CardControl.Header>
                <StackPanel>
                    <TextBlock Text="Ayar ve geçmiş dosyaları" FontWeight="SemiBold" Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                    <TextBlock x:Name="DataPath" Style="{StaticResource Muted}" />
                    <TextBlock x:Name="PortableText" Style="{StaticResource Muted}" Margin="0,2,0,0" />
                </StackPanel>
            </ui:CardControl.Header>
            <ui:Button Content="Aç" Icon="{ui:SymbolIcon Open24}" Click="OpenData_Click" />
        </ui:CardControl>

        <TextBlock Style="{StaticResource SectionHeader}" Text="Hakkında" />
        <Border Style="{StaticResource Surface}">
            <StackPanel Orientation="Horizontal">
                <Image Source="pack://application:,,,/Assets/app.ico" Width="40" Height="40" Margin="0,0,14,0" />
                <StackPanel VerticalAlignment="Center">
                    <TextBlock x:Name="VersionText" FontWeight="SemiBold" Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                    <TextBlock Style="{StaticResource Muted}" Text="Masaüstü düzenleyici · saat ve tarih widget'ları · klasör bölmeleri" />
                </StackPanel>
                <ui:Button Margin="24,0,0,0" Appearance="Danger" Icon="{ui:SymbolIcon Power24}" Content="Uygulamadan çık" Click="Exit_Click" VerticalAlignment="Center" />
            </StackPanel>
        </Border>
    </StackPanel>
</Page>
