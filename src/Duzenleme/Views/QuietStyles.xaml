<!--
    WPF-UI 4.3'ün örtük ContextMenu, MenuItem, ScrollBar ve DynamicScrollBar stillerinin animasyonsuz sürümleri.
    WPF-UI bunlarda şablon içi animasyon kullanır: sağ tık menüsü ve fareyle açılan alt menüler 167 ms'de yukarıdan kayar; kaydırma
    çubukları fare üstüne gelince genişleyip ok düğmeleriyle belirir; ana penceredeki sayfaların çubuğu (DynamicScrollBar)
    fare yokken hiç görünmez, kullanıcı sayfanın devam ettiğini anlamaz. Burada menüler anında açılır, kaydırma çubuğu içerik
    taşınca hep görünür ve fareyle değişmez. App.xaml'da ControlsDictionary'den SONRA birleştirilir (örtük stiller bunları ezer).
    Şablonlar WPF-UI 4.3.0'dan (MIT, bkz. THIRD-PARTY-NOTICES.txt) alındı; yalnızca animasyonlar ve fareyle beliren parçalar
    çıkarıldı. WPF-UI sürümü yükseltilince şablonlar yeniden karşılaştırılmalı.
-->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml">

    <!-- ================================================================ Sağ tık menüsü -->

    <!-- ContextMenu'nün açılır penceresi geçişini stilden değil bu anahtardan alır (Windows'un "menüleri soldur" ayarı, ~150 ms
         solma). Alt menülerin penceresinde şablon zaten PopupAnimation="None" der. -->
    <PopupAnimation x:Key="{x:Static SystemParameters.MenuPopupAnimationKey}">None</PopupAnimation>

    <Style TargetType="{x:Type ContextMenu}">
        <Setter Property="TextElement.Foreground" Value="{DynamicResource ContextMenuForeground}" />
        <Setter Property="Foreground" Value="{DynamicResource ContextMenuForeground}" />
        <Setter Property="Background" Value="{DynamicResource ContextMenuBackground}" />
        <Setter Property="BorderBrush" Value="{DynamicResource ContextMenuBorderBrush}" />
        <Setter Property="MinWidth" Value="140" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="Margin" Value="0" />
        <Setter Property="HasDropShadow" Value="False" />
        <Setter Property="Grid.IsSharedSizeScope" Value="True" />
        <Setter Property="Popup.PopupAnimation" Value="None" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
        <!-- Menü saydam bir açılır pencerededir; 30 DIP'lik gölge payı %125'te yarım piksele düşer ve yuvarlanmazsa bütün menü
             (yazılar dahil) yarım piksel kaymış, bulanık çizilir. Alt menülerin açılır penceresi şablonda ayrıca yuvarlanır. -->
        <Setter Property="UseLayoutRounding" Value="True" />
        <Setter Property="OverridesDefaultStyle" Value="True" />
        <Setter Property="Template">
            <Setter.Value>
                <!-- WPF-UI: IsOpen'da Border 167 ms'de -90'dan 0'a kayardı. -->
                <ControlTemplate TargetType="{x:Type ContextMenu}">
                    <ui:EffectThicknessDecorator Thickness="30">
                        <Border x:Name="Border" Padding="0,3,0,3" BorderThickness="1" CornerRadius="8"
                                Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}">
                            <Border.Effect>
                                <DropShadowEffect BlurRadius="20" Direction="270" Opacity="0.135" ShadowDepth="10" Color="#202020" />
                            </Border.Effect>
                            <StackPanel ClipToBounds="True" IsItemsHost="True" KeyboardNavigation.DirectionalNavigation="Cycle"
                                        Orientation="Vertical" />
                        </Border>
                    </ui:EffectThicknessDecorator>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ================================================================ Menü öğesi -->

    <!-- Alt menüsü olan öğe (Görünüm ▸, Renk ▸…). WPF-UI: alt menü açılınca 167 ms'de yukarıdan kayardı. -->
    <ControlTemplate x:Key="QuietSubmenuHeaderTemplate" TargetType="{x:Type MenuItem}">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <Border x:Name="Border" Grid.Row="1" Margin="4,1,4,1" BorderThickness="1" CornerRadius="4">
                <Grid x:Name="MenuItemContent" Margin="8,6,8,6">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <ContentPresenter x:Name="Icon" Grid.Column="0" Margin="0,0,6,0" VerticalAlignment="Center"
                                      Content="{TemplateBinding Icon}" KeyboardNavigation.IsTabStop="False" />
                    <ContentPresenter x:Name="Header" Grid.Column="1" ContentSource="Header" RecognizesAccessKey="True" />
                    <Grid Grid.Column="2">
                        <ui:SymbolIcon x:Name="Chevron" Margin="0,3,0,0" VerticalAlignment="Center"
                                       FontSize="{TemplateBinding FontSize}" Symbol="ChevronRight20" />
                    </Grid>
                </Grid>
            </Border>

            <Popup x:Name="Popup" Grid.Row="1" AllowsTransparency="True" Focusable="False"
                   IsOpen="{TemplateBinding IsSubmenuOpen}" Placement="Right"
                   PlacementTarget="{Binding ElementName=MenuItemContent}" PopupAnimation="None" VerticalOffset="-20">
                <Grid UseLayoutRounding="True">
                    <Border x:Name="SubmenuBorder" Margin="12,10,12,30" Padding="0,3,0,3" BorderThickness="1" CornerRadius="8"
                            Background="{DynamicResource FlyoutBackground}" BorderBrush="{DynamicResource FlyoutBorderBrush}"
                            SnapsToDevicePixels="True">
                        <ui:PassiveScrollViewer CanContentScroll="True" Style="{StaticResource UiMenuItemScrollViewer}">
                            <StackPanel IsItemsHost="True" KeyboardNavigation.DirectionalNavigation="Cycle" />
                        </ui:PassiveScrollViewer>
                        <Border.Effect>
                            <DropShadowEffect BlurRadius="20" Direction="270" Opacity="0.135" ShadowDepth="10" Color="#202020" />
                        </Border.Effect>
                    </Border>
                </Grid>
            </Popup>
        </Grid>
        <ControlTemplate.Triggers>
            <Trigger Property="Icon" Value="{x:Null}">
                <Setter TargetName="Icon" Property="Visibility" Value="Collapsed" />
                <Setter TargetName="Icon" Property="Margin" Value="0" />
            </Trigger>
            <Trigger Property="IsHighlighted" Value="True">
                <Setter TargetName="Border" Property="Background" Value="{DynamicResource MenuBarItemBackgroundSelected}" />
            </Trigger>
            <MultiTrigger>
                <MultiTrigger.Conditions>
                    <Condition Property="IsMouseOver" Value="True" />
                    <Condition Property="IsPressed" Value="False" />
                </MultiTrigger.Conditions>
                <Setter TargetName="Border" Property="Background" Value="{DynamicResource MenuBarItemBackgroundSelected}" />
            </MultiTrigger>
            <MultiTrigger>
                <MultiTrigger.Conditions>
                    <Condition Property="IsMouseOver" Value="True" />
                    <Condition Property="IsPressed" Value="True" />
                </MultiTrigger.Conditions>
                <Setter TargetName="Border" Property="Background" Value="{DynamicResource MenuBarItemBackgroundPressed}" />
                <Setter TargetName="Icon" Property="TextElement.Foreground" Value="{DynamicResource MenuBarItemTextForegroundPressed}" />
                <Setter TargetName="Header" Property="TextElement.Foreground" Value="{DynamicResource MenuBarItemTextForegroundPressed}" />
            </MultiTrigger>
            <Trigger Property="IsEnabled" Value="False">
                <Setter Property="Foreground">
                    <Setter.Value>
                        <SolidColorBrush Color="{DynamicResource TextFillColorDisabled}" />
                    </Setter.Value>
                </Setter>
                <Setter TargetName="Chevron" Property="Foreground">
                    <Setter.Value>
                        <SolidColorBrush Color="{DynamicResource TextFillColorDisabled}" />
                    </Setter.Value>
                </Setter>
            </Trigger>
        </ControlTemplate.Triggers>
    </ControlTemplate>

    <!-- WPF-UI'nin MenuItem stili; yalnızca alt menü başlığı şablonu yukarıdaki. Diğer rollerin şablonlarında animasyon yok
         (menü çubuğu, yani TopLevelHeader, uygulamada kullanılmıyor). -->
    <Style TargetType="{x:Type MenuItem}">
        <Setter Property="FocusVisualStyle">
            <Setter.Value>
                <Style BasedOn="{StaticResource DefaultControlFocusVisualStyle}">
                    <Setter Property="Control.Margin" Value="4,1" />
                </Style>
            </Setter.Value>
        </Setter>
        <Setter Property="KeyboardNavigation.IsTabStop" Value="True" />
        <Setter Property="Focusable" Value="True" />
        <Setter Property="OverridesDefaultStyle" Value="True" />
        <Style.Triggers>
            <Trigger Property="Role" Value="TopLevelHeader">
                <Setter Property="Template" Value="{DynamicResource {x:Static MenuItem.TopLevelHeaderTemplateKey}}" />
                <Setter Property="Grid.IsSharedSizeScope" Value="True" />
            </Trigger>
            <Trigger Property="Role" Value="TopLevelItem">
                <Setter Property="Template" Value="{DynamicResource {x:Static MenuItem.TopLevelItemTemplateKey}}" />
            </Trigger>
            <Trigger Property="Role" Value="SubmenuHeader">
                <Setter Property="Template" Value="{StaticResource QuietSubmenuHeaderTemplate}" />
            </Trigger>
            <Trigger Property="Role" Value="SubmenuItem">
                <Setter Property="Template" Value="{DynamicResource {x:Static MenuItem.SubmenuItemTemplateKey}}" />
            </Trigger>
        </Style.Triggers>
    </Style>

    <!-- ================================================================ Kaydırma çubuğu -->

    <!-- İnce, hep görünür başparmak (6 px); tutma yeri çubuğun bütün genişliği. Fareyle genişlemez, ok düğmesi ve fareyle
         beliren iz yok. İzin boş yerine tıklamak sayfa sayfa kaydırır. -->
    <Style x:Key="QuietScrollBarPageButton" TargetType="{x:Type RepeatButton}">
        <Setter Property="SnapsToDevicePixels" Value="True" />
        <Setter Property="OverridesDefaultStyle" Value="True" />
        <Setter Property="IsTabStop" Value="False" />
        <Setter Property="Focusable" Value="False" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type RepeatButton}">
                    <Border Background="Transparent" />
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="QuietScrollBarThumbVertical" TargetType="{x:Type Thumb}">
        <Setter Property="Background" Value="{DynamicResource ScrollBarThumbFill}" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
        <Setter Property="OverridesDefaultStyle" Value="True" />
        <Setter Property="IsTabStop" Value="False" />
        <Setter Property="Focusable" Value="False" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type Thumb}">
                    <Border Background="Transparent">
                        <Border Width="6" HorizontalAlignment="Center" CornerRadius="3" Background="{TemplateBinding Background}" />
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="QuietScrollBarThumbHorizontal" TargetType="{x:Type Thumb}" BasedOn="{StaticResource QuietScrollBarThumbVertical}">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type Thumb}">
                    <Border Background="Transparent">
                        <Border Height="6" VerticalAlignment="Center" CornerRadius="3" Background="{TemplateBinding Background}" />
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <ControlTemplate x:Key="QuietVerticalScrollBar" TargetType="{x:Type ScrollBar}">
        <Border Background="Transparent" Padding="0,2">
            <Track x:Name="PART_Track" IsDirectionReversed="True">
                <Track.DecreaseRepeatButton>
                    <RepeatButton Command="ScrollBar.PageUpCommand" Style="{StaticResource QuietScrollBarPageButton}" />
                </Track.DecreaseRepeatButton>
                <Track.Thumb>
                    <Thumb Style="{StaticResource QuietScrollBarThumbVertical}" />
                </Track.Thumb>
                <Track.IncreaseRepeatButton>
                    <RepeatButton Command="ScrollBar.PageDownCommand" Style="{StaticResource QuietScrollBarPageButton}" />
                </Track.IncreaseRepeatButton>
            </Track>
        </Border>
    </ControlTemplate>

    <ControlTemplate x:Key="QuietHorizontalScrollBar" TargetType="{x:Type ScrollBar}">
        <Border Background="Transparent" Padding="2,0">
            <Track x:Name="PART_Track" IsDirectionReversed="False">
                <Track.DecreaseRepeatButton>
                    <RepeatButton Command="ScrollBar.PageLeftCommand" Style="{StaticResource QuietScrollBarPageButton}" />
                </Track.DecreaseRepeatButton>
                <Track.Thumb>
                    <Thumb Style="{StaticResource QuietScrollBarThumbHorizontal}" />
                </Track.Thumb>
                <Track.IncreaseRepeatButton>
                    <RepeatButton Command="ScrollBar.PageRightCommand" Style="{StaticResource QuietScrollBarPageButton}" />
                </Track.IncreaseRepeatButton>
            </Track>
        </Border>
    </ControlTemplate>

    <Style x:Key="QuietScrollBar" TargetType="{x:Type ScrollBar}">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Margin" Value="0" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
        <Setter Property="OverridesDefaultStyle" Value="True" />
        <Style.Triggers>
            <Trigger Property="Orientation" Value="Horizontal">
                <Setter Property="Width" Value="Auto" />
                <Setter Property="Height" Value="14" />
                <Setter Property="Template" Value="{StaticResource QuietHorizontalScrollBar}" />
            </Trigger>
            <Trigger Property="Orientation" Value="Vertical">
                <Setter Property="Width" Value="14" />
                <Setter Property="Height" Value="Auto" />
                <Setter Property="Template" Value="{StaticResource QuietVerticalScrollBar}" />
            </Trigger>
        </Style.Triggers>
    </Style>

    <Style TargetType="{x:Type ScrollBar}" BasedOn="{StaticResource QuietScrollBar}" />

    <!-- Ana penceredeki sayfaları kaydıran NavigationView'in çubuğu: WPF-UI'de fare gelene dek görünmez (Opacity 0). -->
    <Style TargetType="{x:Type ui:DynamicScrollBar}" BasedOn="{StaticResource QuietScrollBar}" />

</ResourceDictionary>
