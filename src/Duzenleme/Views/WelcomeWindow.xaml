<ui:FluentWindow x:Class="Duzenleme.Views.WelcomeWindow"
                 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                 xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
                 Width="680" Height="540" MinWidth="0" MinHeight="0"
                 ResizeMode="CanMinimize" ShowInTaskbar="True" Topmost="False"
                 WindowStartupLocation="CenterScreen"
                 ExtendsContentIntoTitleBar="True"
                 WindowBackdropType="Mica"
                 WindowCornerPreference="Round"
                 Icon="pack://application:,,,/Assets/app.ico">
    <ui:FluentWindow.Resources>
        <!-- Karşılamada hiçbir şey kaymaz ya da solmaz: seçilen kartın kenarı 2 px olur, dolgusu 1 px azalır (içerik yerinde
             kalır); işaretler anında görünür. Şablonlar bu yüzden WPF-UI'nin geçişli şablonları yerine burada tanımlı. -->
        <Style x:Key="ChoiceCard" TargetType="RadioButton">
            <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="Margin" Value="0,0,0,8" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="Card" CornerRadius="8" BorderThickness="1" Padding="16,10"
                                Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
                                BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Grid Width="20" Height="20" Margin="0,0,12,0" VerticalAlignment="Top">
                                    <Ellipse x:Name="Ring" StrokeThickness="1.5" Fill="Transparent"
                                             Stroke="{DynamicResource ControlStrongStrokeColorDefaultBrush}" />
                                    <Ellipse x:Name="Dot" Width="10" Height="10" Visibility="Hidden"
                                             Fill="{DynamicResource AccentFillColorDefaultBrush}" />
                                </Grid>
                                <ContentPresenter Grid.Column="1" HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" />
                            </Grid>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Card" Property="Background" Value="{DynamicResource CardBackgroundFillColorSecondaryBrush}" />
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Card" Property="BorderThickness" Value="2" />
                                <Setter TargetName="Card" Property="Padding" Value="15,9" />
                                <Setter TargetName="Card" Property="BorderBrush" Value="{DynamicResource AccentFillColorDefaultBrush}" />
                                <Setter TargetName="Ring" Property="Stroke" Value="{DynamicResource AccentFillColorDefaultBrush}" />
                                <Setter TargetName="Dot" Property="Visibility" Value="Visible" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Card" Property="Opacity" Value="0.55" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Klasör çipi ve araç kutucuğu: sol üstte/sağ üstte kare onay işareti, seçilince kenar 2 px. -->
        <Style x:Key="FolderChip" TargetType="ToggleButton">
            <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}" />
            <Setter Property="Width" Value="142" />
            <Setter Property="Margin" Value="0,0,8,8" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToggleButton">
                        <Border x:Name="Card" CornerRadius="6" BorderThickness="1" Padding="10,5"
                                Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
                                BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Border x:Name="Box" Width="16" Height="16" Margin="0,1,8,0" VerticalAlignment="Top" CornerRadius="3"
                                        BorderThickness="1" Background="Transparent"
                                        BorderBrush="{DynamicResource ControlStrongStrokeColorDefaultBrush}">
                                    <ui:SymbolIcon x:Name="Check" Symbol="Checkmark12" FontSize="12" Visibility="Hidden"
                                                   Foreground="{DynamicResource TextOnAccentFillColorPrimaryBrush}" />
                                </Border>
                                <ContentPresenter Grid.Column="1" HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" />
                            </Grid>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Card" Property="Background" Value="{DynamicResource CardBackgroundFillColorSecondaryBrush}" />
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Card" Property="BorderThickness" Value="2" />
                                <Setter TargetName="Card" Property="Padding" Value="9,4" />
                                <Setter TargetName="Card" Property="BorderBrush" Value="{DynamicResource AccentFillColorDefaultBrush}" />
                                <Setter TargetName="Box" Property="Background" Value="{DynamicResource AccentFillColorDefaultBrush}" />
                                <Setter TargetName="Box" Property="BorderBrush" Value="{DynamicResource AccentFillColorDefaultBrush}" />
                                <Setter TargetName="Check" Property="Visibility" Value="Visible" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Card" Property="Opacity" Value="0.55" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="ToolTile" TargetType="ToggleButton">
            <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}" />
            <Setter Property="Width" Value="112" />
            <Setter Property="Height" Value="118" />
            <Setter Property="Margin" Value="0,0,8,8" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToggleButton">
                        <Border x:Name="Card" CornerRadius="8" BorderThickness="1" Padding="8"
                                Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
                                BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}">
                            <Grid>
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                                <Border x:Name="Box" Width="16" Height="16" HorizontalAlignment="Right" VerticalAlignment="Top"
                                        CornerRadius="3" BorderThickness="1" Background="Transparent"
                                        BorderBrush="{DynamicResource ControlStrongStrokeColorDefaultBrush}">
                                    <ui:SymbolIcon x:Name="Check" Symbol="Checkmark12" FontSize="12" Visibility="Hidden"
                                                   Foreground="{DynamicResource TextOnAccentFillColorPrimaryBrush}" />
                                </Border>
                            </Grid>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Card" Property="Background" Value="{DynamicResource CardBackgroundFillColorSecondaryBrush}" />
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Card" Property="BorderThickness" Value="2" />
                                <Setter TargetName="Card" Property="Padding" Value="7" />
                                <Setter TargetName="Card" Property="BorderBrush" Value="{DynamicResource AccentFillColorDefaultBrush}" />
                                <Setter TargetName="Box" Property="Background" Value="{DynamicResource AccentFillColorDefaultBrush}" />
                                <Setter TargetName="Box" Property="BorderBrush" Value="{DynamicResource AccentFillColorDefaultBrush}" />
                                <Setter TargetName="Check" Property="Visibility" Value="Visible" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Card" Property="Opacity" Value="0.55" />
                                <Setter TargetName="Box" Property="Visibility" Value="Hidden" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="StepText" TargetType="TextBlock">
            <Setter Property="FontSize" Value="14" />
            <Setter Property="TextWrapping" Value="Wrap" />
            <Setter Property="Foreground" Value="{DynamicResource TextFillColorSecondaryBrush}" />
            <Setter Property="Margin" Value="0,0,0,12" />
        </Style>
        <Style x:Key="Question" TargetType="TextBlock">
            <Setter Property="FontSize" Value="15" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}" />
            <Setter Property="Margin" Value="0,0,0,8" />
        </Style>
        <Style x:Key="CardHeader" TargetType="TextBlock">
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="TextWrapping" Value="Wrap" />
            <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}" />
        </Style>

        <!-- Önce/sonra çizimindeki simgeler. -->
        <Style x:Key="Scatter" TargetType="ui:SymbolIcon">
            <Setter Property="FontSize" Value="18" />
            <Setter Property="Foreground" Value="{DynamicResource TextFillColorSecondaryBrush}" />
        </Style>
        <Style x:Key="MiniIcon" TargetType="ui:SymbolIcon">
            <Setter Property="FontSize" Value="14" />
            <Setter Property="Margin" Value="0,0,4,0" />
            <Setter Property="Foreground" Value="{DynamicResource TextFillColorSecondaryBrush}" />
        </Style>
        <Style x:Key="MiniFence" TargetType="Border">
            <Setter Property="Margin" Value="3" />
            <Setter Property="Padding" Value="6,3" />
            <Setter Property="CornerRadius" Value="5" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Background" Value="{DynamicResource CardBackgroundFillColorDefaultBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource CardStrokeColorDefaultBrush}" />
        </Style>
        <Style x:Key="MiniTitle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="10" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Margin" Value="0,0,0,2" />
            <Setter Property="TextTrimming" Value="CharacterEllipsis" />
            <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}" />
        </Style>
    </ui:FluentWindow.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Sabit boyutlu pencere: başlığa çift tıklamak da büyütmez. ✕ "Şimdilik atla" ile aynı işi görür. -->
        <ui:TitleBar x:Name="TitleBar" Grid.Row="0" ShowMaximize="False" CanMaximize="False" CloseWindowByDoubleClickOnIcon="False">
            <ui:TitleBar.Icon>
                <ui:ImageIcon Source="pack://application:,,,/Assets/app.ico" RenderOptions.BitmapScalingMode="HighQuality" />
            </ui:TitleBar.Icon>
        </ui:TitleBar>

        <!-- Sabit üst başlık: adımın sorusu ve "Adım i / 3". -->
        <Grid Grid.Row="1" Margin="28,4,28,6">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBlock x:Name="StepTitle" FontSize="22" FontWeight="SemiBold" TextWrapping="Wrap"
                       FontFamily="Segoe UI Variable Display, Segoe UI"
                       Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                       AutomationProperties.AutomationId="Welcome.Title" />
            <TextBlock x:Name="StepCounter" Grid.Column="1" Margin="16,0,0,0" VerticalAlignment="Center"
                       Style="{StaticResource Muted}" AutomationProperties.AutomationId="Welcome.Step" />
        </Grid>

        <ScrollViewer x:Name="Scroller" Grid.Row="2" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <Grid Margin="28,0,28,0">
                <!-- Adım 1: Bölmeler -->
                <StackPanel x:Name="Step1">
                    <TextBlock x:Name="Step1Text" Style="{StaticResource StepText}" />
                    <TextBlock Style="{StaticResource Question}" Text="Masaüstünü bölmelere ayıralım mı?" />

                    <!-- Durağan önce/sonra çizimi. -->
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,12" HorizontalAlignment="Left">
                        <StackPanel>
                            <TextBlock Style="{StaticResource Muted}" FontSize="10.5" Margin="2,0,0,2" Text="önce" />
                            <Border Width="150" Height="56" CornerRadius="8" BorderThickness="1"
                                    Background="{DynamicResource ControlFillColorSecondaryBrush}"
                                    BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}">
                                <Canvas>
                                    <ui:SymbolIcon Style="{StaticResource Scatter}" Symbol="DocumentPdf24" Canvas.Left="10" Canvas.Top="5" />
                                    <ui:SymbolIcon Style="{StaticResource Scatter}" Symbol="Folder24" Canvas.Left="42" Canvas.Top="16" />
                                    <ui:SymbolIcon Style="{StaticResource Scatter}" Symbol="Image24" Canvas.Left="80" Canvas.Top="4" />
                                    <ui:SymbolIcon Style="{StaticResource Scatter}" Symbol="Globe24" Canvas.Left="118" Canvas.Top="20" />
                                    <ui:SymbolIcon Style="{StaticResource Scatter}" Symbol="Document24" Canvas.Left="16" Canvas.Top="31" />
                                    <ui:SymbolIcon Style="{StaticResource Scatter}" Symbol="Mail24" Canvas.Left="62" Canvas.Top="33" />
                                    <ui:SymbolIcon Style="{StaticResource Scatter}" Symbol="Image24" Canvas.Left="96" Canvas.Top="30" />
                                    <ui:SymbolIcon Style="{StaticResource Scatter}" Symbol="Folder24" Canvas.Left="126" Canvas.Top="1" />
                                </Canvas>
                            </Border>
                        </StackPanel>
                        <ui:SymbolIcon Symbol="ArrowRight24" FontSize="20" Margin="14,12,14,0" VerticalAlignment="Center"
                                       Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                        <StackPanel>
                            <TextBlock Style="{StaticResource Muted}" FontSize="10.5" Margin="2,0,0,2" Text="sonra" />
                            <Border Width="300" Height="56" CornerRadius="8" BorderThickness="1" Padding="4"
                                    Background="{DynamicResource ControlFillColorSecondaryBrush}"
                                    BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}">
                                <UniformGrid Columns="3">
                                    <Border Style="{StaticResource MiniFence}">
                                        <StackPanel>
                                            <TextBlock Style="{StaticResource MiniTitle}" Text="Klasörler" />
                                            <WrapPanel>
                                                <ui:SymbolIcon Style="{StaticResource MiniIcon}" Symbol="Folder24" />
                                                <ui:SymbolIcon Style="{StaticResource MiniIcon}" Symbol="Folder24" />
                                                <ui:SymbolIcon Style="{StaticResource MiniIcon}" Symbol="Folder24" />
                                            </WrapPanel>
                                        </StackPanel>
                                    </Border>
                                    <Border Style="{StaticResource MiniFence}">
                                        <StackPanel>
                                            <TextBlock Style="{StaticResource MiniTitle}" Text="Kısayollar" />
                                            <WrapPanel>
                                                <ui:SymbolIcon Style="{StaticResource MiniIcon}" Symbol="Globe24" />
                                                <ui:SymbolIcon Style="{StaticResource MiniIcon}" Symbol="Mail24" />
                                            </WrapPanel>
                                        </StackPanel>
                                    </Border>
                                    <Border Style="{StaticResource MiniFence}">
                                        <StackPanel>
                                            <TextBlock Style="{StaticResource MiniTitle}" Text="Dosyalar" />
                                            <WrapPanel>
                                                <ui:SymbolIcon Style="{StaticResource MiniIcon}" Symbol="DocumentPdf24" />
                                                <ui:SymbolIcon Style="{StaticResource MiniIcon}" Symbol="Image24" />
                                                <ui:SymbolIcon Style="{StaticResource MiniIcon}" Symbol="Document24" />
                                            </WrapPanel>
                                        </StackPanel>
                                    </Border>
                                </UniformGrid>
                            </Border>
                        </StackPanel>
                    </StackPanel>

                    <RadioButton x:Name="FencesYes" GroupName="Fences" Style="{StaticResource ChoiceCard}" IsChecked="True"
                                 AutomationProperties.AutomationId="Welcome.FencesYes" AutomationProperties.Name="Evet, bölmelere ayır">
                        <StackPanel>
                            <DockPanel>
                                <Border DockPanel.Dock="Right" CornerRadius="4" Padding="7,1" Margin="8,0,0,0" VerticalAlignment="Top"
                                        Background="{DynamicResource AccentFillColorDefaultBrush}">
                                    <TextBlock Text="Önerilen" FontSize="11" Foreground="{DynamicResource TextOnAccentFillColorPrimaryBrush}" />
                                </Border>
                                <TextBlock Style="{StaticResource CardHeader}" Text="Evet, bölmelere ayır" />
                            </DockPanel>
                            <TextBlock x:Name="FencePlan" Style="{StaticResource Muted}" Margin="0,2,0,0"
                                       AutomationProperties.AutomationId="Welcome.FencePlan" />
                            <CheckBox x:Name="IconsOnly" Margin="0,8,0,0" Content="Simgeler yalnızca bölmelerde görünsün"
                                      IsEnabled="{Binding IsChecked, ElementName=FencesYes}"
                                      AutomationProperties.AutomationId="Welcome.IconsOnly" />
                            <TextBlock x:Name="IconsOnlyText" Style="{StaticResource Muted}" Margin="28,2,0,0" />
                            <TextBlock Style="{StaticResource Muted}" Margin="28,2,0,0"
                                       Text="Bu açıkken yeni klasör açmak ya da ad değiştirmek için bölmeye sağ tıkla." />
                        </StackPanel>
                    </RadioButton>
                    <RadioButton x:Name="FencesNo" GroupName="Fences" Style="{StaticResource ChoiceCard}"
                                 AutomationProperties.AutomationId="Welcome.FencesNo" AutomationProperties.Name="Şimdilik hayır">
                        <StackPanel>
                            <TextBlock Style="{StaticResource CardHeader}" Text="Şimdilik hayır" />
                            <TextBlock Style="{StaticResource Muted}" Margin="0,2,0,0"
                                       Text="Masaüstün olduğu gibi kalır. Bölmeleri sonra &quot;Widget ekle&quot;den ekleyebilirsin." />
                        </StackPanel>
                    </RadioButton>
                </StackPanel>

                <!-- Adım 2: Dosya taşıma (açık onay) -->
                <StackPanel x:Name="Step2" Visibility="Collapsed">
                    <TextBlock Style="{StaticResource StepText}"
                               Text="Masaüstüne bir dosya geldiğinde türüne uygun klasöre taşınır: PDF'ler &quot;PDF&quot; klasörüne, fotoğraflar &quot;Resimler&quot; klasörüne… Klasörler masaüstünde durur." />
                    <TextBlock Style="{StaticResource Question}" Text="Hangi klasörler kullanılsın?" />
                    <WrapPanel x:Name="FolderChips" />
                    <TextBlock x:Name="FolderHint" Style="{StaticResource Muted}" Margin="0,0,0,10"
                               Text="İşaretlediğin klasörler masaüstünde yoksa oluşturulur." />

                    <!-- Seçenekler önizlemenin üstünde: dolu bir masaüstünde de kaydırmadan görünsün (zorunlu karar). -->
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <RadioButton x:Name="MoveYes" GroupName="Move" Style="{StaticResource ChoiceCard}" Margin="0,0,4,8"
                                     AutomationProperties.AutomationId="Welcome.MoveYes" AutomationProperties.Name="Evet, dosyalarımı yerine taşı">
                            <StackPanel>
                                <TextBlock Style="{StaticResource CardHeader}" Text="Evet, dosyalarımı yerine taşı" />
                                <TextBlock x:Name="MoveYesText" Style="{StaticResource Muted}" Margin="0,2,0,0" />
                            </StackPanel>
                        </RadioButton>
                        <RadioButton x:Name="MoveNo" Grid.Column="1" GroupName="Move" Style="{StaticResource ChoiceCard}" Margin="4,0,0,8"
                                     AutomationProperties.AutomationId="Welcome.MoveNo" AutomationProperties.Name="Şimdilik hayır">
                            <StackPanel>
                                <TextBlock Style="{StaticResource CardHeader}" Text="Şimdilik hayır" />
                                <TextBlock x:Name="MoveNoText" Style="{StaticResource Muted}" Margin="0,2,0,0" />
                            </StackPanel>
                        </RadioButton>
                    </Grid>

                    <Border x:Name="PreviewBox" CornerRadius="8" BorderThickness="1" Padding="14,8" Margin="0,0,0,4"
                            BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <ui:SymbolIcon x:Name="PreviewIcon" FontSize="18" Margin="0,1,10,0" VerticalAlignment="Top" />
                            <StackPanel Grid.Column="1">
                                <TextBlock x:Name="PreviewText" TextWrapping="Wrap" Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                                           AutomationProperties.AutomationId="Welcome.Preview" />
                                <TextBlock x:Name="PreviewNote" Style="{StaticResource Muted}" Margin="0,4,0,0"
                                           AutomationProperties.AutomationId="Welcome.PreviewNote" />
                            </StackPanel>
                        </Grid>
                    </Border>
                </StackPanel>

                <!-- Adım 3: Araçlar ve başlangıç -->
                <StackPanel x:Name="Step3" Visibility="Collapsed">
                    <TextBlock Style="{StaticResource StepText}"
                               Text="İstediklerine tıkla. Sonra sürükleyerek yerini değiştirebilir, sağ tıklayarak ayarlayabilirsin." />
                    <WrapPanel x:Name="ToolTiles" />
                    <TextBlock Style="{StaticResource Muted}" Margin="0,0,0,14" Text="Hiçbirini seçmezsen masaüstüne araç eklenmez." />

                    <Border Style="{StaticResource Surface}" Padding="16,12">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <ui:SymbolIcon Symbol="Power24" FontSize="20" Margin="0,1,14,0" VerticalAlignment="Top"
                                           Foreground="{DynamicResource AccentTextFillColorPrimaryBrush}" />
                            <StackPanel Grid.Column="1">
                                <TextBlock x:Name="StartupTitle" Style="{StaticResource CardHeader}" />
                                <TextBlock Style="{StaticResource Muted}" Margin="0,2,0,0"
                                           Text="Tepside sessizce başlar; bölmelerin, saatin ve otomatik taşıma hep hazır olur." />
                                <TextBlock x:Name="StartupNote" Style="{StaticResource Muted}" Margin="0,4,0,0" Visibility="Collapsed"
                                           AutomationProperties.AutomationId="Welcome.StartupNote" />
                                <TextBlock x:Name="PortableNote" Style="{StaticResource Muted}" Margin="0,4,0,0" Visibility="Collapsed"
                                           Text="Taşınabilir sürüm: program bu klasörden başlatılır; klasörü taşırsan bu ayarı yeniden aç." />
                            </StackPanel>
                            <Grid Grid.Column="2" Margin="12,0,0,0" VerticalAlignment="Center">
                                <ui:ToggleSwitch x:Name="StartupToggle" AutomationProperties.AutomationId="Welcome.Startup" />
                                <!-- Store sürümü: görev kullanıcı/ilke yüzünden buradan değiştirilemiyorsa anahtarın yerine. -->
                                <ui:Button x:Name="StartupSettingsButton" Content="Başlangıç ayarlarını aç" Icon="{ui:SymbolIcon Open24}"
                                           Visibility="Collapsed" AutomationProperties.AutomationId="Welcome.StartupSettings" />
                            </Grid>
                        </Grid>
                    </Border>
                    <TextBlock x:Name="StartupTip" Style="{StaticResource Muted}" Margin="0,8,0,0" Visibility="Collapsed" />
                    <TextBlock x:Name="TrayInfo" Style="{StaticResource Muted}" Margin="0,14,0,0" />
                </StackPanel>
            </Grid>
        </ScrollViewer>

        <!-- Sabit alt şerit: [atla]  ● ○ ○  [Geri] [İleri]. -->
        <Border Grid.Row="3" BorderThickness="0,1,0,0" Padding="28,10,28,12"
                BorderBrush="{DynamicResource DividerStrokeColorDefaultBrush}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <ui:Button x:Name="SkipButton" MinWidth="96" AutomationProperties.AutomationId="Welcome.Skip" />
                <StackPanel x:Name="Dots" Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                    <Ellipse x:Name="Dot1" Width="8" Height="8" Margin="4,0" />
                    <Ellipse x:Name="Dot2" Width="8" Height="8" Margin="4,0" />
                    <Ellipse x:Name="Dot3" Width="8" Height="8" Margin="4,0" />
                </StackPanel>
                <TextBlock x:Name="ChooseHint" Grid.Column="1" Style="{StaticResource Muted}" Margin="12,0" TextAlignment="Center"
                           HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="Collapsed"
                           Text="Devam etmek için bir seçenek işaretle." AutomationProperties.AutomationId="Welcome.ChooseHint" />
                <ui:Button x:Name="BackButton" Grid.Column="2" Content="Geri" MinWidth="80" Margin="0,0,8,0" Visibility="Hidden"
                           AutomationProperties.AutomationId="Welcome.Back" />
                <ui:Button x:Name="NextButton" Grid.Column="3" Content="İleri" MinWidth="96" Appearance="Primary" IsDefault="True"
                           AutomationProperties.AutomationId="Welcome.Next" />
            </Grid>
        </Border>
    </Grid>
</ui:FluentWindow>
