<Page x:Class="Duzenleme.Views.DesktopPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
      Title="Masaüstü">
    <StackPanel Margin="40,8,40,40">
        <TextBlock Style="{StaticResource PageTitle}" Text="Masaüstü" />
        <TextBlock Style="{StaticResource PageSubtitle}"
                   Text="Windows'un varsayılan simgelerini aç/kapat, masaüstündeki her şeyi türüne göre süz ve klasörlerine şık simgeler ver." />

        <!-- Varsayılan sistem simgeleri -->
        <TextBlock Style="{StaticResource SectionHeader}" Margin="0,0,0,8" Text="Varsayılan masaüstü simgeleri" />
        <ItemsControl x:Name="SystemIcons">
            <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate>
                    <UniformGrid Columns="5" Margin="-5,0" />
                </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
                <DataTemplate>
                    <Border Style="{StaticResource Surface}" Margin="5,0" Padding="14,16">
                        <StackPanel>
                            <Image Source="{Binding Icon}" Width="40" Height="40" HorizontalAlignment="Left" Cursor="Hand"
                                   ToolTip="Aç" MouseLeftButtonUp="SystemIcon_Open" />
                            <TextBlock Text="{Binding Name}" FontWeight="SemiBold" Margin="0,10,0,0" TextTrimming="CharacterEllipsis"
                                       Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                            <TextBlock Text="{Binding Description}" Style="{StaticResource Muted}" Height="34" TextTrimming="CharacterEllipsis" />
                            <ui:ToggleSwitch IsChecked="{Binding Shown, Mode=TwoWay}" Margin="0,8,0,0" OnContent="Görünür" OffContent="Gizli" />
                        </StackPanel>
                    </Border>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>

        <WrapPanel Margin="0,14,0,0">
            <ui:Button x:Name="HideButton" Icon="{ui:SymbolIcon EyeOff24}" Content="Tüm simgeleri gizle" Click="ToggleDesktop_Click" Margin="0,0,8,8" />
            <ui:Button Icon="{ui:SymbolIcon ArrowClockwise24}" Content="Masaüstünü yenile" Click="Refresh_Click" Margin="0,0,8,8" />
            <ui:Button Icon="{ui:SymbolIcon Sparkle24}" Content="Tüm klasörlere önerilen simgeyi ver" Click="BeautifyAll_Click" Margin="0,0,8,8"
                       ToolTip="Özel simgesi olmayan masaüstü klasörlerine, adlarına uygun hazır simge atar" />
        </WrapPanel>
        <ui:InfoBar x:Name="Feedback" IsClosable="True" Margin="0,4,0,0" />

        <!-- Masaüstündeki öğeler -->
        <Grid Margin="0,24,0,8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="260" />
            </Grid.ColumnDefinitions>
            <TextBlock Style="{StaticResource SectionHeader}" Margin="0" VerticalAlignment="Center" Text="Masaüstündeki öğeler" />
            <ui:TextBox x:Name="Search" Grid.Column="1" PlaceholderText="Ara…" Icon="{ui:SymbolIcon Search24}" TextChanged="Search_TextChanged" />
        </Grid>
        <ItemsControl x:Name="Chips" Margin="0,0,0,10">
            <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate>
                    <WrapPanel />
                </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
        </ItemsControl>

        <ItemsControl x:Name="Items">
            <ItemsControl.ItemTemplate>
                <DataTemplate>
                    <Border Style="{StaticResource Surface}" Padding="12,8" Margin="0,0,0,5">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <Image Source="{Binding Icon}" Width="30" Height="30" Margin="0,0,12,0" />
                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                <TextBlock Text="{Binding Name}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"
                                           Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                                <TextBlock Text="{Binding Detail}" Style="{StaticResource Muted}" />
                            </StackPanel>
                            <Border Grid.Column="2" CornerRadius="8" Padding="8,2" Margin="8,0" VerticalAlignment="Center"
                                    Background="{DynamicResource ControlFillColorDefaultBrush}">
                                <TextBlock Text="{Binding Category}" FontSize="12" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                            </Border>
                            <StackPanel Grid.Column="3" Orientation="Horizontal">
                                <ui:Button Content="Simge" Icon="{ui:SymbolIcon Color24}" Margin="0,0,6,0" Visibility="{Binding IconVisibility}" Click="Icon_Click" />
                                <ui:Button Content="Düzenle" Icon="{ui:SymbolIcon FolderArrowRight24}" Margin="0,0,6,0" Visibility="{Binding OrganizeVisibility}"
                                           ToolTip="{Binding OrganizeTip}" Click="Organize_Click" />
                                <ui:Button Icon="{ui:SymbolIcon Open24}" ToolTip="Aç" Appearance="Transparent" Click="Open_Click" />
                                <ui:Button Icon="{ui:SymbolIcon FolderOpen24}" ToolTip="Klasörde göster" Appearance="Transparent" Click="Reveal_Click" />
                            </StackPanel>
                        </Grid>
                    </Border>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>
        <TextBlock x:Name="Empty" Style="{StaticResource Muted}" Text="Bu filtrede öğe yok." />

        <ui:CardControl Icon="{ui:SymbolIcon FolderAdd24}" Margin="0,20,0,0">
            <ui:CardControl.Header>
                <StackPanel>
                    <TextBlock Text="Yeni klasör oluşturunca simge öner" FontWeight="SemiBold" Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                    <TextBlock Style="{StaticResource Muted}" Text="Masaüstünde klasör açıp adını verdiğinde bildirim gelir; tıklayınca simge seçici açılır." />
                </StackPanel>
            </ui:CardControl.Header>
            <ui:ToggleSwitch x:Name="SuggestToggle" Click="SuggestToggle_Click" />
        </ui:CardControl>
    </StackPanel>
</Page>
