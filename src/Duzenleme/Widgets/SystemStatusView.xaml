<UserControl x:Class="Duzenleme.Widgets.SystemStatusView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- Sistem durumu: işlemci, bellek, disk, pil (ve seçmeli açık kalma süresi). Değer hep yazıyla da yazılır (yalnızca renkle
         değil); satırlar kodda kurulur. -->
    <Grid>
        <StackPanel Width="250" Margin="0,0,14,0">
            <!-- Adı (verildiyse; F2 yerinde düzenler). Ad yoksa satır yok. -->
            <Grid x:Name="NameBox" Margin="0,-2,8,8" Visibility="Collapsed">
                <TextBlock x:Name="NameText" FontSize="14" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"
                           FontFamily="Segoe UI Variable Text, Segoe UI" />
            </Grid>
            <StackPanel x:Name="Rows" AutomationProperties.AutomationId="SystemStatus.Rows" />
        </StackPanel>
        <Button x:Name="RemoveButton" Style="{StaticResource WidgetCloseButton}" HorizontalAlignment="Right" VerticalAlignment="Top"
                Margin="0,-10,-12,0" Click="RemoveWidget_Click" />
    </Grid>
</UserControl>
