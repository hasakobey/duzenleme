<UserControl x:Class="Duzenleme.Widgets.SystemStatusView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- Sistem durumu: işlemci, bellek, disk, pil (ve seçmeli açık kalma süresi). Değer hep yazıyla da yazılır (yalnızca renkle
         değil); satırlar kodda kurulur. -->
    <Grid>
        <StackPanel x:Name="Rows" Width="250" Margin="0,0,14,0" AutomationProperties.AutomationId="SystemStatus.Rows" />
        <Button x:Name="RemoveButton" Style="{StaticResource WidgetCloseButton}" HorizontalAlignment="Right" VerticalAlignment="Top"
                Margin="0,-10,-12,0" Click="RemoveWidget_Click" />
    </Grid>
</UserControl>
