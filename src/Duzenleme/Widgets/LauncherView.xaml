<UserControl x:Class="Duzenleme.Widgets.LauncherView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             xmlns:l="clr-namespace:Duzenleme.Localization"
             AllowDrop="True">
    <DockPanel>
        <!-- Başlığa çift tıklamak katlar/açar (menüde "Diğer ▸ Başlığa katla"). Tooltip yok: üstünde beklemek bir şey açmaz.
             Dar kutuda başlık okunsun diye sayı ve simge sırayla geçici gizlenir (FitHeader). -->
        <Grid x:Name="Header" DockPanel.Dock="Top" Background="Transparent">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <!-- Simge başlık yerinde düzenlenirken tıklanır ve simge seçiciyi açar (TitleEditor); normalde sürüklemeyi bozmaz. -->
            <Button x:Name="HeaderIconButton" Style="{StaticResource HeaderIconButton}">
                <ui:SymbolIcon x:Name="HeaderIcon" Symbol="AppsAddIn24" Filled="True" FontSize="20" />
            </Button>
            <TextBlock x:Name="TitleText" Grid.Column="1" FontSize="16" FontWeight="SemiBold" VerticalAlignment="Center"
                       TextTrimming="CharacterEllipsis" FontFamily="Segoe UI Variable Text, Segoe UI" />
            <!-- Sol pay: başlık kırpılacak kadar uzunken ("Shortcut box" + "12 items") sayı başlığa yapışmasın. -->
            <TextBlock x:Name="CountText" Grid.Column="2" FontSize="12" VerticalAlignment="Center" Margin="8,0,0,0" />
            <Button x:Name="RemoveButton" Grid.Column="3" Style="{StaticResource WidgetCloseButton}" Margin="6,0,-4,0" Click="RemoveWidget_Click" />
        </Grid>

        <DockPanel x:Name="Body">
            <!-- Sekmeler -->
            <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,12,0,8">
                <ItemsControl x:Name="TabStrip">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <WrapPanel />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                </ItemsControl>
                <Button x:Name="AddTab" Style="{StaticResource PillButton}" Padding="8,3" Margin="2,0,0,4" ToolTip="{l:T 'Sekme ekle'}"
                        AutomationProperties.Name="{l:T 'Sekme ekle'}"
                        Background="Transparent" VerticalAlignment="Top" Click="AddTab_Click">
                    <ui:SymbolIcon x:Name="AddTabIcon" Symbol="Add24" FontSize="14" />
                </Button>
            </StackPanel>

            <Grid>
                <ListBox x:Name="Items" Background="Transparent" BorderThickness="0" Padding="0"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled" SelectionMode="Single" VirtualizingPanel.ScrollUnit="Pixel"
                         ItemContainerStyle="{StaticResource TileContainer}" ItemTemplate="{StaticResource TileTemplate}" />

                <!-- Boş kutu: tek cümle, büyük "Uygulama ekle" düğmesi (Uygulama seç penceresi) ve altında küçük sürükleme ipucu. -->
                <StackPanel x:Name="EmptyState" VerticalAlignment="Center" HorizontalAlignment="Center" Visibility="Collapsed">
                    <TextBlock x:Name="EmptyText" FontSize="13" TextAlignment="Center" TextWrapping="Wrap" MaxWidth="260" />
                    <Button x:Name="EmptyAdd" Style="{StaticResource WidgetTextButton}" Height="32" Padding="14,0,16,1" Margin="0,10,0,0"
                            HorizontalAlignment="Center" AutomationProperties.AutomationId="Launcher.AddApp"
                            AutomationProperties.Name="{l:T 'Uygulama ekle'}" Click="AddApp_Click">
                        <StackPanel Orientation="Horizontal">
                            <ui:SymbolIcon x:Name="EmptyAddIcon" Symbol="Add24" FontSize="14" Margin="0,0,6,0" VerticalAlignment="Center" />
                            <TextBlock Text="{l:T 'Uygulama ekle'}" FontSize="13" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>
                    <TextBlock x:Name="EmptyHint" FontSize="12" TextAlignment="Center" Margin="0,8,0,0" Text="{l:T 'ya da buraya sürükle'}" />
                </StackPanel>

                <Border x:Name="DropOverlay" CornerRadius="12" BorderThickness="2" Visibility="Collapsed" IsHitTestVisible="False">
                    <TextBlock x:Name="DropText" Text="{l:T 'Bırak, kısayol olarak eklensin'}" HorizontalAlignment="Center" VerticalAlignment="Center"
                               FontSize="14" FontWeight="SemiBold" TextWrapping="Wrap" TextAlignment="Center" Margin="8,0" />
                </Border>
            </Grid>
        </DockPanel>
    </DockPanel>
</UserControl>
