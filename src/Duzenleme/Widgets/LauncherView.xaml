<UserControl x:Class="Duzenleme.Widgets.LauncherView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             AllowDrop="True">
    <DockPanel>
        <Grid x:Name="Header" DockPanel.Dock="Top" Background="Transparent" ToolTip="Katlamak için çift tıkla">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <ui:SymbolIcon x:Name="HeaderIcon" Symbol="Apps24" Filled="True" FontSize="20" Margin="0,0,10,0" VerticalAlignment="Center" />
            <TextBlock x:Name="TitleText" Grid.Column="1" FontSize="16" FontWeight="SemiBold" VerticalAlignment="Center"
                       TextTrimming="CharacterEllipsis" FontFamily="Segoe UI Variable Display, Segoe UI" />
            <TextBlock x:Name="CountText" Grid.Column="2" FontSize="12" VerticalAlignment="Center" />
        </Grid>

        <DockPanel x:Name="Body">
            <!-- Sekmeler -->
            <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,12,0,8">
                <ItemsControl x:Name="TabStrip">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <WrapPanel />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                </ItemsControl>
                <Border x:Name="AddTab" CornerRadius="10" Padding="8,3" Margin="2,0,0,4" Cursor="Hand" ToolTip="Sekme ekle"
                        Background="Transparent" VerticalAlignment="Top">
                    <ui:SymbolIcon x:Name="AddTabIcon" Symbol="Add16" FontSize="14" />
                </Border>
            </StackPanel>

            <Grid>
                <ListBox x:Name="Items" Background="Transparent" BorderThickness="0" Padding="0"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled" SelectionMode="Single"
                         ItemContainerStyle="{StaticResource TileContainer}" ItemTemplate="{StaticResource TileTemplate}"
                         ItemsPanel="{StaticResource TileWrapPanel}" />

                <StackPanel x:Name="EmptyState" VerticalAlignment="Center" HorizontalAlignment="Center" Visibility="Collapsed">
                    <ui:SymbolIcon x:Name="EmptyIcon" Symbol="AppsAddIn24" FontSize="30" HorizontalAlignment="Center" Opacity="0.7" />
                    <TextBlock x:Name="EmptyText" FontSize="13" TextAlignment="Center" TextWrapping="Wrap" Margin="0,8,0,0" MaxWidth="260"
                               Text="Uygulama, kısayol, dosya ya da klasörü buraya sürükle. Tek tıkla açılır." />
                </StackPanel>

                <Border x:Name="DropOverlay" CornerRadius="12" BorderThickness="2" Visibility="Collapsed" IsHitTestVisible="False">
                    <TextBlock Text="Bırakın, kısayol olarak eklensin" HorizontalAlignment="Center" VerticalAlignment="Center"
                               FontSize="14" FontWeight="SemiBold" />
                </Border>
            </Grid>
        </DockPanel>
    </DockPanel>
</UserControl>
