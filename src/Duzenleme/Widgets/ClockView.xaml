<UserControl x:Class="Duzenleme.Widgets.ClockView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid>
        <StackPanel MinWidth="230">
            <StackPanel Orientation="Horizontal">
                <TextBlock x:Name="TimeText" Text="00:00" FontSize="72" FontWeight="Light"
                           FontFamily="Segoe UI Variable Display, Segoe UI" />
                <TextBlock x:Name="SecondsText" Text="00" FontSize="26" FontWeight="Normal"
                           FontFamily="Segoe UI Variable Display, Segoe UI"
                           VerticalAlignment="Bottom" Margin="6,0,0,15" />
            </StackPanel>
            <StackPanel x:Name="GreetingRow" Orientation="Horizontal" Margin="3,-4,0,0">
                <Ellipse x:Name="Dot" Width="7" Height="7" VerticalAlignment="Center" Margin="0,1,8,0" />
                <TextBlock x:Name="GreetingText" FontSize="15" FontWeight="SemiBold"
                           FontFamily="Segoe UI Variable Text, Segoe UI" />
            </StackPanel>
        </StackPanel>
        <!-- Sağ üst köşede hep yerinde, sönük: rakamların üstündeki boşlukta durur, fareyle belirip kaybolmaz. -->
        <Button x:Name="RemoveButton" Style="{StaticResource WidgetCloseButton}" HorizontalAlignment="Right" VerticalAlignment="Top"
                Margin="0,-10,-12,0" Click="RemoveWidget_Click" />
    </Grid>
</UserControl>
