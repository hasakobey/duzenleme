<UserControl x:Class="Duzenleme.Widgets.DateView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <StackPanel MinWidth="250">
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <TextBlock x:Name="DayText" Text="1" FontSize="64" FontWeight="SemiBold"
                       FontFamily="Segoe UI Variable Display, Segoe UI" Margin="0,-8,14,0" />
            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                <TextBlock x:Name="MonthText" FontSize="22" FontWeight="SemiBold"
                           FontFamily="Segoe UI Variable Display, Segoe UI" />
                <TextBlock x:Name="SubText" FontSize="14" Margin="0,2,0,0"
                           FontFamily="Segoe UI Variable Text, Segoe UI" />
            </StackPanel>
        </Grid>
        <UniformGrid x:Name="Week" Columns="7" Rows="1" Margin="0,14,0,0" />
    </StackPanel>
</UserControl>
