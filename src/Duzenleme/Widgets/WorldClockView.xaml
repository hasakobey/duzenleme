<UserControl x:Class="Duzenleme.Widgets.WorldClockView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:l="clr-namespace:Duzenleme.Localization">
    <!-- Dünya saati: şehir başına bir satır (ad, gün/saat farkı, saat). Satırlar kodda kurulur; satıra sağ tık o satırın
         menüsünü (adını değiştir, taşı, kaldır) açar, başka yere sağ tık widget menüsünü. -->
    <Grid>
        <StackPanel MinWidth="230" Margin="0,0,14,0">
            <StackPanel x:Name="Rows" AutomationProperties.AutomationId="WorldClock.Rows" />
            <StackPanel x:Name="EmptyState" Visibility="Collapsed" Margin="0,4,0,4">
                <TextBlock x:Name="EmptyText" FontSize="13" TextWrapping="Wrap" MaxWidth="230" Margin="0,0,0,10"
                           Text="{l:T 'Henüz şehir yok.'}" />
                <Button x:Name="AddButton" Style="{StaticResource WidgetTextButton}" HorizontalAlignment="Left"
                        Content="{l:T 'Şehir ekle…'}" Click="Add_Click" AutomationProperties.AutomationId="WorldClock.Add" />
            </StackPanel>
        </StackPanel>
        <Button x:Name="RemoveButton" Style="{StaticResource WidgetCloseButton}" HorizontalAlignment="Right" VerticalAlignment="Top"
                Margin="0,-10,-12,0" Click="RemoveWidget_Click" />
    </Grid>
</UserControl>
