<UserControl x:Class="Duzenleme.Widgets.RecycleBinView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:l="clr-namespace:Duzenleme.Localization"
             AllowDrop="True">
    <!-- Geri Dönüşüm Kutusu: büyük simge (dolu/boş), öğe sayısı ve boyut, hep yerinde "Boşalt…" (boşken devre dışı).
         Simgeye çift tık kutuyu açar; üstüne bırakılan dosyalar kutuya gider (geri alınabilir). -->
    <Grid>
        <Grid MinWidth="230" Margin="0,0,16,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Image x:Name="BinIcon" Width="56" Height="56" Margin="0,0,14,0" VerticalAlignment="Center"
                   RenderOptions.BitmapScalingMode="HighQuality" Cursor="Hand"
                   AutomationProperties.AutomationId="RecycleBin.Icon" />
            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                <!-- Başlık satırı: F2 / "Yeniden adlandır" yazının yerinde düzenler (TitleEditor). -->
                <Grid x:Name="TitleRow">
                    <TextBlock x:Name="TitleText" FontSize="15" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"
                               FontFamily="Segoe UI Variable Text, Segoe UI" />
                </Grid>
                <TextBlock x:Name="SizeText" FontSize="13" Margin="0,2,0,0" FontFamily="Segoe UI Variable Text, Segoe UI"
                           AutomationProperties.AutomationId="RecycleBin.Size" />
                <Button x:Name="EmptyButton" Style="{StaticResource WidgetTextButton}" HorizontalAlignment="Left" Margin="0,8,0,0"
                        Content="{l:T 'Boşalt…'}" Click="Empty_Click" AutomationProperties.AutomationId="RecycleBin.Empty" />
            </StackPanel>
        </Grid>
        <Border x:Name="DropOverlay" CornerRadius="12" BorderThickness="2" Margin="-8,-6,-8,-6" Visibility="Collapsed" IsHitTestVisible="False">
            <TextBlock x:Name="DropText" HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="13" FontWeight="SemiBold"
                       TextWrapping="Wrap" TextAlignment="Center" Text="{l:T 'Bırakın, Geri Dönüşüm Kutusu\'na gitsin'}" />
        </Border>
        <Button x:Name="RemoveButton" Style="{StaticResource WidgetCloseButton}" HorizontalAlignment="Right" VerticalAlignment="Top"
                Margin="0,-10,-12,0" Click="RemoveWidget_Click" />
    </Grid>
</UserControl>
