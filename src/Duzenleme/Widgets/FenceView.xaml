<UserControl x:Class="Duzenleme.Widgets.FenceView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             AllowDrop="True">
    <DockPanel>
        <Grid DockPanel.Dock="Top" Margin="0,0,0,10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <ui:SymbolIcon x:Name="HeaderIcon" Symbol="Folder24" Filled="True" FontSize="20" Margin="0,0,10,0" VerticalAlignment="Center" />
            <TextBlock x:Name="TitleText" Grid.Column="1" FontSize="16" FontWeight="SemiBold" VerticalAlignment="Center"
                       TextTrimming="CharacterEllipsis" FontFamily="Segoe UI Variable Display, Segoe UI" />
            <Border x:Name="CountBadge" Grid.Column="2" CornerRadius="9" Padding="8,1,8,2" Margin="8,0,6,0" VerticalAlignment="Center">
                <TextBlock x:Name="CountText" FontSize="12" FontWeight="SemiBold" />
            </Border>
            <Button x:Name="OpenButton" Grid.Column="3" Padding="6" Background="Transparent" BorderThickness="0"
                    ToolTip="Klasörü aç" Click="OpenFolder_Click" Cursor="Hand">
                <ui:SymbolIcon Symbol="Open24" FontSize="16" />
            </Button>
        </Grid>
        <Rectangle x:Name="Divider" DockPanel.Dock="Top" Height="1" Margin="0,0,0,8" Opacity="0.6" />

        <Grid>
            <ListBox x:Name="Items" Background="Transparent" BorderThickness="0" Padding="0"
                     ScrollViewer.HorizontalScrollBarVisibility="Disabled" SelectionMode="Single"
                     MouseDoubleClick="Items_MouseDoubleClick">
                <ListBox.ItemsPanel>
                    <ItemsPanelTemplate>
                        <WrapPanel />
                    </ItemsPanelTemplate>
                </ListBox.ItemsPanel>
                <ListBox.ItemContainerStyle>
                    <Style TargetType="ListBoxItem">
                        <Setter Property="Padding" Value="0" />
                        <Setter Property="Margin" Value="0" />
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="ListBoxItem">
                                    <Border x:Name="Bg" CornerRadius="10" Background="Transparent" Padding="4,8,4,6" Margin="2">
                                        <ContentPresenter />
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="Bg" Property="Background" Value="#26FFFFFF" />
                                        </Trigger>
                                        <Trigger Property="IsSelected" Value="True">
                                            <Setter TargetName="Bg" Property="Background" Value="#40A78BFA" />
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                    </Style>
                </ListBox.ItemContainerStyle>
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <StackPanel Width="78" ToolTip="{Binding Name}">
                            <Image Source="{Binding Icon}" Width="36" Height="36" HorizontalAlignment="Center" />
                            <TextBlock Text="{Binding Name}" FontSize="11.5" TextAlignment="Center" TextWrapping="Wrap"
                                       TextTrimming="CharacterEllipsis" MaxHeight="32" Margin="0,5,0,0"
                                       Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=UserControl}}" />
                        </StackPanel>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>

            <StackPanel x:Name="EmptyState" VerticalAlignment="Center" HorizontalAlignment="Center" Visibility="Collapsed">
                <ui:SymbolIcon x:Name="EmptyIcon" Symbol="ArrowDownload24" FontSize="30" HorizontalAlignment="Center" Opacity="0.7" />
                <TextBlock x:Name="EmptyText" FontSize="13" TextAlignment="Center" TextWrapping="Wrap" Margin="0,8,0,0" MaxWidth="240" />
                <Button x:Name="CreateFolderButton" Content="Klasörü oluştur" HorizontalAlignment="Center" Margin="0,12,0,0"
                        Click="CreateFolder_Click" Visibility="Collapsed" />
            </StackPanel>

            <Border x:Name="DropOverlay" CornerRadius="12" BorderThickness="2" Visibility="Collapsed" IsHitTestVisible="False">
                <TextBlock Text="Bırakın, klasöre taşınsın" HorizontalAlignment="Center" VerticalAlignment="Center"
                           FontSize="14" FontWeight="SemiBold" />
            </Border>
        </Grid>
    </DockPanel>
</UserControl>
