<UserControl x:Class="Duzenleme.Widgets.FenceView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             xmlns:l="clr-namespace:Duzenleme.Localization"
             AllowDrop="True">
    <DockPanel>
        <!-- Başlığa çift tıklamak katlar/açar (menüde "Diğer ▸ Başlığa katla"). Tooltip yok: üstünde beklemek bir şey açmaz.
             Dar bölmede başlık okunsun diye sayı, "Klasörü aç", arama ve simge sırayla geçici gizlenir (FitHeader).
             Başlık 16 px'te "Variable Text" (küçük boyut için çizilmiş; "Display" 20 pt üstü içindir). -->
        <Grid x:Name="Header" DockPanel.Dock="Top" Background="Transparent">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <!-- Simge başlık yerinde düzenlenirken tıklanır ve simge seçiciyi açar (TitleEditor); normalde sürüklemeyi bozmaz. -->
            <Button x:Name="HeaderIconButton" Style="{StaticResource HeaderIconButton}">
                <ui:SymbolIcon x:Name="HeaderIcon" Symbol="Folder24" Filled="True" FontSize="20" />
            </Button>
            <TextBlock x:Name="TitleText" Grid.Column="1" FontSize="16" FontWeight="SemiBold" VerticalAlignment="Center"
                       TextTrimming="CharacterEllipsis" FontFamily="Segoe UI Variable Text, Segoe UI" />
            <Border x:Name="CountBadge" Grid.Column="2" CornerRadius="9" Padding="8,1,8,2" Margin="8,0,4,0" VerticalAlignment="Center">
                <TextBlock x:Name="CountText" FontSize="12" FontWeight="SemiBold" />
            </Border>
            <Button x:Name="SearchButton" Grid.Column="3" Padding="6" Background="Transparent" BorderThickness="0"
                    ToolTip="Bu bölmede ve alt klasörlerinde ara" Click="Search_Click" Cursor="Hand">
                <ui:SymbolIcon x:Name="SearchIcon" FontSize="16" />
            </Button>
            <Button x:Name="OpenButton" Grid.Column="4" Padding="6" Background="Transparent" BorderThickness="0"
                    ToolTip="Klasörü aç" Click="OpenFolder_Click" Cursor="Hand">
                <ui:SymbolIcon x:Name="OpenIcon" Symbol="Open24" FontSize="16" />
            </Button>
            <Button x:Name="RemoveButton" Grid.Column="5" Style="{StaticResource WidgetCloseButton}" Click="RemoveWidget_Click" />
        </Grid>

        <DockPanel x:Name="Body">
            <Rectangle x:Name="Divider" DockPanel.Dock="Top" Height="1" Margin="0,8,0,8" Opacity="0.6" />

            <!-- Arama: yazdıkça süzer, alt klasörlerde de arar; Enter açar, Shift+Enter klasörde gösterir, Esc kapatır. -->
            <Border x:Name="SearchBar" DockPanel.Dock="Top" CornerRadius="9" Padding="8,4" Margin="0,0,0,8"
                    BorderThickness="1" Visibility="Collapsed">
                <DockPanel>
                    <ui:SymbolIcon x:Name="SearchBarIcon" FontSize="14" Margin="0,0,6,0" VerticalAlignment="Center" />
                    <TextBox x:Name="SearchBox" Background="Transparent" BorderThickness="0" Padding="0" FontSize="13" FocusVisualStyle="{x:Null}"
                             VerticalContentAlignment="Center">
                        <TextBox.Template>
                            <ControlTemplate TargetType="TextBox">
                                <Grid>
                                    <ScrollViewer x:Name="PART_ContentHost" Focusable="False" VerticalAlignment="Center" />
                                    <TextBlock x:Name="Placeholder" Text="Ara…  (Enter: aç)" IsHitTestVisible="False"
                                               Opacity="0.5" Visibility="Collapsed" Margin="2,0,0,0" VerticalAlignment="Center" />
                                </Grid>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="Text" Value="">
                                        <Setter TargetName="Placeholder" Property="Visibility" Value="Visible" />
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </TextBox.Template>
                    </TextBox>
                </DockPanel>
            </Border>

            <!-- Büyük klasörde (İndirilenler gibi) ilk 300 öğe gösterilir; kalanı için klasör açılır (2.1 P6). -->
            <Button x:Name="MoreButton" DockPanel.Dock="Bottom" Style="{StaticResource WidgetTextButton}" HorizontalAlignment="Left"
                    Margin="0,6,0,0" Visibility="Collapsed" Click="OpenFolder_Click" AutomationProperties.AutomationId="Fence.More" />

            <Grid>
                <ListBox x:Name="Items" Background="Transparent" BorderThickness="0" Padding="0"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled" SelectionMode="Single" VirtualizingPanel.ScrollUnit="Pixel"
                         ItemContainerStyle="{StaticResource TileContainer}" ItemTemplate="{StaticResource TileTemplate}"
                         MouseDoubleClick="Items_MouseDoubleClick" />

                <StackPanel x:Name="EmptyState" VerticalAlignment="Center" HorizontalAlignment="Center" Visibility="Collapsed">
                    <ui:SymbolIcon x:Name="EmptyIcon" Symbol="ArrowDownload24" FontSize="30" HorizontalAlignment="Center" Opacity="0.7" />
                    <TextBlock x:Name="EmptyText" FontSize="13" TextAlignment="Center" TextWrapping="Wrap" Margin="0,8,0,0" MaxWidth="240" />
                    <Button x:Name="CreateFolderButton" Content="Klasörü oluştur" HorizontalAlignment="Center" Margin="0,12,0,0"
                            Click="CreateFolder_Click" Visibility="Collapsed" />
                    <!-- Klasör portalının klasörü bulunamadı (silindi, sürücü takılı değil): başka klasör seçilir. -->
                    <Button x:Name="PickFolderButton" Content="{l:T 'Başka klasör seç…'}" HorizontalAlignment="Center" Margin="0,12,0,0"
                            Click="PickFolder_Click" Visibility="Collapsed" AutomationProperties.AutomationId="Fence.PickFolder" />
                </StackPanel>

                <Border x:Name="DropOverlay" CornerRadius="12" BorderThickness="2" Visibility="Collapsed" IsHitTestVisible="False">
                    <TextBlock Text="Bırakın, klasöre taşınsın" HorizontalAlignment="Center" VerticalAlignment="Center"
                               FontSize="14" FontWeight="SemiBold" />
                </Border>
            </Grid>
        </DockPanel>
    </DockPanel>
</UserControl>
