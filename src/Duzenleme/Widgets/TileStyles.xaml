<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:l="clr-namespace:Duzenleme.Localization">

    <!--
        "Widget'ı kaldır" düğmesi (×). Tüm widget'larda hep yerinde durur ve sönüktür: fare widget'a gelince hiçbir şey
        belirip kaybolmaz, başlıktaki düğmeler kaymaz (bölme, kutu, notta başlıkta; saat ve tarihte sağ üst köşede).
        Yalnızca düğmenin kendisinin üstüne gelince kırmızılaşır. Menüde "Görünüm ▸ Göster ▸ Kaldır düğmesi (×)" ile
        kapatılır; "Konumu kilitle" de gizler. Renk kodda (ApplyPalette) Foreground ile verilir.
    -->
    <Style x:Key="WidgetCloseButton" TargetType="Button">
        <Setter Property="Focusable" Value="False" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Width" Value="26" />
        <Setter Property="Height" Value="26" />
        <Setter Property="Margin" Value="2,0,-4,0" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="ToolTip" Value="Widget'ı kaldır (geri getirilebilir)" />
        <Setter Property="AutomationProperties.Name" Value="Widget'ı kaldır" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Bg" CornerRadius="13" Background="Transparent">
                        <TextBlock x:Name="Glyph" Text="&#xE711;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="11"
                                   Foreground="{TemplateBinding Foreground}" Opacity="0.55"
                                   HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bg" Property="Background" Value="#E5484D" />
                            <Setter TargetName="Glyph" Property="Foreground" Value="White" />
                            <Setter TargetName="Glyph" Property="Opacity" Value="1" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Öğeyi kaldırmak için düğme yok: sağ tık → "Widget'tan kaldır" (fare öğelerin üstünde gezerken bir şey belirip kaybolmasın). -->
    <Style x:Key="TileContainer" TargetType="ListBoxItem">
        <Setter Property="Padding" Value="0" />
        <Setter Property="Margin" Value="0" />
        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        <!-- Sağa yaslı panel sağdan sola dizer; öğenin kendisi (metin, simge) aynalanmasın. -->
        <Setter Property="FlowDirection" Value="LeftToRight" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ListBoxItem">
                    <Border x:Name="Bg" CornerRadius="10" Background="Transparent" Padding="{Binding Pad}" Margin="1">
                        <ContentPresenter />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bg" Property="Background" Value="#26FFFFFF" />
                        </Trigger>
                        <Trigger Property="IsSelected" Value="True">
                            <Setter TargetName="Bg" Property="Background" Value="#40A78BFA" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Widget içi düğmeler (sekmeler, "+"): gerçek Button, böylece tıklama güvenilir; görünümü şablonla sade tutulur. -->
    <Style x:Key="PillButton" TargetType="Button">
        <Setter Property="Focusable" Value="False" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Padding" Value="11,3,11,4" />
        <Setter Property="Margin" Value="0,0,4,4" />
        <Setter Property="Background" Value="#1EFFFFFF" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Bg" CornerRadius="10" Background="{TemplateBinding Background}" Padding="{TemplateBinding Padding}">
                        <ContentPresenter VerticalAlignment="Center" HorizontalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bg" Property="Opacity" Value="0.85" />
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="Bg" Property="Opacity" Value="0.7" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!--
        Yapılacaklar satırlarının ve "Yeni madde ekle…" kutusunun yazı alanı: kenarlıksız, saydam, notun metni gibi.
        WPF-UI'ın örtük TextBox stilini (kenarlık, silme düğmesi, odak çizgisi) ezer. Yer tutucu metin Tag'dan gelir.
        İçerik alanı Decorator: satır kaydırma çubuğu taşımaz (liste bütün olarak kayar), 200 satırlık liste de hızlı açılır.
        Yazı rengi, imleç ve seçim rengi kodda (ApplyPalette) verilir.
    -->
    <Style x:Key="InlineTextBox" TargetType="TextBox">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="FontSize" Value="15" />
        <Setter Property="FontFamily" Value="Segoe UI Variable Text, Segoe UI" />
        <Setter Property="SpellCheck.IsEnabled" Value="False" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="TextBox">
                    <Grid Background="Transparent">
                        <Decorator x:Name="PART_ContentHost" />
                        <TextBlock x:Name="Placeholder" Text="{Binding Tag, RelativeSource={RelativeSource TemplatedParent}}"
                                   IsHitTestVisible="False" Opacity="0.45" Visibility="Collapsed" Margin="2,0,0,0"
                                   TextTrimming="CharacterEllipsis" />
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="Text" Value="">
                            <Setter TargetName="Placeholder" Property="Visibility" Value="Visible" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!--
        Başlık simgesi (bölme, kutu). Normalde tıklanmaz (IsHitTestVisible=False): başlıktan sürükleme bozulmasın. Başlık
        yerinde düzenlenirken (yeni eklenen widget, F2) düğme olur ve simge seçiciyi açar; görünümü kodda verilir
        (TitleEditor), fareyle belirip kaybolan bir şey yoktur. Negatif kenar boşluğu dolgu ve kenarlığı dengeler: simge
        eski yerinde, başlığın yerleşimi aynı. UI Automation "Invoke" her zaman seçiciyi açar.
    -->
    <Style x:Key="HeaderIconButton" TargetType="Button">
        <Setter Property="Focusable" Value="False" />
        <Setter Property="IsHitTestVisible" Value="False" />
        <Setter Property="Padding" Value="3" />
        <Setter Property="Margin" Value="-4,-4,6,-4" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderBrush" Value="Transparent" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="AutomationProperties.Name" Value="{l:T 'Simgeyi değiştir'}" />
        <Setter Property="AutomationProperties.AutomationId" Value="Widget.IconButton" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border CornerRadius="6" BorderThickness="1" Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}" Padding="{TemplateBinding Padding}">
                        <ContentPresenter />
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!--
        Başlığın yerinde düzenlenmesi (F2, yeni eklenen widget): başlıkla aynı yazı, kenarlıklı kutunun içinde (kenarlık
        kodda, vurgu renginde). Uzun başlıkta imleç görünür kalsın diye içerik yatay kayar (çubuk görünmez).
    -->
    <Style x:Key="TitleEditorBox" TargetType="TextBox">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="SpellCheck.IsEnabled" Value="False" />
        <Setter Property="AcceptsReturn" Value="False" />
        <Setter Property="AcceptsTab" Value="False" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="TextBox">
                    <Grid Background="Transparent">
                        <ScrollViewer x:Name="PART_ContentHost" Focusable="False" Padding="0"
                                      HorizontalScrollBarVisibility="Hidden" VerticalScrollBarVisibility="Disabled" />
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!--
        Kutucuğun adını yerinde düzenleme (F2): Gezgin'deki gibi kenarlıklı, opak kutu; simge görünümünde kutucuk genişliğinde
        alt satıra geçer. Renkler kodda (TileRename) görünümün paletinden verilir.
    -->
    <Style x:Key="TileRenameBox" TargetType="TextBox">
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Padding" Value="2,1" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="SpellCheck.IsEnabled" Value="False" />
        <Setter Property="AcceptsReturn" Value="False" />
        <Setter Property="AcceptsTab" Value="False" />
        <Setter Property="AutomationProperties.AutomationId" Value="Tile.RenameBox" />
        <Setter Property="AutomationProperties.Name" Value="{l:T 'Yeni ad'}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="TextBox">
                    <Border CornerRadius="4" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}" Padding="{TemplateBinding Padding}">
                        <ScrollViewer x:Name="PART_ContentHost" Focusable="False" Padding="0"
                                      HorizontalScrollBarVisibility="Hidden" VerticalScrollBarVisibility="Hidden" />
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!--
        Yapılacaklar onay kutusu: 16×16, yuvarlatılmış köşe, 1,5 px kenar. Renkler kodda verilir:
        Foreground = kenar, Tag = işaretliyken zemin ve kenar (vurgu rengi), Background = işaretliyken ✓ rengi.
        Geçiş animasyonu yok: işaret tıklanınca anında görünür.
    -->
    <Style x:Key="ChecklistBox" TargetType="CheckBox">
        <Setter Property="Focusable" Value="False" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Width" Value="16" />
        <Setter Property="Height" Value="16" />
        <Setter Property="VerticalAlignment" Value="Top" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="CheckBox">
                    <Border x:Name="Box" CornerRadius="4" BorderThickness="1.5" Background="Transparent"
                            BorderBrush="{TemplateBinding Foreground}">
                        <TextBlock x:Name="Mark" Text="&#xE73E;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="10"
                                   Foreground="{TemplateBinding Background}" Visibility="Collapsed"
                                   HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="Box" Property="Background" Value="{Binding Tag, RelativeSource={RelativeSource TemplatedParent}}" />
                            <Setter TargetName="Box" Property="BorderBrush" Value="{Binding Tag, RelativeSource={RelativeSource TemplatedParent}}" />
                            <Setter TargetName="Mark" Property="Visibility" Value="Visible" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!--
        Simge ekrandaki gerçek piksel boyutunda gelir (TileItem.UpdateIconSize) ve 1:1 çizilir; HighQuality yalnızca simge
        tam boyutta alınamadığında (widget ölçeği, yedek yol) devreye girer. Ad, kart opaksa ClearType ile çizilir: kaydırılan
        listenin kırpması ClearType'ı kapattığı için ipucu yazının kendisine görünümden (WidgetWindow.ApplyStyle) verilir;
        bulunamayan öğe soluk (yarı saydam katman) olduğundan onda gri tonlama kalır.
    -->
    <DataTemplate x:Key="TileTemplate">
        <StackPanel Orientation="{Binding Orientation}" Width="{Binding TileWidth}" ToolTip="{Binding Tooltip}" Opacity="{Binding Dim}">
            <Image Source="{Binding Icon}" Width="{Binding IconPx}" Height="{Binding IconPx}"
                   HorizontalAlignment="{Binding IconAlign}" VerticalAlignment="Center"
                   RenderOptions.BitmapScalingMode="HighQuality" />
            <TextBlock x:Name="Label" Text="{Binding Name}" FontSize="{Binding LabelFont}" Visibility="{Binding LabelVisibility}"
                       TextAlignment="{Binding TextAlign}" TextWrapping="{Binding Wrap}"
                       TextTrimming="CharacterEllipsis" MaxHeight="{Binding TextMaxHeight}" Margin="{Binding TextMargin}"
                       VerticalAlignment="Center"
                       Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=UserControl}}"
                       RenderOptions.ClearTypeHint="{Binding (RenderOptions.ClearTypeHint), RelativeSource={RelativeSource AncestorType=UserControl}}" />
        </StackPanel>
        <DataTemplate.Triggers>
            <DataTrigger Binding="{Binding Missing}" Value="True">
                <Setter TargetName="Label" Property="RenderOptions.ClearTypeHint" Value="Auto" />
            </DataTrigger>
        </DataTemplate.Triggers>
    </DataTemplate>
</ResourceDictionary>
