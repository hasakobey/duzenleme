<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Style x:Key="TileContainer" TargetType="ListBoxItem">
        <Setter Property="Padding" Value="0" />
        <Setter Property="Margin" Value="0" />
        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        <!-- Sağa yaslı panel sağdan sola dizer; öğenin kendisi (metin, simge) aynalanmasın. -->
        <Setter Property="FlowDirection" Value="LeftToRight" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ListBoxItem">
                    <Border x:Name="Bg" CornerRadius="10" Background="Transparent" Padding="{Binding Pad}" Margin="1">
                        <ContentPresenter />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bg" Property="Background" Value="#26FFFFFF" />
                        </Trigger>
                        <Trigger Property="IsSelected" Value="True">
                            <Setter TargetName="Bg" Property="Background" Value="#40A78BFA" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Widget içi düğmeler (sekmeler, "+"): gerçek Button, böylece tıklama güvenilir; görünümü şablonla sade tutulur. -->
    <Style x:Key="PillButton" TargetType="Button">
        <Setter Property="Focusable" Value="False" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Padding" Value="11,3,11,4" />
        <Setter Property="Margin" Value="0,0,4,4" />
        <Setter Property="Background" Value="#1EFFFFFF" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Bg" CornerRadius="10" Background="{TemplateBinding Background}" Padding="{TemplateBinding Padding}">
                        <ContentPresenter VerticalAlignment="Center" HorizontalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bg" Property="Opacity" Value="0.85" />
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="Bg" Property="Opacity" Value="0.7" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <DataTemplate x:Key="TileTemplate">
        <StackPanel Orientation="{Binding Orientation}" Width="{Binding TileWidth}" ToolTip="{Binding Tooltip}" Opacity="{Binding Dim}">
            <Image Source="{Binding Icon}" Width="{Binding IconPx}" Height="{Binding IconPx}"
                   HorizontalAlignment="{Binding IconAlign}" VerticalAlignment="Center"
                   RenderOptions.BitmapScalingMode="HighQuality" />
            <TextBlock Text="{Binding Name}" FontSize="{Binding LabelFont}" Visibility="{Binding LabelVisibility}"
                       TextAlignment="{Binding TextAlign}" TextWrapping="{Binding Wrap}"
                       TextTrimming="CharacterEllipsis" MaxHeight="{Binding TextMaxHeight}" Margin="{Binding TextMargin}"
                       VerticalAlignment="Center"
                       Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=UserControl}}" />
        </StackPanel>
    </DataTemplate>
</ResourceDictionary>
