<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <ItemsPanelTemplate x:Key="TileWrapPanel">
        <WrapPanel />
    </ItemsPanelTemplate>
    <ItemsPanelTemplate x:Key="TileStackPanel">
        <StackPanel />
    </ItemsPanelTemplate>

    <Style x:Key="TileContainer" TargetType="ListBoxItem">
        <Setter Property="Padding" Value="0" />
        <Setter Property="Margin" Value="0" />
        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ListBoxItem">
                    <Border x:Name="Bg" CornerRadius="10" Background="Transparent" Padding="6,7,6,6" Margin="1">
                        <ContentPresenter />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bg" Property="Background" Value="#26FFFFFF" />
                        </Trigger>
                        <Trigger Property="IsSelected" Value="True">
                            <Setter TargetName="Bg" Property="Background" Value="#40A78BFA" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <DataTemplate x:Key="TileTemplate">
        <StackPanel Orientation="{Binding Orientation}" Width="{Binding TileWidth}" ToolTip="{Binding Tooltip}" Opacity="{Binding Dim}">
            <Image Source="{Binding Icon}" Width="{Binding IconPx}" Height="{Binding IconPx}"
                   HorizontalAlignment="{Binding IconAlign}" VerticalAlignment="Center"
                   RenderOptions.BitmapScalingMode="HighQuality" />
            <TextBlock Text="{Binding Name}" FontSize="11.5" TextAlignment="{Binding TextAlign}" TextWrapping="{Binding Wrap}"
                       TextTrimming="CharacterEllipsis" MaxHeight="{Binding TextMaxHeight}" Margin="{Binding TextMargin}"
                       VerticalAlignment="Center"
                       Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=UserControl}}" />
        </StackPanel>
    </DataTemplate>
</ResourceDictionary>
