<ui:FluentWindow x:Class="Duzenleme.Icons.FolderIconWindow"
                 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                 xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
                 Title="Klasör simgesi" Width="900" Height="700" MinWidth="680" MinHeight="460"
                 WindowStartupLocation="CenterScreen" ExtendsContentIntoTitleBar="True"
                 WindowBackdropType="Mica" WindowCornerPreference="Round"
                 Icon="pack://application:,,,/Assets/app.ico">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <ui:TitleBar x:Name="TitleBar" Title="Klasör simgesi" ShowMaximize="False" />

        <Grid Grid.Row="1" Margin="24,4,24,24">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="250" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- Önizleme -->
            <ScrollViewer VerticalScrollBarVisibility="Auto">
            <Border Style="{StaticResource Surface}" Padding="20" VerticalAlignment="Top">
                <StackPanel>
                    <Border CornerRadius="14" Height="190" Margin="0,0,0,14">
                        <Border.Background>
                            <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                <GradientStop Color="#2A2A38" Offset="0" />
                                <GradientStop Color="#1C1C26" Offset="1" />
                            </LinearGradientBrush>
                        </Border.Background>
                        <Image x:Name="Preview" Width="160" Height="160" RenderOptions.BitmapScalingMode="HighQuality" />
                    </Border>
                    <TextBlock x:Name="FolderNameText" FontSize="17" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"
                               Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                    <TextBlock x:Name="SourceText" Style="{StaticResource Muted}" Margin="0,2,0,16" />
                    <ui:Button x:Name="ApplyButton" Appearance="Primary" Icon="{ui:SymbolIcon Checkmark24}" Content="Simgeyi uygula"
                               HorizontalAlignment="Stretch" Click="Apply_Click" />
                    <ui:Button Margin="0,8,0,0" Icon="{ui:SymbolIcon FolderOpen24}" Content="Dosyadan yükle…"
                               HorizontalAlignment="Stretch" Click="LoadFile_Click" ToolTip=".ico, .png, .jpg veya .svg" />
                    <ui:Button Margin="0,8,0,0" Icon="{ui:SymbolIcon ArrowReset24}" Content="Varsayılana dön"
                               HorizontalAlignment="Stretch" Click="Reset_Click" />
                    <ui:InfoBar x:Name="Feedback" Margin="0,12,0,0" IsClosable="True" />
                </StackPanel>
            </Border>
            </ScrollViewer>

            <ScrollViewer Grid.Column="1" Margin="18,0,0,0" VerticalScrollBarVisibility="Auto">
                <StackPanel>
                    <TextBlock Style="{StaticResource SectionHeader}" Margin="0,0,0,8" Text="Renk" />
                    <ItemsControl x:Name="ColorList">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <WrapPanel />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                    </ItemsControl>

                    <TextBlock Style="{StaticResource SectionHeader}" Text="Sembol" />
                    <ItemsControl x:Name="GlyphList">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <WrapPanel />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                    </ItemsControl>

                    <TextBlock Style="{StaticResource SectionHeader}" Text="Yapay zekâ ile üret (isteğe bağlı)" />
                    <Border Style="{StaticResource Surface}">
                        <StackPanel>
                            <TextBlock Style="{StaticResource Muted}" Margin="0,0,0,10"
                                       Text="Ne görmek istediğini yaz; Claude bu klasöre özel bir simge çizsin. Ör: &quot;retro oyun kolu, neon mor&quot;, &quot;kahve fincanı ve kitap&quot;." />
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <ui:TextBox x:Name="Prompt" PlaceholderText="Simge açıklaması" Icon="{ui:SymbolIcon Sparkle24}" KeyDown="Prompt_KeyDown" />
                                <ui:Button x:Name="GenerateButton" Grid.Column="1" Margin="10,0,0,0" Appearance="Primary"
                                           Icon="{ui:SymbolIcon Sparkle24}" Content="Üret" Click="Generate_Click" />
                            </Grid>
                            <StackPanel x:Name="Busy" Orientation="Horizontal" Margin="0,12,0,0" Visibility="Collapsed">
                                <ui:ProgressRing IsIndeterminate="True" Width="18" Height="18" />
                                <TextBlock Text="Claude simgeyi çiziyor… (10–30 sn)" Margin="10,0,0,0" VerticalAlignment="Center"
                                           Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                            </StackPanel>
                            <ui:InfoBar x:Name="NoKeyInfo" Margin="0,12,0,0" IsClosable="False" Severity="Informational"
                                        Title="API anahtarı eklenmemiş"
                                        Message="Bu özellik isteğe bağlı. Ayarlar &gt; Yapay zekâ bölümünden Claude API anahtarını ekleyince açılır; hazır simgeler anahtarsız da çalışır." />
                            <TextBlock x:Name="HistoryHeader" Style="{StaticResource Muted}" FontWeight="SemiBold" Margin="0,14,0,6" Text="Önceki üretimler" />
                            <ItemsControl x:Name="HistoryList">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <WrapPanel />
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                            </ItemsControl>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </ScrollViewer>
        </Grid>
    </Grid>
</ui:FluentWindow>
