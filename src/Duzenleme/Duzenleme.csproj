<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <!-- Yalnızca tepsi simgesi (NotifyIcon) için. -->
    <UseWindowsForms>true</UseWindowsForms>
    <ApplicationIcon>Assets\app.ico</ApplicationIcon>
    <AssemblyName>Duzenleme</AssemblyName>
    <Product>Düzenleme</Product>
    <AssemblyTitle>Düzenleme</AssemblyTitle>
    <!-- Sürüm numarası sade kalsın (1.1.0+abcdef... değil). -->
    <IncludeSourceRevisionInInformationalVersion>false</IncludeSourceRevisionInInformationalVersion>
    <Version>1.2.2</Version>
    <Company>hasakobey</Company>
    <Authors>hasakobey</Authors>
    <Copyright>© 2026 hasakobey</Copyright>
    <Description>Düzenleme — modern masaüstü düzenleyici</Description>
    <!-- Yalnızca Türkçe ve İngilizce kaynaklar: paket küçülür. -->
    <SatelliteResourceLanguages>tr;en</SatelliteResourceLanguages>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <!-- WFAC010 WinForms uygulamaları içindir; DPI ayarını WPF manifest'ten okur. -->
    <NoWarn>$(NoWarn);WFAC010;WFO0003</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <!-- WPF ile çakışan WinForms/Drawing adlarını global using'den çıkar. -->
    <Using Remove="System.Windows.Forms" />
    <Using Remove="System.Drawing" />
  </ItemGroup>

  <ItemGroup>
    <Resource Include="Assets\app.ico" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Anthropic" Version="12.50.0" />
    <PackageReference Include="SharpVectors.Wpf" Version="1.8.6" />
    <PackageReference Include="WPF-UI" Version="4.3.0" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Duzenleme.Tests" />
  </ItemGroup>

</Project>
