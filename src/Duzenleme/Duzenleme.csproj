<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <ApplicationIcon>Assets\app.ico</ApplicationIcon>
    <!-- Program dosyası NestDesk.exe (2.1.0; 2.0 ve öncesi Duzenleme.exe). Proje, ad alanı ve çözüm adı bilerek eski kalır
         (RootNamespace proje adından: Duzenleme). Kurulum eski exe'yi siler; Run değeri ve veri klasörü açılışta taşınır
         (bkz. Core/AppInfo.cs). Değişirse: AppInfo.ExeName, NestDesk.iss AppExe ve AppxManifest Executable. -->
    <AssemblyName>NestDesk</AssemblyName>
    <RootNamespace>Duzenleme</RootNamespace>
    <Product>NestDesk</Product>
    <!-- Görev Yöneticisi, bildirim kaynağı ve Başlangıç uygulamaları bu adı gösterir. -->
    <AssemblyTitle>NestDesk</AssemblyTitle>
    <!-- Sürüm numarası sade kalsın (1.1.0+abcdef... değil). -->
    <IncludeSourceRevisionInInformationalVersion>false</IncludeSourceRevisionInInformationalVersion>
    <Version>2.1.1</Version>
    <!-- Geliştirme makinesinde Smart App Control, tanımadığı imzasız DLL'i engelleyebiliyor; deterministik derleme
         her seferinde birebir aynı (yine engellenen) dosyayı üretir. Debug'da her derleme farklı olsun. -->
    <Deterministic Condition="'$(Configuration)' == 'Debug'">false</Deterministic>
    <Company>hasakobey</Company>
    <Authors>hasakobey</Authors>
    <Copyright>© 2026 hasakobey</Copyright>
    <Description>NestDesk — masaüstü düzenleyici</Description>
    <!-- Yalnızca Türkçe ve İngilizce kaynaklar: paket küçülür. -->
    <SatelliteResourceLanguages>tr;en</SatelliteResourceLanguages>
    <ApplicationManifest>app.manifest</ApplicationManifest>
  </PropertyGroup>

  <ItemGroup>
    <!-- Arayüz metinleri her dosyada L.T/L.F/L.P ile çevrilir (Localization/L.cs). -->
    <Using Include="Duzenleme.Localization" />
  </ItemGroup>

  <ItemGroup>
    <Resource Include="Assets\app.ico" />
  </ItemGroup>

  <ItemGroup>
    <!-- MIT ve BSD lisansları, bildirimin programla birlikte dağıtılmasını ister: kurulum ve zip'lere girer. -->
    <None Include="..\..\LICENSE" Link="LICENSE.txt" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <None Include="..\..\THIRD-PARTY-NOTICES.txt" Link="THIRD-PARTY-NOTICES.txt" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Anthropic" Version="12.50.0" />
    <PackageReference Include="SharpVectors.Wpf" Version="1.8.6" />
    <PackageReference Include="WPF-UI" Version="4.3.0" />
  </ItemGroup>

  <ItemGroup>
    <!-- 2.2: yapay zekâ simgesinin SDK'sı yalnızca kullanıcı isteyince çalışır; yayında önceden derlenmez (ReadyToRun),
         mimari başına ~9 MB daha küçük. İlk çağrıdaki derleme arka planda olur (AiIconGenerator SDK işini Task.Run'da yapar).
         SharpVectors (SVG çizimi) önceden derlenmiş kalır. -->
    <PublishReadyToRunExclude Include="Anthropic.dll;Microsoft.Extensions.AI.Abstractions.dll" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Duzenleme.Tests" />
  </ItemGroup>

</Project>
